# Example variable values, placeholders only. Copy to terraform.tfvars and fill
# in real values; terraform.tfvars is gitignored and must never be committed.
cloudflare_api_token  = "your-cloudflare-api-token"
cloudflare_account_id = "your-cloudflare-account-id"
github_owner          = "your-github-owner"
github_repo_name      = "dnd-astro"
project_name          = "dnd-astro"
production_branch     = "main"
allowed_emails        = "example@example.com"
protected_paths       = "/reference/*,/private/*"

# Custom domain (optional, leave empty to skip)
custom_domain      = ""
custom_domain_zone = ""

# Cloudflare username for workers.dev fallback (used when custom_domain is empty)
cloudflare_username = "your-cloudflare-username"