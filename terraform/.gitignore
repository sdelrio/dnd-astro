# Terraform state files
*.tfstate
*.tfstate.*
*.tfplan

# Variable files with sensitive values
*.tfvars
*.tfvars.*

# The placeholder template is committed so a fresh clone can onboard. The
# negation has to follow the patterns above or *.tfvars.* would swallow it.
!*.tfvars.example

# Terraform directory
.terraform/

# .terraform.lock.hcl is intentionally tracked: it pins provider versions
# for every operator. Do not add it back here.
