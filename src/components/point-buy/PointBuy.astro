---
import IconifyIcon from '@/components/IconifyIcon.astro';
import {
  PRESET_SPREADS,
  calculateModifier,
  createDefaultScores,
  formatCostLine,
  formatModifier,
  formatTotalModifier,
  pointsRemaining,
  pointsSpent,
} from './point-buy-utils';

/**
 * The six abilities, as the sheet writes them. Full names in Cinzel because a
 * ledger line has room for them and the abbreviation is the thing people
 * already know; the mark beside the name is a solid silhouette from
 * `game-icons`, the same family throughout so the six read as one set rather
 * than six borrowed glyphs.
 */
const ABILITY_ROWS = [
  { ability: 'STR', name: 'Strength', icon: 'game-icons:mailed-fist' },
  { ability: 'DEX', name: 'Dexterity', icon: 'game-icons:boots' },
  { ability: 'CON', name: 'Constitution', icon: 'game-icons:round-shield' },
  { ability: 'INT', name: 'Intelligence', icon: 'game-icons:brain' },
  { ability: 'WIS', name: 'Wisdom', icon: 'game-icons:all-seeing-eye' },
  { ability: 'CHA', name: 'Charisma', icon: 'game-icons:crown' },
] as const;

const initialScores = createDefaultScores();
---

<div
  x-data="pointBuy"
  class="point-buy-needs-js pb not-content"
>
  <!-- With scripting off, every control below is inert and the six rows would
       read as a real allocation of 27 unspent points. A `<noscript>` block
       cannot remove them, so the note leads and hides them instead of leaving
       live-looking steppers that do nothing. `is:inline` is required: Astro
       would otherwise hoist this stylesheet into the head unconditionally,
       where it would hide the tool for everyone, scripting enabled or not. -->
  <noscript>
    <style is:inline>
      .point-buy-needs-js > .js-only {
        display: none !important;
      }
    </style>
    <div class="rounded-lg border border-gold-rule bg-bark-100 p-4 text-ink dark:border-gold-rule-dark dark:bg-bark-800 dark:text-parchment">
      <p class="font-medium">Point Buy needs JavaScript.</p>
      <p class="mt-1">
        Every other page on this site works without it. With it enabled you spend the
        standard 27-point pool across all six abilities and see the modifier and cost of
        each score as you go.
      </p>
    </div>
  </noscript>

  <h2 class="sr-only" id="point-buy-scores">Ability scores</h2>

  <!-- The panel. The same material as the Tools panel on the index page, on
       purpose: this tool is one of the instruments that panel lists, so the
       page that opens one of them is built from the same surface as the page
       that lists them. Bark 100 in light, Bark 800 in dark, a 1px gold rule
       that swaps to its dark step, an 8px radius, and the 3px accent cap -
       Oxblood in light, Gold Leaf in dark - which is the one place on the
       surface where the theme shows through as colour.

       An earlier build wrapped this in a leather desk with a dark headband
       and a gilt edge, and kept the paper the same parchment in both themes.
       That is what made the tool read as a different website pasted into the
       page: the heading and the surface were identical in light and dark, and
       the whole object outweighed the prose around it. A tool that is
       adjusting one number should look like the rest of the system doing it. -->
  <!-- `pb-swapping` is the one piece of state the stylesheet reads directly:
       while a score is held, the other five names are the targets and say so.
       It lives on the panel rather than on the island root so the rule is a
       plain descendant of the surface it draws inside. -->
  <div
    class="js-only pb-panel"
    :class="{ 'pb-swapping': picked !== null }"
    role="group"
    aria-labelledby="point-buy-scores"
  >
    <!-- The head, as the character Card's header: the printed title over a
         meta line, closed by a 2px gold rule at the head's own lower edge. The
         rule is what makes it work - a head banded only by a dotted leader
         reads as another row of the sheet, and a head closed by a rule at its
         lower edge reads as a heading over what it heads.

         A title and meta set as a part heading over a panel, and no
         heading element: Starlight colours every heading in the content
         column to the accent (0-1-1 light, 0-2-1 dark), which outranks a
         utility class, so a heading here would be an accent-coloured label
         the surface never asked for. The page's own `h1` is already "Point
         Buy"; this restates it as the panel's title. -->
    <div class="pb-head">
      <div class="pb-head-id">
        <p class="pb-head-title">Point Buy</p>
        <p class="pb-head-meta">
          Spend the 27-point pool across all six abilities. Tap a name, then another, to trade
          scores.
        </p>
      </div>
    </div>

    <!-- The sheet. Six ruled lines, no paper: a hairline between each, the
         dotted leader out to the figures, and the figures on one baseline. -->
    <div class="pb-body">
      <div
        class="pb-rule-head grid grid-cols-[minmax(0,1fr)_auto_auto_auto_auto] items-center gap-x-3 border-b border-[color:var(--pb-rule)] pb-1.5 max-[46rem]:hidden"
      >
        <span class="pb-soft micro-label">Ability</span>
        <span class="pb-soft micro-label w-[2.75rem] text-center">Mod</span>
        <span class="pb-soft micro-label w-[7.5rem] text-right">Cost</span>
        <span class="w-[5.875rem]"></span>
      </div>

      <div>
        {
          ABILITY_ROWS.map(({ ability, name, icon }) => (
            <div
              class="pb-rule grid grid-cols-[minmax(0,1fr)_auto_auto_auto_auto] items-center gap-x-3 border-b border-[color:var(--pb-rule)] py-2 last:border-b-0 max-[46rem]:grid-cols-[auto_auto_minmax(0,1fr)_auto] max-[46rem]:gap-x-2.5 max-[46rem]:gap-y-2 max-[46rem]:py-2.5"
              data-ability={ability}
            >
              <div class="flex min-w-0 items-baseline gap-2 max-[46rem]:col-span-full">
                <!-- The trade handle. Two presses, one exchange: this one
                     picks the score up, the next names where it goes. It is a
                     button and not the whole row because the steppers live in
                     the row, and a row-sized target that contains two 44px
                     buttons is a mis-tap waiting to happen. It wraps the mark
                     and the name only - the leader stays outside it, because a
                     leader inside a button can only be as long as the button
                     and the whole point of it is to run to the figure.

                     `aria-pressed` carries the picked state rather than a
                     class, so the ring is never the only signal, and the
                     label changes with it so the action names itself. -->
                <button
                  type="button"
                  class="pb-trade"
                  @click={`pickForSwap('${ability}')`}
                  :aria-pressed={`picked === '${ability}'`}
                  :aria-label={`tradeLabel('${ability}')`}
                >
                  <IconifyIcon
                    icon={icon}
                    width="1.125rem"
                    class="pb-mark shrink-0 translate-y-px"
                  />
                  <!-- A row label, not a heading. Six headings inside one
                       region is six landmarks' worth of nothing, and it hands
                       the accent colour to a name that has to read as ink. -->
                  <span class="pb-name">
                    {name}
                  </span>
                </button>
                {/* The leader. This is the device that makes the sheet a
                    ledger rather than a grid of tiles: the eye runs out along
                    the dots to the figure, so the six scores are read as one
                    column. */}
                <span class="pb-leader" />
              </div>

              <span
                class="pb-score"
                x-text={`scores.${ability}`}>{initialScores[ability]}</span
              >

              <!-- The modifier, on a flat chip. It was a 34px disc with a
                   gradient, a ring and a shadow - six of those on a page is
                   six small objects competing with the figures they explain.
                   A flat step in the neutral ramp keeps the column scannable
                    and leaves the score as the loud number on the line. -->

              <span
                class="pb-mod"
                x-text={`formatModifier(calculateModifier(scores.${ability}))`}
              >
                {formatModifier(calculateModifier(initialScores[ability]))}
              </span>

              <span
                class="pb-cost"
                x-text={`formatCostLine(scores.${ability})`}
              >
                {formatCostLine(initialScores[ability])}
              </span>

              <div class="flex w-[5.875rem] justify-end gap-1.5 max-[46rem]:w-auto">
                <button
                  type="button"
                  @click={`decrease('${ability}')`}
                  :disabled={`!canDecrease(scores, '${ability}')`}
                  class="pb-step"
                  aria-label={`Decrease ${name}`}
                >
                  <IconifyIcon icon="mdi:minus" width="1.125rem" />
                </button>
                <button
                  type="button"
                  @click={`increase('${ability}')`}
                  :disabled={`!canIncrease(scores, '${ability}')`}
                  class="pb-step"
                  aria-label={`Increase ${name}`}
                >
                  <IconifyIcon icon="mdi:plus" width="1.125rem" />
                </button>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Presets. Offered so nobody spends 27 presses to find out what a
           Striker looks like; each is pinned to exactly the full pool by a
           test, so loading one is a finished allocation, not a head start. -->
      <div
        class="mt-4 flex flex-wrap items-center gap-1.5 border-t border-[color:var(--pb-rule)] pt-3"
        role="group"
        aria-label="Start from a preset spread"
      >
        <span class="pb-soft micro-label mr-1">Start from</span>
        {
          PRESET_SPREADS.map((preset) => (
            <button type="button" @click={`loadPreset('${preset.id}')`} class="pb-preset">
              {preset.label}
            </button>
          ))
        }
      </div>

      <!-- The foot is the sum of the sheet, in the three figures a player
           actually compares builds on. The purse lives here rather than in the
           head: the head is a title, and a governing number set in a title
           band reads as a headline instead of as the state of the sheet. Down
           here it sits beside "Spent", which is the figure it is the remainder
           of - 27 minus spent - and the three together answer the only three
           questions anyone asks of a spread: how strong, how much, how much is
           left.

           All three are the same entry: label, figure, one step. Setting the
           purse apart - a leader out to the right, a step up, its own
           treatment - made the remainder the loudest thing on a surface whose
           job is six numbers, and the leader only meant "look here". When the
           pool empties the label says so, which is how a finished allocation
           reads as finished without the figure having to shout. -->
      <div
        class="mt-3 flex flex-wrap items-center justify-between gap-x-5 gap-y-3 border-t border-[color:var(--pb-rule)] pt-3"
      >
        <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
          <p class="flex items-baseline gap-1.5">
            <span class="pb-soft micro-label">Modifier total</span>
            <span
              class="pb-total"
              x-text="formatTotalModifier(scores)">{formatTotalModifier(initialScores)}</span
            >
          </p>
          <p class="flex items-baseline gap-1.5">
            <span class="pb-soft micro-label">Spent</span>
            <span
              class="pb-total"
              x-text="String(pointsSpent(scores))">{pointsSpent(initialScores)}</span
            >
          </p>
          <p class="flex items-baseline gap-1.5">
            <span
              class="pb-soft micro-label"
              x-text="pointsRemaining(scores) === 0 ? 'Pool spent' : 'Points left'"
              >Points left</span
            >
            <span
              class="pb-total"
              data-purse
              x-text="String(pointsRemaining(scores))">{pointsRemaining(initialScores)}</span
            >
          </p>
        </div>

        <!-- The one control that throws the sheet away, so it is the one
             control set in the theme's heading ink rather than in the action
             accent: Oxblood in light, Gold Leaf in dark. That is what the
             Rarity Rule reserves those two for - a marker, not a fill - and
             it is enough to separate this from the presets beside it without
             a wax seal the size of the panel cap. -->
        <button
          type="button"
          @click="reset()"
          class="pb-reset"
          aria-label="Reset all scores to eight"
        >
          <IconifyIcon icon="mdi:restore" width="0.9375rem" />
          <span>Reset to blank</span>
        </button>
      </div>
    </div>
  </div>

  <p class="sr-only" role="status" aria-live="polite" x-text="announcement"></p>
</div>

<style>
  /* One system inverted, not a second design - the same move the rulebook
     index makes and the same reason. The surface steps down, the ink steps
     up, the rule swaps to its dark step, and the accent swaps from Oxblood to
     Gold Leaf. Nothing changes shape, size or spacing between themes. */
  .pb {
    --pb-surface: var(--color-bark-100);
    --pb-raised: var(--color-bark-200);
    --pb-rule: color-mix(in srgb, var(--color-gold-rule) 42%, transparent);
    --pb-rule-strong: var(--color-gold-rule);
    --pb-ink: var(--color-ink);
    --pb-ink-soft: var(--color-bark-600);
    --pb-heading: var(--color-oxblood);
    --pb-accent: var(--sl-color-accent);
    /* The focus ring is never the value of the ink it outlines: the glyph is
       the accent, so the ring is bark. */
    --pb-focus: var(--color-bark-black);
  }

  :global(:root[data-theme='dark']) .pb {
    --pb-surface: var(--color-bark-800);
    --pb-raised: var(--color-bark-700);
    --pb-rule: color-mix(in srgb, var(--color-gold-rule-dark) 45%, transparent);
    --pb-rule-strong: var(--color-gold-rule-dark);
    --pb-ink: var(--color-parchment);
    --pb-ink-soft: var(--color-bark-400);
    --pb-heading: var(--color-gold);
    --pb-focus: var(--color-bark-100);
  }

  .pb-panel {
    position: relative;
    padding: 1rem;
    border: 1px solid var(--pb-rule-strong);
    border-radius: 8px;
    background: var(--pb-surface);
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  }

  /* The cap, drawn over the border so the 1px edge stays continuous. The one
     piece of theme colour on the surface, and the only accent bar in the
     tool: it says "instrument" once rather than six times. */
  .pb-panel::before {
    content: '';
    position: absolute;
    inset-inline: -1px;
    top: -1px;
    height: 3px;
    border-radius: 8px 8px 0 0;
    background: var(--pb-heading);
  }

  /* The head, built as the character Card's header: a title over a meta line,
     closed by a 2px gold rule at the bottom edge. That rule is the whole
     reason for the shape. A head banded only by a dotted leader reads as a row
     of the sheet; a head closed by a rule at its own lower edge reads as a
     heading over what it heads, which is what a title is. It is the same gold
     the Card header uses, and it is the panel's second structural cue rather
     than a second accent - the cap above and the rule below bracket the
     surface without either one carrying colour on its own. */
  .pb-head {
    padding-bottom: 0.75rem;
    margin-bottom: 0.5rem;
    border-bottom: 2px solid var(--pb-rule-strong);
  }

  .pb-head-id {
    min-width: 0;
  }

  /* A printed title, at the Card Heading's name step. Never a heading element -
     see the note in the markup. */
  .pb-head-title {
    font-family: var(--sl-font-heading);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: var(--pb-heading);
    /* Wraps rather than truncates: the title is the panel's primary element,
       and at 320 the whole panel measure is under 260px. */
    overflow-wrap: break-word;
  }

  /* The meta line: the Card header's meta, uppercased and tracked, so the head
     is recognisably the same object as the one on a character Card rather than
     a lookalike. It is the one place a full sentence is set this way, and it
     works because the sentence is a label - what the panel is - and not prose
     anyone reads at length. */
  .pb-head-meta {
    margin-top: 3px;
    font-family: var(--sl-font-table);
    font-size: 0.8125rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--pb-ink-soft);
  }

  .pb-soft {
    color: var(--pb-ink-soft);
  }

  .pb-body {
    padding-top: 0.25rem;
  }

  /* The name carries the row's identity, so it is set in the heading face at
     body scale and in the row's own ink - the accent is for the title, and
     spending it on six names would leave the title with nothing. */
  .pb-name {
    font-family: var(--sl-font-heading);
    font-size: 1rem;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--pb-ink);
  }

  .pb-mark {
    color: var(--pb-ink-soft);
  }

  /* The trade handle, as a control that has to look like part of the writing
     at rest and like a control while it is live. It borrows nothing from the
     steppers beside it - no border, no fill, no accent - because six bordered
     rectangles down the name column would be six more objects on a sheet
     whose job is six numbers. What it does take is the 44px floor: the row is
     already 44px tall because of the steppers, so the target is the row's own
     height and nothing on the sheet grows. */
  .pb-trade {
    display: inline-flex;
    align-items: baseline;
    min-height: 2.75rem;
    gap: 0.5rem;
    cursor: pointer;
    border: 0;
    border-radius: 8px;
    background: transparent;
    text-align: start;
    color: inherit;
    transition: box-shadow 150ms ease-out;
  }

  .pb-trade:focus-visible {
    outline: 2px solid var(--pb-focus);
    outline-offset: 2px;
  }

  /* Press feedback ungated, for the reason the steppers give: `hover` sticks
     after a tap on iOS and never fires for a stylus. */
  .pb-trade:active {
    transform: translateY(1px);
  }

  /* While a score is held, the other five names are the targets and say so -
     a 1px outline in the panel's own hairline step, which is the quietest
     thing on the surface that is still an edge. It is deliberately the
     *weaker* rule rather than the full gold one: in dark, six full-strength
     gold outlines read as six boxes and the one ring that means something
     stops standing out. */
  .pb-swapping .pb-trade[aria-pressed='false'] {
    box-shadow: inset 0 0 0 1px var(--pb-rule);
  }

  /* The held one, in the theme's action accent: the Rarity Rule's one
     legitimate use, a selection. The ring is 2px and offset so it reads as
     outside the name rather than as a box drawn round it. */
  .pb-trade[aria-pressed='true'] {
    box-shadow: 0 0 0 2px var(--pb-accent);
  }

  .pb-trade[aria-pressed='true'] .pb-mark {
    color: var(--pb-accent);
  }

  .pb-leader {
    height: 0;
    min-width: 0.75rem;
    flex: 1;
    transform: translateY(-3px);
    border-bottom: 1px dotted var(--pb-rule);
  }

  .pb-score {
    min-width: 1.4ch;
    text-align: center;
    font-family: var(--sl-font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1;
    color: var(--pb-ink);
    font-variant-numeric: tabular-nums;
  }

  /* The modifier, on a flat step in the neutral ramp: enough to hold the
     column, not enough to be an object. */
  .pb-mod {
    display: grid;
    width: 2.75rem;
    height: 1.75rem;
    place-items: center;
    border-radius: 999px;
    background: var(--pb-raised);
    font-family: var(--sl-font-table);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
    color: var(--pb-ink);
    font-variant-numeric: tabular-nums;
  }

  .pb-cost {
    width: 7.5rem;
    text-align: right;
    font-family: var(--sl-font-table);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--pb-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .pb-total {
    font-family: var(--sl-font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1;
    color: var(--pb-ink);
    font-variant-numeric: tabular-nums;
  }

  /* The steppers, as DESIGN.md's Outline / Icon control: transparent fill, the
     theme's action accent for border and glyph, 8px radius. 44px is
     ADR-0009's floor and the box is 44 rather than the glyph's 18, so the
     target is the control rather than the mark inside it. */
  .pb-step {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 8px;
    border: 1px solid var(--pb-rule-strong);
    background: transparent;
    color: var(--pb-accent);
    transition:
      background-color 150ms ease-out,
      transform 90ms ease-out;
  }

  @media (hover: hover) {
    .pb-step:hover:not(:disabled) {
      background: var(--pb-raised);
    }
  }

  /* Press feedback is deliberately ungated: `hover` sticks after a tap on
     iOS and never fires for a stylus, so gating the press on `hover` silently
     excludes exactly the device ADR-0009 is about. */
  .pb-step:active:not(:disabled) {
    transform: translateY(1px);
  }

  .pb-step:disabled {
    color: var(--pb-ink-soft);
    border-color: var(--pb-rule);
    cursor: not-allowed;
  }

  .pb-step:focus-visible {
    outline: 2px solid var(--pb-focus);
    outline-offset: 2px;
  }

  /* The preset and the reset are quiet outline buttons. They used to be a
     tinted pill and a wax seal respectively; at ADR-0009's 44px they are two
     of the loudest objects on a page whose job is six numbers. */
  .pb-preset,
  .pb-reset {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    cursor: pointer;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--pb-rule-strong);
    background: transparent;
    font-family: var(--sl-font-table);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--pb-ink-soft);
    transition:
      background-color 150ms ease-out,
      color 150ms ease-out;
  }

  @media (hover: hover) {
    .pb-preset:hover,
    .pb-reset:hover {
      background: var(--pb-raised);
      color: var(--pb-ink);
    }
  }

  .pb-preset:focus-visible,
  .pb-reset:focus-visible {
    outline: 2px solid var(--pb-focus);
    outline-offset: 2px;
  }

  /* The reset is the destructive one, and the theme's heading ink is what
     marks a thing as important without filling it. */
  .pb-reset {
    color: var(--pb-heading);
    border-color: var(--pb-heading);
  }

  @media (max-width: 46rem) {
    .pb-cost {
      width: auto;
      text-align: left;
    }

    .pb-score {
      justify-self: start;
    }
  }

  /* No shadow in dark. DESIGN.md's card-rest is 5% black, which cannot lift a
     surface off bark-black, so the dark panel carries none and lets the 1px
     border, the 3px cap and the head's 2px rule do the structural work. */
  :global(:root[data-theme='dark']) .pb-panel {
    box-shadow: none;
  }
</style>
