---
import { FEATS, BOOKS, ABILITIES } from './feat-data';
import { LEVEL_BUCKETS } from './feat-filter';
import IconifyIcon from '@/components/IconifyIcon.astro';

const initialData = {
  feats: FEATS,
  books: BOOKS,
  abilities: ABILITIES
};
---

<div
  x-data={`featExplorer(${JSON.stringify(initialData)})`}
  class="not-content space-y-6"
>
  <!-- Filter controls -->
    <div class="flex flex-col sm:flex-row gap-4 mb-6">
      <div class="flex-1">
        <label for="feat-search" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Search feats</label>
        <input
          id="feat-search"
          type="text"
          x-model="searchQuery"
          @input.debounce.300ms="filterFeats()"
          placeholder="Type a feat name..."
          class="w-full min-h-11 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-(--sl-color-accent) focus:border-(--sl-color-accent) text-base sm:text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"
        />
      </div>

      <!-- Below sm the three selects collapse behind a toggle: four stacked
           full-width controls pushed the first result card off a phone screen.
           The panel must NOT carry a `hidden` class. `x-show` hides by writing
           inline `display:none` and, on show, *removes* the inline display
           instead of setting one - so a class-based `display:none` would win
           again the moment the panel opened and the toggle would do nothing on
           a phone. `x-cloak` already covers the pre-boot paint, and
           `sm:flex!` is what outranks the inline `display:none` at sm+, keeping
           the three selects in a row there. -->
      <button
        type="button"
        x-cloak
        x-show="!filtersOpen"
        @click="filtersOpen = true"
        class="sm:hidden min-h-11 inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-(color:--sl-color-accent) text-(color:--sl-color-accent) font-medium transition-colors"
        aria-controls="feat-filter-panel"
        :aria-expanded="filtersOpen ? 'true' : 'false'"
      >
        <IconifyIcon icon="mdi:tune-variant" width="1.25em" />
        <span>Filters</span>
        <span
          x-show="activeFilterCount() > 0"
          x-text="activeFilterCount()"
          class="inline-flex items-center justify-center min-w-5 h-5 px-1.5 rounded-full bg-(--sl-color-accent) text-(color:--sl-color-text-invert) text-xs font-bold"
        ></span>
      </button>

      <div
        id="feat-filter-panel"
        x-cloak
        x-show="filtersOpen"
        class="sm:flex! sm:flex-row sm:items-start gap-4"
      >
      <div class="sm:w-32">
        <label for="ability-filter" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Ability</label>
        <select
          id="ability-filter"
          x-model="selectedAbility"
          @change="filterFeats()"
          class="w-full min-h-11 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-(--sl-color-accent) focus:border-(--sl-color-accent) text-base sm:text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"
        >
          <option value="All">All Abilities</option>
          <template x-for="ability in abilities" :key="ability">
            <option :value="ability" x-text="ability"></option>
          </template>
        </select>
      </div>
      
      <div class="sm:w-48">
        <label for="book-filter" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Book</label>
        <select
          id="book-filter"
          x-model="selectedBook"
          @change="filterFeats()"
          class="w-full min-h-11 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-(--sl-color-accent) focus:border-(--sl-color-accent) text-base sm:text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"
        >
          <option value="All">All Books</option>
          <template x-for="(label, code) in books" :key="code">
            <option :value="code" x-text="label"></option>
          </template>
        </select>
      </div>
      
      <div class="sm:w-24">
        <label for="level-filter" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Level</label>
        <select
          id="level-filter"
          x-model="selectedLevel"
          @change="filterFeats()"
          class="w-full min-h-11 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-(--sl-color-accent) focus:border-(--sl-color-accent) text-base sm:text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"
        >
          <option value="All">All Levels</option>
          {LEVEL_BUCKETS.map((bucket) => (
            <option value={bucket.value}>{bucket.label}</option>
          ))}
        </select>
      </div>
      </div>
    </div>
    
    <!-- Clear filters and result count -->
    <div class="flex items-center justify-between mb-6">
      <p class="text-sm text-gray-600 dark:text-gray-400" role="status" aria-live="polite">
        <span x-text="filteredFeats.length"></span> feat<span x-show="filteredFeats.length !== 1">s</span> found
      </p>
      <button
        x-show="hasActiveFilters()"
        @click="clearFilters()"
        class="inline-flex items-center justify-center w-11 h-11 -mr-2 text-(color:--sl-color-accent) hover:text-(color:--sl-color-accent-high) transition-colors"
        title="Clear filters"
        aria-label="Clear all filters"
      >
        <IconifyIcon icon="mdi:filter-remove" width="1.25em" />
      </button>
    </div>
    
    <!-- Feat grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <template x-for="feat in filteredFeats" :key="feat.name">
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm overflow-hidden hover:shadow-md transition-shadow">
          <div class="p-4">
            <div class="flex justify-between items-start mb-2">
              <h3 class="font-bold text-gray-900 dark:text-gray-100" x-text="feat.name"></h3>
              <span 
                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium"
                :class="feat.level === 0 ? 'bg-moss-100 dark:bg-moss-800 text-ink dark:text-parchment' : feat.level >= 19 ? 'bg-bark-200 dark:bg-bark-800 text-ink dark:text-parchment' : 'bg-bark-100 dark:bg-bark-700 text-ink dark:text-parchment'"
                x-text="feat.level === 0 ? 'Origin' : feat.level >= 19 ? 'Epic Boon' : 'General'"
              ></span>
            </div>
            
            <div class="text-sm text-gray-600 dark:text-gray-400 mb-2" x-text="feat.description"></div>
            
            <div class="flex flex-wrap gap-1 mb-2">
              <template x-if="feat.abilityIncrease && feat.abilityIncrease.length > 0">
                <div class="flex flex-wrap gap-1">
                  <template x-for="ability in feat.abilityIncrease" :key="ability">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200" x-text="ability"></span>
                  </template>
                </div>
              </template>
            </div>
            
            <div class="flex justify-between items-center text-xs text-gray-500 dark:text-gray-400">
              <span x-text="books[feat.book] || feat.book"></span>
              <span x-show="feat.prerequisite" x-text="'Prereq: ' + feat.prerequisite"></span>
            </div>
          </div>
        </div>
      </template>
    </div>
    
  <!-- Empty state -->
  <div x-cloak x-show="filteredFeats.length === 0" class="text-center py-12 text-gray-500 dark:text-gray-400">
    No feats match your filters.
  </div>
</div>

<script>
  import type { FEATS, BOOKS, ABILITIES } from './feat-data';
  import { filterFeats } from './feat-filter';

  interface FeatExplorerData {
    feats?: typeof FEATS;
    books?: typeof BOOKS;
    abilities?: typeof ABILITIES;
  }

  declare global {
    interface Window {
      featExplorer: typeof featExplorer;
    }
  }

  function featExplorer(data: FeatExplorerData) {
    return {
      feats: data.feats || [],
      filteredFeats: data.feats ? [...data.feats] : [],
      abilities: data.abilities || [],
      books: data.books || {},
      searchQuery: '',
      selectedAbility: 'All',
      selectedBook: 'All',
      selectedLevel: 'All',
      filtersOpen: false,

      filterFeats() {
        this.filteredFeats = filterFeats(this.feats, {
          search: this.searchQuery,
          ability: this.selectedAbility,
          book: this.selectedBook,
          level: this.selectedLevel,
        });
      },

      clearFilters() {
        this.searchQuery = '';
        this.selectedAbility = 'All';
        this.selectedBook = 'All';
        this.selectedLevel = 'All';
        this.filterFeats();
      },

      hasActiveFilters() {
        return this.searchQuery !== '' || this.activeFilterCount() > 0;
      },

      /** Counts the selects only. The search box is always visible below sm, so
          a query is not a reason to reveal the collapsed panel. */
      activeFilterCount() {
        return [this.selectedAbility, this.selectedBook, this.selectedLevel]
          .filter((value) => value !== 'All')
          .length;
      }
    };
  };

  window.featExplorer = featExplorer;
</script>
