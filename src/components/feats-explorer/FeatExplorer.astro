---
import { LEVEL_BUCKETS, UNATTRIBUTED_BOOK } from './feat-filter';
---

<div
  data-fx="codex"
  class="not-content"
  x-data="featExplorer"
>
  <div class="fx-title">
    <h2 class="fx-page-title">Feat Codex</h2>
    <!-- The one live region on the component. It was two: this line and the
         "N feats found" line on the bar below, both role="status"
         aria-live="polite", so a screen reader announced the count twice on
         every keystroke. The bar's copy is gone and the count is stated here
         once, in the head where the collection's size belongs.

         Gated on `datasetState` since #387: the dataset now arrives as its own
         chunk, and until it does `0 of 0 feats` is a lie rather than an empty
         sheet. x-cloak too, so a reader without JavaScript gets the heading and
         the key and no invented count. The loading line below is deliberately
         not a live region - it resolves into this one within a moment, and
         announcing "fetching" and then "219 of 219" is two announcements where
         one is enough. -->
    <p class="fx-countline" role="status" aria-live="polite" x-cloak x-show="datasetState === 'ready'">
      <span x-text="filteredFeats.length"></span> of <span x-text="feats.length"></span> feats on this sheet
    </p>
    <p class="fx-loading" x-cloak x-show="datasetState === 'loading'">Fetching the feat list...</p>
  </div>

  <!-- The filter line: search, the disclosure toggle, the three selects, and
       the clear control at the trailing edge. It is a wrapping flex row, so
       the clear control is a sibling of the panel and never a child of it -
       below sm the panel is collapsed and a clear control inside it would be
       unreachable until the user opened the filters, which is a regression in
       a control that is currently always one tap away. -->
  <div class="fx-filters">
    <div class="fx-field fx-search">
      <label for="fx-search">Search feats</label>
      <input id="fx-search" class="min-h-11 text-base sm:text-sm fx-input" type="text" x-model="searchQuery" @input.debounce.300ms="filterFeats()" placeholder="Type a feat name..." autocomplete="off" />
    </div>
    <button
      type="button"
      class="min-h-11 text-base fx-filters-toggle"
      x-cloak
      x-show="!filtersOpen"
      @click="filtersOpen = true"
      aria-controls="fx-panel"
      :aria-expanded="filtersOpen ? 'true' : 'false'"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 5h16M7 12h10M10 19h4" /></svg>
      <span>Filters</span>
      <span class="min-w-5 h-5 px-1.5 inline-flex items-center justify-center rounded-full bg-(--sl-color-accent-contrast) text-(color:--sl-color-text-invert) text-xs font-bold" x-show="activeFilterCount() > 0" x-text="activeFilterCount()"></span>
    </button>
    <div class="fx-panel" id="fx-panel" x-cloak x-show="filtersOpen">
      <div class="fx-field fx-ability">
        <label for="fx-ability">Ability</label>
        <span class="fx-control">
          <select id="fx-ability" class="min-h-11 text-base sm:text-sm fx-select" x-model="selectedAbility" @change="filterFeats()">
            <option value="All">All Abilities</option>
            <template x-for="ability in abilities" :key="ability">
              <option :value="ability" x-text="ability"></option>
            </template>
          </select>
        </span>
      </div>
      <div class="fx-field fx-book">
        <label for="fx-book">Book</label>
        <span class="fx-control">
          <select id="fx-book" class="min-h-11 text-base sm:text-sm fx-select" x-model="selectedBook" @change="filterFeats()">
            <option value="All">All Books</option>
            <template x-for="(label, code) in books" :key="code">
              <option :value="code" x-text="label"></option>
            </template>
            <!-- The ten feats that name no book. Without this option every
                 named book excludes them and no selection brings them back,
                 which is the one outcome the explorer must not have: a feat a
                 reader cannot reach by any filter. Added after the named books
                 so the list reads "the books, then no book". -->
            <option value={UNATTRIBUTED_BOOK}>Unattributed</option>
          </select>
        </span>
      </div>
      <div class="fx-field fx-level">
        <label for="fx-level">Level</label>
        <span class="fx-control">
          <select id="fx-level" class="min-h-11 text-base sm:text-sm fx-select" x-model="selectedLevel" @change="filterFeats()">
            <option value="All">All Levels</option>
            {LEVEL_BUCKETS.map((bucket) => (
              <option value={bucket.value}>{bucket.label}</option>
            ))}
          </select>
        </span>
      </div>
    </div>
    <button
      type="button"
      class="fx-clear"
      x-cloak
      x-show="hasActiveFilters()"
      @click="clearFilters()"
      title="Clear filters"
      aria-label="Clear all filters"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 5h18M8 5V3h8v2M6 5l1 14h10l1-14M10 9v7M14 9v7" /></svg>
    </button>
  </div>

  <!-- The tier key. It is a dl of the three seals' own marks and their names, so
       a screen reader gets the same key a reader gets, and both read off the
       same three --fx-seal-* declarations the medallions use. It sits outside
       the collapsible panel, above the cards, so it is on the page at every
       width and in both themes. It is a key and not a feature: no colour of
       its own, no rule of its own beyond the hairlines it shares with the page.

       The trailing note is part of the key, not a caveat: EB is `level >= 19`,
       and the Level filter splits 19 from 21, so a reader who picks Level 21 and
       finds an EB seal is looking at the intended behaviour and the key has to
       say so on the page. The level-21 entries are class builds rather than
       boons; the user was asked and chose to keep the one "Epic Boon" tier and
       to make the key state its scope rather than split the tier or rename it.
       The marks stay on `.fx-seal` at key size, so this note cannot drift from
       the colours it describes. -->
  <div class="fx-legend">
    <span class="fx-legend-label" id="fx-legend-label">Tier seals</span>
    <dl class="fx-legend-keys" aria-labelledby="fx-legend-label">
      <div class="fx-legend-set">
        <dt><span class="fx-seal fx-seal-key" data-tier="origin">OR</span></dt>
        <dd>Origin</dd>
      </div>
      <div class="fx-legend-set">
        <dt><span class="fx-seal fx-seal-key" data-tier="general">GE</span></dt>
        <dd>General</dd>
      </div>
      <div class="fx-legend-set">
        <dt><span class="fx-seal fx-seal-key" data-tier="epic">EB</span></dt>
        <dd>Epic Boon</dd>
      </div>
    </dl>
    <p class="fx-legend-note">EB covers Level 19 and Level 21.</p>
  </div>

  <div class="fx-grid">
    <template x-for="feat in filteredFeats" :key="feat.name">
      <article class="fx-card" :data-tier="tierKey(feat.level)">
        <div class="fx-head">
          <h3 class="fx-name" x-text="feat.name"></h3>
          <span class="fx-seal" :data-tier="tierKey(feat.level)" x-text="tierMono(tierKey(feat.level))" aria-hidden="true"></span>
        </div>
        <!-- The prerequisite is its own line under the name, not a fifth column.
             Block flow rather than a flex row so the longest string in the
             dataset wraps at the card's full measure instead of being squeezed
             beside a label; overflow-wrap:anywhere breaks the unbreakable runs
             (a feat name, a "18+") that would otherwise push the card wide.
             x-if, not x-show: a feat with no prerequisite renders no line and
             leaves no gap in the card's flex-column flow. -->
        <template x-if="feat.prerequisite">
          <p class="fx-prereq"><span class="fx-prereq-k">Requires</span><span x-text="feat.prerequisite"></span></p>
        </template>
        <template x-if="feat.abilityIncrease && feat.abilityIncrease.length > 0">
          <div class="fx-abil">
            <template x-for="ability in feat.abilityIncrease" :key="ability">
              <span class="fx-chip" x-text="ability"></span>
            </template>
          </div>
        </template>
        <template x-if="!feat.abilityIncrease || feat.abilityIncrease.length === 0">
          <div class="fx-abil"><span class="fx-none">No ability increase</span></div>
        </template>
        <div class="fx-foot">
          <span class="fx-tier" x-text="tierName(feat.level)"></span>
          <span aria-hidden="true">&middot;</span>
          <span class="fx-book" x-text="bookLabel(feat)"></span>
        </div>
      </article>
    </template>
  </div>

  <!-- Two readings of `filteredFeats.length === 0`, and they must not share a
       sentence. The list is full the moment the page paints when the filters
       have excluded everything, and empty for a moment before that when the
       dataset chunk is still in flight - so the "no match" line waits for
       `ready`, and a fetch that never arrived says so instead. -->
  <div class="fx-empty" x-cloak x-show="datasetState === 'ready' && filteredFeats.length === 0">No feats match your filters.</div>
  <div class="fx-empty" x-cloak x-show="datasetState === 'failed'">The feat list could not be loaded. Reload the page to try again.</div>
</div>

<style is:global>
  [data-fx]{ font-family: var(--sl-font); color: var(--fx-ink); }
  [data-fx] *{ box-sizing: border-box; }
  [data-fx] h2, [data-fx] h3{ margin:0; font-family: var(--sl-font-heading); font-weight:700; }
  [data-fx] p{ margin:0; }
  [data-fx] :is(input,select,button,a):focus-visible{ outline:2px solid var(--fx-focus); outline-offset:2px; border-radius:8px; }
  .fx-none{ font-family: var(--sl-font-table); font-size:.6875rem; font-style:italic; color: var(--fx-ink-soft); }

  /* Every control is a 44px target with a 16px base font, carried by the same
     `min-h-11 text-base sm:text-sm` utilities the other tool panels use. Below
     sm the 16px is what holds: iOS Safari zooms the whole page on focus of a
     sub-16px input, which is fatal at the table. */
  .fx-input, .fx-select{ width:100%; min-width:0; padding:.5rem .75rem; font-family: var(--sl-font); color: var(--fx-ink); background: var(--fx-field); border:1px solid var(--fx-rule-strong); border-radius:8px; }
  .fx-input::placeholder{ color: var(--fx-ink-soft); opacity:.85; }

  /* The caret is drawn in CSS rather than shipped as a data-URI SVG, because a
     data URI has to name its own colour and that would put a private hex back
     on a surface the system already themes. The wrapper is the only reason the
     selects are wrapped at all. */
  .fx-control{ position:relative; display:block; min-width:0; }
  .fx-control::after{ content:''; position:absolute; top:50%; right:.75rem; width:.4375rem; height:.4375rem; border-right:2px solid var(--fx-ink-soft); border-bottom:2px solid var(--fx-ink-soft); transform:translateY(-70%) rotate(45deg); pointer-events:none; }
  .fx-select{ appearance:none; padding-right:2.25rem; }

  /* The disclosure toggle is visible by default and hidden at sm+, where the
     three selects sit inline. It must NOT be display:none in the base rule:
     x-show reveals by REMOVING the inline display, so a base display:none would
     win again the moment the panel opened and the toggle would do nothing on a
     phone. Same reasoning the shipped filter panel relies on. */
  .fx-filters-toggle{ display:flex; align-items:center; justify-content:center; gap:.5rem; flex:1 1 auto; padding:0 1rem; border:1px solid var(--fx-rule-strong); background: var(--fx-field); color: var(--fx-ink); font-family: var(--sl-font); font-weight:600; border-radius:8px; cursor:pointer; }
  @media (min-width:40rem){ .fx-filters-toggle{ display:none !important; } }
  .fx-filters-toggle svg{ width:18px; height:18px; }
  .fx-clear{ display:inline-flex; align-items:center; justify-content:center; width:44px; height:44px; flex:0 0 auto; border:1px solid transparent; background:transparent; color: var(--fx-ink-soft); cursor:pointer; border-radius:8px; transition: color 150ms ease-out, background 150ms ease-out, transform 90ms ease-out; }
  /* ADR-0009 D4: the hover tint is gated, the press is not. This control sits 14px
     from the selects and the search field, so an ungated `:hover` here is exactly
     the stale-tint-after-a-tap case the decision was written about. The siblings
     gate theirs - `.pb-step`, `.dr-reroll`, `.r3-chip`, `.rb-entry-link` - and
     five ungated hover tints still survive elsewhere in the repo (the swap popover
     buttons in `DiceRoller.astro` and `.rb-panel .rb-entry-link` in
     `RulebookSpread.astro`), all pre-existing and out of scope here. */
  @media (hover: hover){
    .fx-clear:hover{ color: var(--fx-ink); background: var(--fx-sunk); border-color: var(--fx-rule); }
  }
  /* Press feedback is deliberately ungated, for the reason ADR-0009 D4 gives:
     `:hover` sticks after a tap on iOS and never fires for a stylus, so gating
     the press on `hover` would exclude exactly the device the decision is about.
     A mouse still gets a press while held, a finger gets one on contact, and a
     touchscreen laptop reports `hover: hover` and `pointer: fine` at once, so
     the ungated form is correct on all three. `translateY(1px)` is the sibling
     components' press: `.pb-step`, `.dr-reroll`, `.dr-trade`. */
  .fx-clear:active{ transform: translateY(1px); }
  .fx-clear svg{ width:20px; height:20px; }

  .fx-field{ display:flex; flex-direction:column; gap:.25rem; min-width:0; }
  .fx-field > label{ font-family: var(--sl-font-table); font-size:.5625rem; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color: var(--fx-ink-soft); }

  /* The filter line. `flex-end` puts the clear control's 44px square on the
     selects' baseline rather than centring it in the label's taller box, and
     the wrap is what lets the row be [search] [Filters] [clear] below sm and
     [search] [ability] [book] [level] [clear] at the widths where all five fit
     on one line. Below 40rem the search takes the whole line by its 100%
     basis; at sm+ it drops to 14rem, which is the point at which the three
     selects and the clear control fit beside it. */
  .fx-filters{ display:flex; flex-wrap:wrap; align-items:flex-end; gap:.875rem; margin-bottom:1.125rem; }
  .fx-search{ flex:1 1 100%; }
  [data-fx] .fx-panel{ display:flex; flex-direction:column; gap:.875rem; }
  @media (min-width:40rem){
    [data-fx] .fx-panel{ display:flex !important; flex-direction:row; align-items:flex-end; }
    /* Proportional rather than equal: a book name needs more room than a tier.
       Level is 7.5rem and not 6rem because the custom caret reserves 2.25rem on
       the right, and at 6rem that left 46px of text box against a 60px "All
       Levels" - the control clipped its own default label. */
    .fx-search{ flex:1 1 14rem; }
    .fx-ability{ flex:0 0 8rem; }
    .fx-book{ flex:0 0 12rem; }
    .fx-level{ flex:0 0 7.5rem; }
  }
  .fx-empty{ text-align:center; padding:3rem 1rem; color: var(--fx-ink-soft); font-style:italic; }

  /* ---------------- the parchment sheet ---------------- */
  [data-fx]{
    /* No private palette. Every value below is a shared system token or a
       color-mix over one, which is the Themed-Surface Rule's actual demand.
       This surface is not a themed copy of the Ledger Panel, which is what it
       used to be: it *is* the Ledger Panel's material, with the same surface,
       edge, radius, shadow, cap and head rule, and the only thing that
       distinguishes it is that it holds 219 entries instead of six ability
       lines. The page is therefore the panel's own Bark 100 and the card is the
       panel's own Bark 200, one step off it - the panel's own `--pb-surface`
       and `--pb-raised`. */
    --fx-page: var(--color-bark-100);
    --fx-card: var(--color-bark-200);
    --fx-field: color-mix(in srgb, var(--color-parchment) 40%, var(--color-bark-100));
    --fx-sunk: color-mix(in srgb, var(--color-ink) 6%, transparent);
    --fx-ink: var(--color-ink);
    --fx-ink-soft: var(--color-bark-600);
    --fx-rule: color-mix(in srgb, var(--color-gold-rule) 42%, transparent);
    --fx-rule-strong: var(--color-gold-rule);
    --fx-heading: var(--color-oxblood);
    /* No --fx-accent: the Rarity Rule holds the accent for selection and
       action, and nothing on this surface is either - the filters are chosen,
       not selected, and a facet that tinted itself would be a fourth accent
       beside the cap and the head rule. */
    --fx-focus: var(--color-bark-black);
    --fx-chip: color-mix(in srgb, var(--color-gold-rule) 16%, var(--color-bark-100));
    --fx-chip-edge: color-mix(in srgb, var(--color-gold-rule) 55%, transparent);
    --fx-chip-ink: var(--color-ink);
    --fx-chip-dot: var(--color-gold);
    /* The three seal inks. Moss for Origin, Gold for General, Oxblood for Epic
       Boon - the same three the Admonition table uses, so the medallions are
       markers in the system's vocabulary rather than three new swatches. The
       label ink is a shared step per seal, chosen because AA for a 10px bold
       monogram is not reachable from any one of them: on Origin and Epic Boon
       only Parchment clears 4.5:1, and on General only Ink does. Gold is the
       one bright seal and Moss 800 and Oxblood are both dark, so the two dark
       seals are separated by hue (olive against red) at a matched luminance -
       hence the rim on every seal, which is what makes the edge readable. */
    --fx-seal-origin: var(--color-moss-800);
    --fx-seal-origin-ink: var(--color-moss-100);
    --fx-seal-general: var(--color-gold);
    --fx-seal-general-ink: var(--color-ink);
    --fx-seal-epic: var(--color-oxblood);
    --fx-seal-epic-ink: var(--color-parchment);
    /* The padding is symmetric, and it is symmetric because there is nothing on
       the edge any more. It was 2rem on the right against 1.75rem on the left
       to leave the wax ribbon's 24px reach a gutter of its own, and the ribbon
       is gone; leaving the 2rem would have shipped a phantom quarter-inch down
       one side and made the panel read as accidentally mis-aligned. There is no
       ornament on this edge now, so there is nothing for the padding to clear. */
    position:relative; padding: 1.5rem 1.75rem;
    background: var(--fx-page);
    border:1px solid var(--fx-rule-strong); border-radius: 8px;
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  }
  :root[data-theme="dark"] [data-fx]{
    /* The panel's own surface and raised step, so the sheet inverts exactly the
       way the Ledger Panel does: Bark 800 under Bark 100 in light, and no
       shadow in dark, where a card-rest on a surface this dark is a smudge. */
    --fx-page: var(--color-bark-800);
    --fx-card: var(--color-bark-700);
    --fx-field: color-mix(in srgb, var(--color-parchment) 9%, var(--color-bark-800));
    --fx-sunk: color-mix(in srgb, var(--color-parchment) 12%, transparent);
    --fx-ink: var(--color-parchment);
    --fx-ink-soft: var(--color-bark-400);
    --fx-rule: color-mix(in srgb, var(--color-gold-rule-dark) 45%, transparent);
    --fx-rule-strong: var(--color-gold-rule-dark);
    --fx-heading: var(--color-gold);
    --fx-focus: var(--color-bark-100);
    --fx-chip: color-mix(in srgb, var(--color-gold-rule-dark) 18%, var(--color-bark-700));
    --fx-chip-edge: color-mix(in srgb, var(--color-gold-rule-dark) 60%, transparent);
    --fx-chip-ink: var(--color-parchment);
    --fx-chip-dot: var(--color-gold);
    /* In dark the two dark seals would vanish into the page, so the tier split
       is carried by hue and lightness instead: Parchment-moss for Origin,
       Gold for General, and a Parchment-lifted Oxblood for Epic Boon - three
       that differ in hue at three different lightnesses, each with Ink on it.
       The Epic Boon mix is the palest Oxblood that still clears 4.5:1 under
       Ink; one step darker and the monogram fails AA. */
    --fx-seal-origin: var(--color-moss-100);
    --fx-seal-origin-ink: var(--color-moss-800);
    --fx-seal-general: var(--color-gold);
    --fx-seal-general-ink: var(--color-ink);
    --fx-seal-epic: color-mix(in srgb, var(--color-oxblood) 30%, var(--color-parchment));
    --fx-seal-epic-ink: var(--color-ink);
    box-shadow: none;
  }
  /* The 3px cap, drawn over the border so the 1px edge stays continuous, in
     the Ledger Panel's own construction. It and the 2px head rule bracket the
     panel without either one carrying colour alone, which is why the cap is
     the only accent bar here and the tier legend below is not given one. It is
     also the only pseudo-element *the root* draws: the stitched spine and then
     the wax ribbon both came off this root, and neither was a Tool Panel
     feature. The surface still has descendant pseudo-elements of its own - the
     select caret on `.fx-control::after`, the chip dot on `.fx-chip::before` and
     the middot leading the legend's note - and those are control furniture, not
     accents: a glyph in the field's own ink, 6px of the chip, and a separator.
     "One accent" is a claim about what is coloured, not about what has a
     generated box. */
  [data-fx]::before{ content:''; position:absolute; inset-inline:-1px; top:-1px; height:3px; border-radius: 8px 8px 0 0; background: var(--fx-heading); }

  .fx-title{ display:flex; align-items:baseline; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-bottom:1.125rem; padding-bottom:.75rem; border-bottom:2px solid var(--fx-rule-strong); }
  /* Both heading colours are set with an element-qualified class on purpose.
     `tailwind.css` carries `.sl-markdown-content :is(h1..h6){ color }` and its
     dark counterpart *without* the `:not(:where(.not-content *))` guard every
     neighbouring rule in that file has, so both reach inside this component -
     and the dark one is `:root[data-theme='dark'] .sl-markdown-content
     :is(h1..h6)`, which is (0,3,1) and beats a class-qualified `[data-fx]
     .fx-card .fx-name` at (0,3,0). So the selector has to out-specify it rather
     than merely beat the light rule, and the leak's value is not this
     component's to inherit: the h2's Oxblood-in-light was arriving by
     coincidence, because the leak happens to be the same accent. Adding the
     missing guard to those two rules in `tailwind.css` would be the better fix
     and would reach every other `not-content` component too; it is not this
     change's to make. */
  [data-fx] .fx-title h2.fx-page-title{ font-size:1.35rem; font-weight:600; letter-spacing:.04em; color: var(--fx-heading); }
  /* The count line and the in-flight line that replaces it share one rule, so the
     head cannot reflow between the two states: same size, same tracking, same
     soft ink. Only the stance differs - the count is tabular because it changes
     as you type and its digits must not shuffle, the loading line is italic
     because it is a state rather than a number. Italic and no spinner: there is
     no animation to interrupt and no reduced-motion question to answer, and a
     reader who lands here learns what is happening rather than that something
     is. */
  .fx-countline, .fx-loading{ font-family: var(--sl-font-table); font-size:.8125rem; letter-spacing:.04em; text-transform:uppercase; color: var(--fx-ink-soft); }
  .fx-countline{ font-variant-numeric: tabular-nums; }
  .fx-loading{ font-style:italic; }

  /* The tier key. A dl, so the marks and the names are a definition rather than
     a run of glyphs; the marks carry the three seal inks and nothing else, so
     this band adds no fourth accent to the cap and the head rule. */
  .fx-legend{ display:flex; flex-wrap:wrap; align-items:center; gap:.5rem 1.375rem; padding:.75rem 0; margin-bottom:1.25rem; border-top:1px solid var(--fx-rule); border-bottom:1px solid var(--fx-rule); }
  .fx-legend-label{ font-family: var(--sl-font-table); font-size:.5625rem; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color: var(--fx-ink-soft); }
  .fx-legend-keys{ display:flex; flex-wrap:wrap; align-items:center; gap:.5rem 1.375rem; margin:0; }
  .fx-legend-set{ display:flex; align-items:center; gap:.4375rem; }
  .fx-legend-set dt{ margin:0; line-height:0; }
  .fx-legend-set dd{ margin:0; font-family: var(--sl-font-table); font-size:.6875rem; color: var(--fx-ink-soft); }
  /* The trailing note, at the same step and the same ink as the three names so
     it reads as part of the key rather than as a fourth entry. A middot leads
     it, which is the separator the card foot already uses. */
