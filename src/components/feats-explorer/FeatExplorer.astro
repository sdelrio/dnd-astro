---
import { FEATS, BOOKS, ABILITIES } from './feat-data';
import IconifyIcon from '@/components/IconifyIcon.astro';

const initialData = {
  feats: FEATS,
  books: BOOKS,
  abilities: ABILITIES
};
---

<div
  x-data={`featExplorer(${JSON.stringify(initialData)})`}
  class="not-content space-y-6"
>
  <!-- Filter controls -->
    <div class="flex flex-col sm:flex-row gap-4 mb-6">
      <div class="flex-1">
        <label for="feat-search" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Search feats</label>
        <input
          id="feat-search"
          type="text"
          x-model="searchQuery"
          @input.debounce.300ms="filterFeats()"
          placeholder="Type a feat name..."
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"
        />
      </div>
      
      <div class="sm:w-32">
        <label for="ability-filter" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Ability</label>
        <select
          id="ability-filter"
          x-model="selectedAbility"
          @change="filterFeats()"
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"
        >
          <option value="All">All Abilities</option>
          <template x-for="ability in abilities" :key="ability">
            <option :value="ability" x-text="ability"></option>
          </template>
        </select>
      </div>
      
      <div class="sm:w-48">
        <label for="book-filter" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Book</label>
        <select
          id="book-filter"
          x-model="selectedBook"
          @change="filterFeats()"
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"
        >
          <option value="All">All Books</option>
          <template x-for="(label, code) in books" :key="code">
            <option :value="code" x-text="label"></option>
          </template>
        </select>
      </div>
      
      <div class="sm:w-24">
        <label for="level-filter" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Level</label>
        <select
          id="level-filter"
          x-model="selectedLevel"
          @change="filterFeats()"
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"
        >
          <option value="All">All Levels</option>
          <option value="0">Level 0</option>
          <option value="4-18">Level 4-18</option>
          <option value="19">Level 19</option>
          <option value="21">Level 21</option>
        </select>
      </div>
    </div>
    
    <!-- Clear filters and result count -->
    <div class="flex items-center justify-between mb-6">
      <p class="text-sm text-gray-600 dark:text-gray-400">
        <span x-text="filteredFeats.length"></span> feat<span x-show="filteredFeats.length !== 1">s</span> found
      </p>
      <button
        x-show="hasActiveFilters()"
        @click="clearFilters()"
        class="text-blue-600 hover:text-blue-800 transition-colors"
        title="Clear filters"
        aria-label="Clear all filters"
      >
        <IconifyIcon icon="mdi:filter-remove" width="1.25em" />
      </button>
    </div>
    
    <!-- Feat grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <template x-for="feat in filteredFeats" :key="feat.name">
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm overflow-hidden hover:shadow-md transition-shadow">
          <div class="p-4">
            <div class="flex justify-between items-start mb-2">
              <h3 class="font-bold text-gray-900 dark:text-gray-100" x-text="feat.name"></h3>
              <span 
                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium"
                :class="feat.level === 0 ? 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200' : feat.level >= 19 ? 'bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200' : 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200'"
                x-text="feat.level === 0 ? 'Origin' : feat.level >= 19 ? 'Epic Boon' : 'General'"
              ></span>
            </div>
            
            <div class="text-sm text-gray-600 dark:text-gray-400 mb-2" x-text="feat.description"></div>
            
            <div class="flex flex-wrap gap-1 mb-2">
              <template x-if="feat.abilityIncrease && feat.abilityIncrease.length > 0">
                <div class="flex flex-wrap gap-1">
                  <template x-for="ability in feat.abilityIncrease" :key="ability">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200" x-text="ability"></span>
                  </template>
                </div>
              </template>
            </div>
            
            <div class="flex justify-between items-center text-xs text-gray-500 dark:text-gray-400">
              <span x-text="books[feat.book] || feat.book"></span>
              <span x-show="feat.prerequisite" x-text="'Prereq: ' + feat.prerequisite"></span>
            </div>
          </div>
        </div>
      </template>
    </div>
    
  <!-- Empty state -->
  <div x-show="filteredFeats.length === 0" class="text-center py-12 text-gray-500 dark:text-gray-400">
    No feats match your filters.
  </div>
</div>

<script>
  import type { FEATS, BOOKS, ABILITIES } from './feat-data';

  interface FeatExplorerData {
    feats?: typeof FEATS;
    books?: typeof BOOKS;
    abilities?: typeof ABILITIES;
  }

  declare global {
    interface Window {
      featExplorer: typeof featExplorer;
    }
  }

  function levenshtein(a: string, b: string) {
    const m = a.length;
    const n = b.length;
    const dp = Array.from({ length: m + 1 }, () => Array(n + 1).fill(0));
    for (let i = 0; i <= m; i++) dp[i][0] = i;
    for (let j = 0; j <= n; j++) dp[0][j] = j;
    for (let i = 1; i <= m; i++) {
      for (let j = 1; j <= n; j++) {
        if (a[i - 1] === b[j - 1]) {
          dp[i][j] = dp[i - 1][j - 1];
        } else {
          dp[i][j] = Math.min(dp[i - 1][j] + 1, dp[i][j - 1] + 1, dp[i - 1][j - 1] + 1);
        }
      }
    }
    return dp[m][n];
  }

  function fuzzyMatch(query: string, text: string) {
    if (!query) return true;
    const lowerQuery = query.toLowerCase();
    const lowerText = text.toLowerCase();
    if (lowerText.includes(lowerQuery)) return true;
    const distance = levenshtein(lowerQuery, lowerText);
    return distance <= Math.floor(query.length / 3);
  }

  function featExplorer(data: FeatExplorerData) {
    return {
      feats: data.feats || [],
      filteredFeats: data.feats ? [...data.feats] : [],
      abilities: data.abilities || [],
      books: data.books || {},
      searchQuery: '',
      selectedAbility: 'All',
      selectedBook: 'All',
      selectedLevel: 'All',

      filterFeats() {
        this.filteredFeats = this.feats.filter(feat => {
          const matchesSearch = !this.searchQuery || fuzzyMatch(this.searchQuery, feat.name);
          const matchesAbility = this.selectedAbility === 'All' ||
            (feat.abilityIncrease && feat.abilityIncrease.includes(this.selectedAbility));
          const matchesBook = this.selectedBook === 'All' || feat.book === this.selectedBook;
          let matchesLevel = true;
          if (this.selectedLevel !== 'All') {
            const level = Number(this.selectedLevel);
            if (level === 0) matchesLevel = feat.level === 0;
            else if (level === 19) matchesLevel = feat.level === 19;
            else if (level === 21) matchesLevel = feat.level === 21;
            else if (this.selectedLevel === '4-18') matchesLevel = feat.level >= 4 && feat.level <= 18;
          }
          return matchesSearch && matchesAbility && matchesBook && matchesLevel;
        });
      },

      clearFilters() {
        this.searchQuery = '';
        this.selectedAbility = 'All';
        this.selectedBook = 'All';
        this.selectedLevel = 'All';
        this.filterFeats();
      },

      hasActiveFilters() {
        return this.searchQuery !== '' ||
          this.selectedAbility !== 'All' ||
          this.selectedBook !== 'All' ||
          this.selectedLevel !== 'All';
      }
    };
  };

  window.featExplorer = featExplorer;
</script>
