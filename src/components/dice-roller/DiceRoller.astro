---
interface Ability {
  name: string;
  dice: number[];
  topThree: number[];
  topThreeIndices: number[];
  sum: number;
  modifier: number;
  rolling: boolean;
}

const abilities: Ability[] = [
  { name: 'STR', dice: [], topThree: [], topThreeIndices: [], sum: 0, modifier: 0, rolling: false },
  { name: 'DEX', dice: [], topThree: [], topThreeIndices: [], sum: 0, modifier: 0, rolling: false },
  { name: 'CON', dice: [], topThree: [], topThreeIndices: [], sum: 0, modifier: 0, rolling: false },
  { name: 'INT', dice: [], topThree: [], topThreeIndices: [], sum: 0, modifier: 0, rolling: false },
  { name: 'WIS', dice: [], topThree: [], topThreeIndices: [], sum: 0, modifier: 0, rolling: false },
  { name: 'CHA', dice: [], topThree: [], topThreeIndices: [], sum: 0, modifier: 0, rolling: false },
];
---

<div
  x-data={`diceRoller(${JSON.stringify(abilities)})`}
  class="space-y-6"
>
  <div class="flex justify-center">
    <button
      @click="rollAll()"
      :disabled="isRolling"
      class="px-6 py-3 bg-blue-600 text-white rounded-lg shadow hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
      aria-label="Roll all ability scores"
    >
      <span x-text="isRolling ? 'Rolling...' : 'Roll All Abilities'"></span>
    </button>
  </div>

  <div x-show="preSwapStats" class="grid grid-cols-2 gap-4">
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-4">
      <h3 class="font-bold text-gray-900 mb-2">Pre-Swap Stats</h3>
      <div class="space-y-1 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-600">Average:</span>
          <span class="font-medium" x-text="preSwapStats?.average"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Median:</span>
          <span class="font-medium" x-text="preSwapStats?.median"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Lowest:</span>
          <span class="font-medium" x-text="preSwapStats?.lowest + (preSwapStats?.lowestCount > 1 ? ' (x' + preSwapStats?.lowestCount + ')' : '')"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Highest:</span>
          <span class="font-medium" x-text="preSwapStats?.highest + (preSwapStats?.highestCount > 1 ? ' (x' + preSwapStats?.highestCount + ')' : '')"></span>
        </div>
      </div>
    </div>
    <div x-show="showPostSwap" class="bg-white border border-gray-200 rounded-lg shadow-sm p-4">
      <h3 class="font-bold text-gray-900 mb-2">Post-Swap Stats</h3>
      <div class="space-y-1 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-600">Average:</span>
          <span class="font-medium" x-text="postSwapStats?.average"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Median:</span>
          <span class="font-medium" x-text="postSwapStats?.median"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Lowest:</span>
          <span class="font-medium" x-text="postSwapStats?.lowest + (postSwapStats?.lowestCount > 1 ? ' (x' + postSwapStats?.lowestCount + ')' : '')"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Highest:</span>
          <span class="font-medium" x-text="postSwapStats?.highest + (postSwapStats?.highestCount > 1 ? ' (x' + postSwapStats?.highestCount + ')' : '')"></span>
        </div>
      </div>
    </div>
  </div>

  <div x-show="resultLog.length > 0" class="max-h-[200px] overflow-y-auto space-y-2 border border-gray-200 rounded-lg p-3 bg-gray-50">
    <template x-for="(entry, i) in resultLog" :key="i">
      <div class="text-sm text-gray-700 font-mono" x-text="entry"></div>
    </template>
  </div>

  <div class="grid grid-cols-3 lg:grid-cols-6 gap-4">
    <template x-for="(ability, index) in abilities" :key="ability.name">
      <div>
        <div
          @click="selectAbility(index)"
          class="bg-white border rounded-lg shadow-sm overflow-hidden cursor-pointer transition-colors"
          :class="selectedIndex === index ? 'border-blue-500 ring-2 ring-blue-200' : stagedSwap && (stagedSwap.index1 === index || stagedSwap.index2 === index) ? 'border-blue-400' : 'border-gray-200'"
        >
          <div class="p-4">
            <div class="flex justify-between items-center mb-2">
              <h3 class="font-bold text-gray-900" x-text="ability.name"></h3>
              <button
                @click.stop="rollIndividual(index)"
                :disabled="isRolling || ability.rolling || selectedIndex !== null"
                class="text-xs text-blue-600 hover:text-blue-800 disabled:opacity-50 disabled:cursor-not-allowed"
                aria-label="Re-roll ability score"
              >
                Retry
              </button>
            </div>
            
            <div x-show="ability.dice.length > 0" class="space-y-2">
              <div class="flex gap-1 justify-center">
                <template x-for="(die, i) in ability.dice" :key="i">
                  <span
                    class="w-8 h-8 flex items-center justify-center rounded border text-sm font-medium"
                    :class="ability.topThreeIndices.includes(i) ? 'bg-blue-100 border-blue-300 text-blue-800' : 'bg-gray-100 border-gray-300 text-gray-500 line-through'"
                    x-text="die"
                  ></span>
                </template>
              </div>
              
              <div class="text-center">
                <div class="text-sm text-gray-600">
                  <span x-text="ability.topThree.join(' + ')"></span> = <span x-text="ability.sum" class="font-bold"></span>
                </div>
                <div class="text-lg font-bold text-gray-900" x-text="formatModifier(ability.modifier)"></div>
              </div>
            </div>
            
            <div x-show="ability.dice.length === 0" class="text-center py-4 text-gray-500">
              Roll to generate
            </div>
          </div>
          
          <div
            x-show="ability.rolling"
            class="h-1 bg-blue-500 animate-pulse"
          ></div>
        </div>
        <template x-if="stagedSwap && stagedSwap.index1 === index">
          <div class="mt-2 bg-blue-50 border border-blue-300 rounded-lg p-2 flex items-center justify-between text-sm">
            <span class="text-blue-800 font-medium" x-text="'Swap ' + abilities[stagedSwap.index1].name + ' ↔ ' + abilities[stagedSwap.index2].name"></span>
            <div class="flex gap-1">
              <button
                @click="confirmSwap()"
                class="px-2 py-1 bg-blue-600 text-white text-xs rounded hover:bg-blue-700 transition-colors"
              >
                Confirm
              </button>
              <button
                @click="cancelSwap()"
                class="px-2 py-1 bg-gray-200 text-gray-700 text-xs rounded hover:bg-gray-300 transition-colors"
              >
                Cancel
              </button>
            </div>
          </div>
        </template>
      </div>
    </template>
  </div>

  <div class="text-center text-sm text-gray-500">
    <p>Roll 4d6-drop-lowest for each ability score.</p>
  </div>

</div>

<script>
import { rollAbility, calculateModifier, formatModifier, updateAbilityWithRoll, calculateStats, formatStats, formatResultLog, swapAbilities } from './dice-utils';

// Make functions available globally for Alpine.js
window.rollAbility = rollAbility;
window.calculateModifier = calculateModifier;
window.formatModifier = formatModifier;
window.updateAbilityWithRoll = updateAbilityWithRoll;
window.calculateStats = calculateStats;
window.formatStats = formatStats;
window.formatResultLog = formatResultLog;
window.swapAbilities = swapAbilities;

// Define the diceRoller function for Alpine.js
window.diceRoller = function(abilities) {
  return {
    abilities: abilities,
    resultLog: [],
    isRolling: false,
    currentRollingIndex: -1,
    preSwapStats: null,
    showPostSwap: false,
    postSwapStats: null,
    selectedIndex: null as number | null,
    stagedSwap: null as { index1: number; index2: number } | null,
    swapUsed: false,
    rollAll() {
      if (this.isRolling) return;
      this.isRolling = true;
      this.preSwapStats = null;
      this.showPostSwap = false;
      this.postSwapStats = null;
      this.selectedIndex = null;
      this.stagedSwap = null;
      this.swapUsed = false;
      let index = 0;
      const rollNext = () => {
        if (index >= this.abilities.length) {
          this.isRolling = false;
          this.resultLog.unshift(window.formatResultLog(this.abilities));
          const sums = this.abilities.map(a => a.sum);
          this.preSwapStats = window.formatStats(window.calculateStats(sums));
          return;
        }
        this.currentRollingIndex = index;
        this.abilities[index].rolling = true;
        
        setTimeout(() => {
          const result = window.rollAbility();
          this.abilities[index] = window.updateAbilityWithRoll(this.abilities[index], result);
          index++;
          setTimeout(rollNext, 150);
        }, 300);
      };
      rollNext();
    },
    rollIndividual(index) {
      if (this.isRolling || this.abilities[index].rolling) return;
      this.abilities[index].rolling = true;
      
      setTimeout(() => {
        const result = window.rollAbility();
        this.abilities[index] = window.updateAbilityWithRoll(this.abilities[index], result);
      }, 300);
    },
    selectAbility(index) {
      if (this.swapUsed || this.isRolling) return;
      if (this.selectedIndex === null) {
        this.selectedIndex = index;
        return;
      }
      if (this.selectedIndex === index) {
        this.selectedIndex = null;
        return;
      }
      this.stagedSwap = { index1: this.selectedIndex, index2: index };
    },
    confirmSwap() {
      if (!this.stagedSwap) return;
      const { index1, index2 } = this.stagedSwap;
      this.abilities = window.swapAbilities(this.abilities, index1, index2);
      this.selectedIndex = null;
      this.stagedSwap = null;
      this.swapUsed = true;
      this.resultLog[0] = window.formatResultLog(this.abilities);
      const sums = this.abilities.map((a) => a.sum);
      this.postSwapStats = window.formatStats(window.calculateStats(sums));
      this.showPostSwap = true;
    },
    cancelSwap() {
      this.selectedIndex = null;
      this.stagedSwap = null;
    }
  };
};
</script>
