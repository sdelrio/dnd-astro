---
import characters from '@/generated/characters.json';

const allClasses = [...new Set(characters.flatMap((c) => c.classes.map((cl) => cl.name)))].sort();
const allRaces = [...new Set(characters.map((c) => c.race))].sort();
---

<div
  x-data="{
    search: '',
    selectedClass: '',
    selectedRace: '',
    characters: $el.dataset.characters ? JSON.parse($el.dataset.characters) : [],
    get filtered() {
      return this.characters.filter(c => {
        const matchesSearch = !this.search || c.name.toLowerCase().includes(this.search.toLowerCase());
        const matchesClass = !this.selectedClass || c.classes.some(cl => cl.name === this.selectedClass);
        const matchesRace = !this.selectedRace || c.race === this.selectedRace;
        return matchesSearch && matchesClass && matchesRace;
      });
    },
    clearFilters() {
      this.search = '';
      this.selectedClass = '';
      this.selectedRace = '';
    }
  }"
  data-characters={JSON.stringify(characters)}
  class="not-content space-y-6"
>
  <div class="flex flex-col sm:flex-row gap-4">
    <div class="flex-1">
      <label for="char-search" class="block text-sm font-medium text-gray-700 mb-1">Search by name</label>
      <input
        id="char-search"
        type="text"
        x-model="search"
        placeholder="Type a character name..."
        class="w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
      />
    </div>
    <div class="sm:w-48">
      <label for="class-filter" class="block text-sm font-medium text-gray-700 mb-1">Class</label>
      <select
        id="class-filter"
        x-model="selectedClass"
        class="w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
      >
        <option value="">All Classes</option>
        {allClasses.map((cls) => (
          <option value={cls}>{cls}</option>
        ))}
      </select>
    </div>
    <div class="sm:w-48">
      <label for="race-filter" class="block text-sm font-medium text-gray-700 mb-1">Race</label>
      <select
        id="race-filter"
        x-model="selectedRace"
        class="w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
      >
        <option value="">All Races</option>
        {allRaces.map((race) => (
          <option value={race}>{race}</option>
        ))}
      </select>
    </div>
  </div>

  <div class="flex items-center justify-between">
    <p class="text-sm text-gray-600">
      <span x-text="filtered.length"></span> character<span x-show="filtered.length !== 1">s</span> found
    </p>
    <button
      x-show="search || selectedClass || selectedRace"
      @click="clearFilters()"
      class="text-sm text-blue-600 hover:text-blue-800 underline"
    >
      Clear filters
    </button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <template x-for="char in filtered" :key="char.name">
      <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden hover:shadow-md transition-shadow">
        <div class="flex items-center p-4 gap-4">
          <img
            :src="char.avatarPath"
            :alt="char.name + ' portrait'"
            class="w-16 h-16 rounded object-cover"
          />
          <div class="flex-1 min-w-0">
            <h3 class="font-semibold text-gray-900 truncate" x-text="char.name"></h3>
            <p class="text-sm text-gray-600" x-text="char.race"></p>
            <p class="text-sm text-gray-500" x-text="char.classes.map(c => c.name + ' ' + c.level).join(' / ')"></p>
          </div>
        </div>
        <div class="grid grid-cols-4 gap-1 px-4 pb-4">
          <div class="text-center p-1 bg-gray-50 rounded">
            <div class="text-xs text-gray-500">AC</div>
            <div class="font-bold text-gray-900" x-text="char.ac"></div>
          </div>
          <div class="text-center p-1 bg-gray-50 rounded">
            <div class="text-xs text-gray-500">HP</div>
            <div class="font-bold text-gray-900" x-text="char.hp"></div>
          </div>
          <div class="text-center p-1 bg-gray-50 rounded">
            <div class="text-xs text-gray-500">SPD</div>
            <div class="font-bold text-gray-900" x-text="char.speed"></div>
          </div>
          <div class="text-center p-1 bg-gray-50 rounded">
            <div class="text-xs text-gray-500">INIT</div>
            <div class="font-bold text-gray-900" x-text="char.initiative > 0 ? '+' + char.initiative : char.initiative"></div>
          </div>
        </div>
      </div>
    </template>
  </div>

  <div x-show="filtered.length === 0" class="text-center py-12 text-gray-500">
    No characters match your filters.
  </div>
</div>
