---
import { getCharacters } from '@/utils/generated-characters';
import { toFilterableCharacters } from '@/components/xml-viewer/char-filter';
import XmlCard from '@/components/xml-viewer/XmlCard.astro';
import IconifyIcon from '@/components/IconifyIcon.astro';

const characters = getCharacters();

const allClasses = [...new Set(characters.flatMap((c) => c.classes.map((cl) => cl.name)))].sort();
const allRaces = [...new Set(characters.map((c) => c.race))].sort();
const filterPayload = JSON.stringify(toFilterableCharacters(characters));
---

<div
  x-data="charSearch"
  data-characters={filterPayload}
  class="not-content space-y-6"
>
  <div class="flex flex-col sm:flex-row gap-4">
    <div class="flex-1">
      <label for="char-search" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Search by name</label>
      <input
        id="char-search"
        type="text"
        x-model="search"
        placeholder="Type a character name..."
        class="w-full min-h-11 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-(--sl-color-accent) focus:border-(--sl-color-accent) text-base sm:text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"
      />
    </div>

    <!-- Same collapse as FeatExplorer: two full-width selects stacked under the
         search box pushed the first card off a phone screen. No `hidden` class
         on the panel: `x-show` reveals by removing its own inline display, so a
         class-based `display:none` would win again and the toggle would be dead
         on a phone. `x-cloak` covers the pre-boot paint and `sm:flex!` outranks
         the inline `display:none` so the sm+ row stays inline. -->
    <button
      type="button"
      x-cloak
      x-show="!filtersOpen"
      @click="filtersOpen = true"
      class="sm:hidden min-h-11 inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-(color:--sl-color-accent) text-(color:--sl-color-accent) font-medium transition-colors"
      aria-controls="char-filter-panel"
      :aria-expanded="filtersOpen ? 'true' : 'false'"
    >
      <IconifyIcon icon="mdi:tune-variant" width="1.25em" />
      <span>Filters</span>
      <span
        x-show="activeFilterCount() > 0"
        x-text="activeFilterCount()"
        class="inline-flex items-center justify-center min-w-5 h-5 px-1.5 rounded-full bg-(--sl-color-accent) text-(color:--sl-color-text-invert) text-xs font-bold"
      ></span>
    </button>

    <div
      id="char-filter-panel"
      x-cloak
      x-show="filtersOpen"
      class="sm:flex! sm:flex-row sm:items-start gap-4"
    >
    <div class="sm:w-48">
      <label for="class-filter" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Class</label>
      <select
        id="class-filter"
        x-model="selectedClass"
        class="w-full min-h-11 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-(--sl-color-accent) focus:border-(--sl-color-accent) text-base sm:text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"
      >
        <option value="">All Classes</option>
        {allClasses.map((cls) => (
          <option value={cls}>{cls}</option>
        ))}
      </select>
    </div>
    <div class="sm:w-48">
      <label for="race-filter" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Race</label>
      <select
        id="race-filter"
        x-model="selectedRace"
        class="w-full min-h-11 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-(--sl-color-accent) focus:border-(--sl-color-accent) text-base sm:text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"
      >
        <option value="">All Races</option>
        {allRaces.map((race) => (
          <option value={race}>{race}</option>
        ))}
      </select>
    </div>
    </div>
  </div>

  <div class="flex items-center justify-between">
    <p class="text-sm text-gray-600 dark:text-gray-400" role="status" aria-live="polite">
      <span x-text="matchCount">{characters.length}</span> character<span
        hidden={characters.length === 1}
        :hidden="matchCount === 1"
      >s</span> found
    </p>
    <button
      hidden
      :hidden="!(search || selectedClass || selectedRace)"
      @click="clearFilters()"
      class="inline-flex items-center justify-center w-11 h-11 -mr-2 text-(color:--sl-color-accent) hover:text-(color:--sl-color-accent-high) transition-colors"
      title="Clear filters"
      aria-label="Clear all filters"
    >
      <IconifyIcon icon="mdi:filter-remove" width="1.25em" />
    </button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {characters.map((char, i) => (
      <div :hidden={"!matches(" + i + ")"}>
        <XmlCard character={char} display="small" />
      </div>
    ))}
  </div>

  <div
    hidden={characters.length > 0}
    :hidden="matchCount !== 0"
    class="text-center py-12 text-gray-500 dark:text-gray-400"
  >
    No characters match your filters.
  </div>
</div>
