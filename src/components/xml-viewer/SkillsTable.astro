---
// The Skills table, shared by both display modes.
//
// It used to be inline in XmlCard.astro and only reachable at large, where it
// listed every skill the sheet knows. Medium got a different thing entirely: a
// bare grid of name/value pairs with no card, no ability column, no proficiency
// dots and no legend. So the same section read as two designs depending on the
// display mode, and a medium reader could not tell an expertise dot from a
// proficient one because medium had none.
//
// Now there is one table. Medium passes the proficient rows only; large passes
// all of them. The rows, the marks, the legend and the plate are identical, so
// the section looks the same at both sizes and is only shorter.
import { skillRank, type SkillRank } from '@/components/xml-viewer/skill-display';
import { cardPlateClass } from '@/components/xml-viewer/card-plate';
import { sectionLegendClass } from '@/components/xml-viewer/section-heading';
import { signed } from '@/utils/format';
import { chunk } from '@/utils/chunk';

export interface SkillTableRow {
  name: string;
  total: number;
  prof: number;
  stat: string;
}

interface Props {
  rows: SkillTableRow[];
  /** 2 splits the list into two side-by-side tables (large); 1 stacks it. */
  columns?: 1 | 2;
}

const { rows, columns = 2 } = Astro.props;

const SKILL_RANK_LABEL: Record<Exclude<SkillRank, 'none'>, string> = {
  proficient: 'Proficient',
  expertise: 'Expertise',
  half: 'Half proficiency',
};

function abilityAbbr(stat: string): string {
  return stat ? stat.slice(0, 3).toUpperCase() : '';
}

const skillColumns = chunk(rows, columns);
const hasSkillMarks = rows.some((skill) => skillRank(skill.prof) !== 'none');
---

<div class={cardPlateClass}>
  <div class={columns === 2 ? 'grid grid-cols-1 @lg:grid-cols-2 gap-2' : 'grid grid-cols-1 gap-2'}>
    {skillColumns.map((column) => (
      <table class="w-full text-sm">
        <thead>
          <tr class="text-[10px] uppercase tracking-wide text-gray-500 dark:text-gray-400">
            <th class="text-left font-medium pb-1">Skill</th>
            <th class="text-left font-medium pb-1">Abil</th>
            <th class="text-right font-medium pb-1">Total</th>
          </tr>
        </thead>
        <tbody>
          {column.map((skill) => {
            const rank = skillRank(skill.prof);
            return (
              <tr class="border-t border-gray-200 dark:border-gray-700">
                <td class="py-1 text-gray-700 dark:text-gray-300">
                  <span class="inline-flex items-center gap-1">
                    <span class="truncate">{skill.name}</span>
                    {rank !== 'none' && (
                      <span class="inline-flex items-center gap-px" data-prof-rank={rank}>
                        <span class="sr-only">{SKILL_RANK_LABEL[rank]}</span>
                        {rank === 'proficient' && (
                          <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
                        )}
                        {rank === 'expertise' && (
                          <>
                            <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
                          </>
                        )}
                        {rank === 'half' && (
                          <span class="w-1.5 h-1.5 overflow-hidden rounded-full border border-[#c68000]" aria-hidden="true">
                            <span class="block w-1/2 h-full bg-[#c68000]"></span>
                          </span>
                        )}
                      </span>
                    )}
                  </span>
                </td>
                <td class="py-1 text-gray-500 dark:text-gray-400">{abilityAbbr(skill.stat)}</td>
                <td class="py-1 text-right font-mono font-semibold text-gray-900 dark:text-gray-100">
                  {signed(skill.total)}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    ))}
  </div>
  {hasSkillMarks && (
    <div class={`mt-3 pt-2 border-t border-gray-100 dark:border-gray-700 flex flex-wrap gap-4 ${sectionLegendClass}`}>
      <span class="inline-flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
        Proficient
      </span>
      <span class="inline-flex items-center gap-1">
        <span class="inline-flex items-center gap-px" aria-hidden="true">
          <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
        </span>
        Expertise
      </span>
      <span class="inline-flex items-center gap-1">
        <span class="w-1.5 h-1.5 overflow-hidden rounded-full border border-[#c68000]" aria-hidden="true">
          <span class="block w-1/2 h-full bg-[#c68000]"></span>
        </span>
        Half proficiency
      </span>
    </div>
  )}
</div>
