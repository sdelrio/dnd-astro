---
import { partyStats } from '@/utils/party-stats';
import {
  ALL_ROLES,
  ROLE_CONFIG,
  readPartyRoster,
  resolvePartyMembers,
} from '@/components/xml-viewer/party-roster';
import { join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import XmlCard from '@/components/xml-viewer/XmlCard.astro';
import IconifyIcon from '@/components/IconifyIcon.astro';

interface Props {
  rosterPath?: string;
}

const { rosterPath } = Astro.props;

const __dirname = join(fileURLToPath(import.meta.url), '..');

const defaultRosterPath = resolve(__dirname, '../../../public/fg/party.json');

const roster = readPartyRoster(rosterPath ?? defaultRosterPath);
const resolved = resolvePartyMembers(roster.party);
const warnings = [...roster.warnings, ...resolved.warnings];
for (const warning of warnings) {
  console.warn(`[PartyView] ${warning}`);
}

const partyName = roster.party.partyName;
const members = resolved.members;
const rosterUnavailable = !roster.ok;

const stats = partyStats(members);

const allRoles = ALL_ROLES;
const allRolesJson = JSON.stringify(allRoles);
const roleConfigJson = JSON.stringify(ROLE_CONFIG);
---

<div
  class="not-content space-y-6"
  x-data="partyView($el)"
  data-all-roles={allRolesJson}
  data-role-config={roleConfigJson}
  data-member-count={members.length}
  data-member-roles={JSON.stringify(members.map((m) => m.roles))}
>
  <section class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6">
    <h1 class="mt-0 text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">{partyName}</h1>
    <p class="mt-0 text-gray-600 dark:text-gray-400 mb-4">{members.length} active members</p>

    {rosterUnavailable && (
      <p class="mt-0 mb-4 rounded-lg border border-amber-300 bg-amber-50 dark:border-amber-700 dark:bg-amber-950 px-4 py-3 text-sm text-amber-800 dark:text-amber-200" role="status">
        Party roster unavailable - see the build log for details.
      </p>
    )}

    {!rosterUnavailable && members.length === 0 && (
      <p class="mt-0 mb-4 rounded-lg border border-amber-300 bg-amber-50 dark:border-amber-700 dark:bg-amber-950 px-4 py-3 text-sm text-amber-800 dark:text-amber-200" role="status">
        No members could be resolved - see the build log for details.
      </p>
    )}

    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
      <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 text-center">
        <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1">Total HP</div>
        <div class="text-2xl font-bold text-gray-900 dark:text-gray-100">{stats.totalHp}</div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 text-center">
        <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1">Average AC</div>
        <div class="text-2xl font-bold text-gray-900 dark:text-gray-100">{stats.avgAc}</div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 text-center">
        <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1">Average Initiative</div>
        <div class="text-2xl font-bold text-gray-900 dark:text-gray-100">{stats.avgInit >= 0 ? '+' : ''}{stats.avgInit}</div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 text-center">
        <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1">Total Level</div>
        <div class="text-2xl font-bold text-gray-900 dark:text-gray-100">{stats.totalLevel}</div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 text-center">
        <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1">Members</div>
        <div class="text-2xl font-bold text-gray-900 dark:text-gray-100">{members.length}</div>
      </div>
    </div>

    <div class="flex flex-wrap gap-2 mt-4" aria-label="Role breakdown">
      {allRoles.map((role) => {
        const config = ROLE_CONFIG[role];
        return (
          <span
            class="r3-role-pill"
            style={`--role-light: ${config.light}; --role-dark: ${config.dark};`}
          >
            <IconifyIcon icon={config.icon} width="0.875em" class="inline-block mr-1 align-[-2px]" />
            {config.label}: {stats.roleCounts[role] ?? 0}
          </span>
        );
      })}
    </div>

    <div class="r3-group" role="group" aria-label="Filter by role">
      <button
        class="r3-chip r3-chip-all"
        :class={"activeRoles.length === allRoles.length ? 'is-active' : ''"}
        @click="activeRoles = activeRoles.length === allRoles.length ? [] : [...allRoles]"
        :aria-pressed="activeRoles.length === allRoles.length"
      >
        All
        <span class="r3-count">{members.length}</span>
      </button>
      {allRoles.map((role) => {
        const config = ROLE_CONFIG[role];
        return (
          <button
            class="r3-chip"
            style={`--role-light: ${config.light}; --role-dark: ${config.dark};`}
            :class={"isRoleActive('" + role + "') ? 'is-active' : ''"}
            @click={"toggleRole('" + role + "')"}
            :aria-pressed={"isRoleActive('" + role + "')"}
          >
            <IconifyIcon icon={config.icon} width="1em" class="inline-block w-3.5 h-3.5 align-[-2px]" />
            {config.label}
            <span class="r3-count">{stats.roleCounts[role] ?? 0}</span>
          </button>
        );
      })}
    </div>
    <p class="sr-only" role="status" aria-live="polite" x-text="statusMessage()"></p>
  </section>

  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" role="list" aria-label="Party members">
    {members.map((member) => {
      return (
        <div
          class="transition-opacity duration-200"
          :class={"{ hidden: !hasActiveRole(" + JSON.stringify(member.roles) + ") }"}
          role="listitem"
        >
          <XmlCard
            character={member.character}
            display="small"
          />
          <div class="mt-2 flex flex-wrap items-center gap-2">
            {member.roles.map((role) => {
              const roleConfig = ROLE_CONFIG[role];
              return (
                <span
                  class="r3-role-pill"
                  style={`--role-light: ${roleConfig.light}; --role-dark: ${roleConfig.dark};`}
                >
                  <IconifyIcon icon={roleConfig.icon} width="0.875em" class="inline-block mr-1 align-[-2px]" />
                  {roleConfig.label}
                </span>
              );
            })}
            {member.notes && (
              <span class="text-xs text-gray-500 dark:text-gray-400 italic">{member.notes}</span>
            )}
          </div>
        </div>
      );
    })}
  </section>

  <script is:inline>
    window.partyView = function(el) {
      const allRoles = JSON.parse(el.dataset.allRoles);
      const roleConfig = JSON.parse(el.dataset.roleConfig);
      const memberCount = Number(el.dataset.memberCount);
      const memberRoles = JSON.parse(el.dataset.memberRoles);
      return {
        allRoles,
        roleConfig,
        memberCount,
        memberRoles,
        activeRoles: [...allRoles],
        toggleRole(role) {
          if (this.activeRoles.includes(role)) {
            this.activeRoles = this.activeRoles.filter((r) => r !== role);
          } else {
            this.activeRoles.push(role);
          }
        },
        isRoleActive(role) {
          return this.activeRoles.includes(role);
        },
        hasActiveRole(roles) {
          return roles.some((role) => this.isRoleActive(role));
        },
        /**
         * Announced after every filter change. Pure on purpose: assigning to
         * reactive state from inside an `x-text` expression re-triggers the
         * effect that called it.
         */
        statusMessage() {
          const total = this.memberCount;
          const visible = this.memberRoles.filter((roles) => this.hasActiveRole(roles)).length;
          if (this.activeRoles.length === this.allRoles.length) {
            return `Filter: all roles. ${visible} members shown.`;
          }
          if (this.activeRoles.length === 0) {
            return `Filter: no roles. 0 of ${total} members shown.`;
          }
          const names = this.activeRoles.map((r) => this.roleConfig[r].label).join(', ');
          return `Filter: ${names}. ${visible} of ${total} members shown.`;
        },
      };
    }
  </script>

  <style>
    .r3-group {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: 16px;
    }
    .r3-chip {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      /* WCAG 2.5.8: keep the 11px visual, but give the tap target 44px. */
      min-height: 44px;
      min-width: 44px;
      padding: 4px 14px;
      font-size: 11px;
      font-weight: 500;
      line-height: 1.5;
      color: #605552;
      background: #ffffff;
      border: 1px solid #d9d3cf;
      border-radius: 9999px;
      cursor: pointer;
      transition:
        background-color 150ms ease,
        border-color 150ms ease,
        color 150ms ease,
        box-shadow 150ms ease;
    }
    .r3-chip:hover {
      background: #f1eceb;
      color: #2a2010;
    }
    .r3-chip:focus-visible {
      outline: 2px solid #697066;
      outline-offset: 2px;
    }
    .r3-chip.is-active {
      font-weight: 600;
    }
    /* The role hue only tints the fill and the border - the label stays bark so
       the chip clears 4.5:1 in both themes. */
    .r3-chip.is-active,
    .r3-role-pill {
      color: #605552;
      background: color-mix(in srgb, var(--role-light) 14%, #ffffff);
      border-color: var(--role-light);
    }
    .r3-chip-all.is-active {
      color: #2a2010;
      background: color-mix(in srgb, #2a2010 14%, #ffffff);
      border-color: #2a2010;
    }
    .r3-role-pill {
      display: inline-flex;
      align-items: center;
      padding: 2px 10px;
      font-size: 12px;
      font-weight: 500;
      border: 1px solid transparent;
      border-radius: 9999px;
    }
    .r3-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 16px;
      height: 16px;
      padding: 0 4px;
      font-size: 10px;
      font-weight: 700;
      line-height: 1;
      color: inherit;
      background: rgb(0 0 0 / 0.08);
      border-radius: 9999px;
      font-variant-numeric: tabular-nums;
    }

    :global([data-theme='dark']) .r3-chip {
      color: #c7c0be;
      background: #2e2421;
      border-color: #3f3632;
    }
    :global([data-theme='dark']) .r3-chip:hover {
      background: #3f3632;
      color: #f1eceb;
    }
    :global([data-theme='dark']) .r3-chip.is-active,
    :global([data-theme='dark']) .r3-role-pill {
      color: #c7c0be;
      background: color-mix(in srgb, var(--role-dark) 14%, #2e2421);
      border-color: var(--role-dark);
    }
    :global([data-theme='dark']) .r3-chip-all.is-active {
      color: #f1eceb;
      background: color-mix(in srgb, #f1eceb 14%, #2e2421);
      border-color: #c7c0be;
    }
    :global([data-theme='dark']) .r3-role-pill {
      border-color: transparent;
    }
    :global([data-theme='dark']) .r3-chip:focus-visible {
      outline-color: #f7860f;
    }
    :global([data-theme='dark']) .r3-count {
      background: rgb(255 255 255 / 0.12);
    }
  </style>
</div>
