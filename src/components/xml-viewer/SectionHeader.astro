---
interface Props {
  title: string;
  trailing?: string;
}

import {
  sectionHeadingClass,
  sectionHeadingTrailingClass,
} from '@/components/xml-viewer/section-heading';

const { title, trailing } = Astro.props;
---

{trailing ? (
  <div class="flex flex-col gap-1 mb-2 @md:flex-row @md:items-baseline @md:justify-between @md:gap-2">
    <h3 class={sectionHeadingClass}>{title}</h3>
    <span class={sectionHeadingTrailingClass}>{trailing}</span>
  </div>
) : (
  <h3 class={`${sectionHeadingClass} mb-2`}>{title}</h3>
)}
