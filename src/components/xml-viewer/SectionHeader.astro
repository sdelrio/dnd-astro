---
interface Props {
  title: string;
  trailing?: string;
}

const { title, trailing } = Astro.props;
const headingClass = 'mt-0 font-semibold text-gray-900 dark:text-gray-100';
---

{trailing ? (
  <div class="flex flex-col gap-1 mb-2 @md:flex-row @md:items-baseline @md:justify-between @md:gap-2">
    <h2 class={headingClass}>{title}</h2>
    <span class="text-xs text-gray-500 dark:text-gray-400">{trailing}</span>
  </div>
) : (
  <h2 class={`${headingClass} mb-2`}>{title}</h2>
)}
