---
import { CharacterData } from '../../utils/parse-character-xml';
import { signed } from '../../utils/format';
import IconifyIcon from '../IconifyIcon.astro';

interface Props {
  character: CharacterData;
  display?: 'small' | 'medium' | 'large';
  image?: string;
}

const { character, display = 'medium', image } = Astro.props;

const {
  name,
  race,
  alignment,
  background,
  deity,
  classes,
  abilities,
  defenses,
  profBonus,
  skills,
  languages,
  feats,
  features,
  powers,
} = character;

const totalLevel = classes.reduce((sum, c) => sum + c.level, 0);
const classString = classes.map((c) => `${c.name} ${c.level}`).join(' / ');
const avatarSrc = image ? `/fg/avatar/${image}` : `/fg/avatar/${name.toLowerCase().replace(/\s+/g, '')}.jpg`;

function getAbilityScore(abilityName: string): number {
  const key = abilityName.toLowerCase().slice(0, 3);
  return abilities[key]?.score ?? 10;
}

function getAbilityBonus(abilityName: string): number {
  const key = abilityName.toLowerCase().slice(0, 3);
  return abilities[key]?.bonus ?? 0;
}

function getAbilitySave(abilityName: string): number {
  const key = abilityName.toLowerCase().slice(0, 3);
  return abilities[key]?.save ?? 0;
}

const abilityNames = ['Strength', 'Dexterity', 'Constitution', 'Intelligence', 'Wisdom', 'Charisma'];
const abilityShort = ['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA'];

const characterJson = JSON.stringify(character).replace(/"/g, '"');
---

<div
  class="xml-card"
  x-data="{
    displayMode: 'display',
    expandedSections: {},
    toggleSection(section) {
      this.expandedSections[section] = !this.expandedSections[section];
    },
    isExpanded(section) {
      return !!this.expandedSections[section];
    }
  }"
  :data-character={characterJson}
  :class="{
    'max-w-[360px]': display === 'small',
    'max-w-[480px]': display === 'medium',
    'max-w-[710px]': display === 'large',
  }"
>
  <style>
    .xml-card {
      @apply bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm overflow-hidden font-sans text-sm;
    }
    .xml-card header {
      @apply bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 p-4;
    }
    .xml-card .card-body {
      @apply p-4 space-y-4;
    }
    .xml-card .section {
      @apply border-t border-gray-100 dark:border-gray-800 pt-4 first:border-t-0 first:pt-0;
    }
    .xml-card .section-title {
      @apply font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2;
    }
    .xml-card .vitals-grid {
      @apply grid grid-cols-4 gap-2 text-center;
    }
    .xml-card .vital-item {
      @apply p-2 bg-gray-50 dark:bg-gray-900 rounded;
    }
    .xml-card .vital-label {
      @apply text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide;
    }
    .xml-card .vital-value {
      @apply text-lg font-bold text-gray-900 dark:text-white;
    }
    .xml-card .abilities-grid {
      @apply grid grid-cols-6 gap-1;
    }
    .xml-card .ability-col {
      @apply text-center p-2 bg-gray-50 dark:bg-gray-900 rounded;
    }
    .xml-card .ability-header {
      @apply text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase;
    }
    .xml-card .ability-score {
      @apply text-xl font-bold text-gray-900 dark:text-white;
    }
    .xml-card .ability-mod {
      @apply text-sm text-gray-600 dark:text-gray-300;
    }
    .xml-card .ability-save {
      @apply text-xs text-gray-500 dark:text-gray-400;
    }
    .xml-card .skills-list {
      @apply grid grid-cols-2 gap-1 sm:grid-cols-3;
    }
    .xml-card .skill-item {
      @apply flex justify-between py-1 px-2 text-sm;
    }
    .xml-card .skill-name {
      @apply text-gray-700 dark:text-gray-300;
    }
    .xml-card .skill-value {
      @apply font-mono font-semibold text-gray-900 dark:text-white;
    }
    .xml-card .languages-list,
    .xml-card .feats-list {
      @apply flex flex-wrap gap-2;
    }
    .xml-card .tag {
      @apply px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-sm text-gray-700 dark:text-gray-300;
    }
    .xml-card .feature-item,
    .xml-card .power-item {
      @apply py-2 border-b border-gray-100 dark:border-gray-800 last:border-b-0;
    }
    .xml-card .feature-header,
    .xml-card .power-header {
      @apply flex items-center justify-between cursor-pointer;
    }
    .xml-card .feature-name,
    .xml-card .power-name {
      @apply font-medium text-gray-900 dark:text-white;
    }
    .xml-card .feature-source,
    .xml-card .power-group {
      @apply text-xs text-gray-500 dark:text-gray-400;
    }
    .xml-card .feature-detail,
    .xml-card .power-detail {
      @apply mt-2 ml-4 text-sm text-gray-600 dark:text-gray-300 hidden;
    }
    .xml-card .feature-detail.open,
    .xml-card .power-detail.open {
      @apply block;
    }
    .xml-card .avatar-container {
      @apply relative w-full aspect-[3/4] overflow-hidden;
    }
    .xml-card .avatar-img {
      @apply w-full h-full object-cover;
    }
    .xml-card .display-toggle {
      @apply absolute top-2 right-2 z-10 flex gap-1 bg-white/90 dark:bg-gray-900/90 backdrop-blur rounded p-1 shadow;
    }
    .xml-card .display-btn {
      @apply px-2 py-1 text-xs rounded transition-colors;
    }
    .xml-card .display-btn.active {
      @apply bg-blue-600 text-white;
    }
    .xml-card .display-btn:not(.active) {
      @apply bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700;
    }
    .xml-card .expand-toggle {
      @apply ml-auto text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors;
    }
    .xml-card .expand-toggle[aria-expanded="true"] {
      @apply rotate-180;
    }
    .xml-card .class-badge {
      @apply inline-flex items-center gap-1 px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 rounded-full text-xs font-medium;
    }
    .xml-card .alignment-badge {
      @apply inline-flex items-center gap-1 px-2 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full text-xs;
    }
  </style>

  <header class="relative">
    {display === 'large' && (
      <div class="avatar-container">
        <img
          class="avatar-img"
          src={avatarSrc}
          alt={`${name} portrait`}
          onerror="this.onerror=null; this.src='/fg/avatar/faceless.svg';"
        />
        <div class="display-toggle" x-show="display === 'large'" x-cloak>
          <button
            class="display-btn"
            :class="{ active: displayMode === 'small' }"
            @click="displayMode = 'small'"
            aria-pressed={displayMode === 'small'}
          >
            Small
          </button>
          <button
            class="display-btn"
            :class="{ active: displayMode === 'medium' }"
            @click="displayMode = 'medium'"
            aria-pressed={displayMode === 'medium'}
          >
            Medium
          </button>
          <button
            class="display-btn"
            :class="{ active: displayMode === 'large' }"
            @click="displayMode = 'large'"
            aria-pressed={displayMode === 'large'}
          >
            Large
          </button>
        </div>
      </div>
    )}

    <div class="flex items-start justify-between gap-4 p-4" style="background: inherit;">
      <div>
        <h1 class="text-xl font-bold text-gray-900 dark:text-white">{name}</h1>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">{race} — {classString} (Level {totalLevel})</p>
        {display !== 'small' && (
          <>
            {alignment && <span class="alignment-badge">{alignment}</span>}
            {background && <span class="alignment-badge mt-1">{background}</span>}
            {deity && <span class="alignment-badge mt-1">{deity}</span>}
          </>
        )}
      </div>
    </div>
  </header>

  <div class="card-body">
    <section class="section">
      <h2 class="section-title">Vitals</h2>
      <div class="vitals-grid">
        <div class="vital-item">
          <div class="vital-label">AC</div>
          <div class="vital-value">{defenses.ac}</div>
        </div>
        <div class="vital-item">
          <div class="vital-label">HP</div>
          <div class="vital-value">{defenses.hp}</div>
        </div>
        <div class="vital-item">
          <div class="vital-label">Speed</div>
          <div class="vital-value">{defenses.speed} ft</div>
        </div>
        <div class="vital-item">
          <div class="vital-label">Init</div>
          <div class="vital-value">{signed(defenses.initiative)}</div>
        </div>
      </div>
      {display !== 'small' && (
        <div class="mt-3 flex items-center gap-4 text-sm">
          <span class="font-medium text-gray-700 dark:text-gray-300">Proficiency Bonus: {signed(profBonus)}</span>
        </div>
      )}
    </section>

    <section class="section" x-show="displayMode !== 'small' || display === 'small'" x-cloak>
      <h2 class="section-title flex items-center justify-between">
        Abilities
        <button
          class="expand-toggle"
          @click="toggleSection('abilities')"
          :aria-expanded="isExpanded('abilities')"
          aria-label="Toggle abilities"
        >
          <IconifyIcon icon="game-icons:expansion" width="1em" />
        </button>
      </h2>
      <div class="abilities-grid" :class="{ 'hidden': !isExpanded('abilities') && display !== 'small' }" x-show="isExpanded('abilities') || display === 'small'" x-transition>
        {abilityNames.map((ability, i) => (
          <div class="ability-col">
            <div class="ability-header">{abilityShort[i]}</div>
            <div class="ability-score">{getAbilityScore(ability)}</div>
            <div class="ability-mod">{signed(getAbilityBonus(ability))}</div>
            <div class="ability-save">Save: {signed(getAbilitySave(ability))}</div>
          </div>
        ))}
      </div>
    </section>

    {display !== 'small' && (
      <section class="section">
        <h2 class="section-title flex items-center justify-between">
          Saving Throws
          <button
            class="expand-toggle"
            @click="toggleSection('saves')"
            :aria-expanded="isExpanded('saves')"
            aria-label="Toggle saving throws"
          >
            <IconifyIcon icon="game-icons:expansion" width="1em" />
          </button>
        </h2>
        <div class="skills-list" :class="{ 'hidden': !isExpanded('saves') }" x-show="isExpanded('saves')" x-transition>
          {abilityNames.map((ability) => (
            <div class="skill-item">
              <span class="skill-name">{ability}</span>
              <span class="skill-value">{signed(getAbilitySave(ability))}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {display !== 'small' && skills.length > 0 && (
      <section class="section">
        <h2 class="section-title flex items-center justify-between">
          Skills
          <button
            class="expand-toggle"
            @click="toggleSection('skills')"
            :aria-expanded="isExpanded('skills')"
            aria-label="Toggle skills"
          >
            <IconifyIcon icon="game-icons:expansion" width="1em" />
          </button>
        </h2>
        <div class="skills-list" :class="{ 'hidden': !isExpanded('skills') }" x-show="isExpanded('skills')" x-transition>
          {skills.map((skill) => (
            <div class="skill-item">
              <span class="skill-name">{skill.name}</span>
              <span class="skill-value">{signed(skill.value)}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {display !== 'small' && languages.length > 0 && (
      <section class="section">
        <h2 class="section-title flex items-center justify-between">
          Languages
          <button
            class="expand-toggle"
            @click="toggleSection('languages')"
            :aria-expanded="isExpanded('languages')"
            aria-label="Toggle languages"
          >
            <IconifyIcon icon="game-icons:expansion" width="1em" />
          </button>
        </h2>
        <div class="languages-list" :class="{ 'hidden': !isExpanded('languages') }" x-show="isExpanded('languages')" x-transition>
          {languages.map((lang) => (
            <span class="tag">{lang}</span>
          ))}
        </div>
      </section>
    )}

    {display === 'large' && feats.length > 0 && (
      <section class="section">
        <h2 class="section-title flex items-center justify-between">
          Feats
          <button
            class="expand-toggle"
            @click="toggleSection('feats')"
            :aria-expanded="isExpanded('feats')"
            aria-label="Toggle feats"
          >
            <IconifyIcon icon="game-icons:expansion" width="1em" />
          </button>
        </h2>
        <div class="feats-list" :class="{ 'hidden': !isExpanded('feats') }" x-show="isExpanded('feats')" x-transition>
          {feats.map((feat) => (
            <span class="tag">{feat}</span>
          ))}
        </div>
      </section>
    )}

    {display === 'large' && features.length > 0 && (
      <section class="section">
        <h2 class="section-title flex items-center justify-between">
          Features
          <button
            class="expand-toggle"
            @click="toggleSection('features')"
            :aria-expanded="isExpanded('features')"
            aria-label="Toggle features"
          >
            <IconifyIcon icon="game-icons:expansion" width="1em" />
          </button>
        </h2>
        <div :class="{ 'hidden': !isExpanded('features') }" x-show="isExpanded('features')" x-transition>
          {features
            .sort((a, b) => a.level - b.level)
            .map((feature) => (
              <div class="feature-item">
                <div class="feature-header" @click="toggleSection(`feature-${feature.name}`)">
                  <span class="feature-name">{feature.name}</span>
                  <span class="feature-source">Level {feature.level} — {feature.source}</span>
                  <IconifyIcon icon="game-icons:expansion" width="1em" class="expand-toggle" />
                </div>
                <div class="feature-detail" :class="{ open: isExpanded(`feature-${feature.name}`) }" x-show="isExpanded(`feature-${feature.name}`)" x-transition>
                  <p>Source: {feature.source}</p>
                  <p>Gained at level {feature.level}</p>
                </div>
              </div>
            ))}
        </div>
      </section>
    )}

    {display === 'large' && powers.length > 0 && (
      <section class="section">
        <h2 class="section-title flex items-center justify-between">
          Powers
          <button
            class="expand-toggle"
            @click="toggleSection('powers')"
            :aria-expanded="isExpanded('powers')"
            aria-label="Toggle powers"
          >
            <IconifyIcon icon="game-icons:expansion" width="1em" />
          </button>
        </h2>
        <div :class="{ 'hidden': !isExpanded('powers') }" x-show="isExpanded('powers')" x-transition>
          {powers
            .sort((a, b) => a.level - b.level || a.group.localeCompare(b.group))
            .map((power) => (
              <div class="power-item">
                <div class="power-header" @click="toggleSection(`power-${power.name}`)">
                  <span class="power-name">{power.name}</span>
                  <span class="power-group">Level {power.level} — {power.group}</span>
                  <IconifyIcon icon="game-icons:expansion" width="1em" class="expand-toggle" />
                </div>
                <div class="power-detail" :class="{ open: isExpanded(`power-${power.name}`) }" x-show="isExpanded(`power-${power.name}`)" x-transition>
                  <p>Level: {power.level}</p>
                  <p>Group: {power.group}</p>
                </div>
              </div>
            ))}
        </div>
      </section>
    )}
  </div>

  <script is:inline>
    // Initialize Alpine.js component state
    document.addEventListener('alpine:init', () => {
      Alpine.data('xmlCard', () => ({
        displayMode: 'large',
        expandedSections: {},
        toggleSection(section) {
          this.expandedSections[section] = !this.expandedSections[section];
        },
        isExpanded(section) {
          return !!this.expandedSections[section];
        },
      }));
    });
  </script>
</div>