---
import type { CharacterData } from '@/utils/parse-character-xml';
import { resolveAvatarPath } from '@/utils/avatar-path';
import { signed } from '@/utils/format';
import { groupBy } from '@/utils/group-by';
import { toWeaponRows } from '@/components/xml-viewer/weapon-display';
import {
  toInventoryRows,
  carriedWeight,
  carryCapacity,
  toCoinRows,
  hasInventoryContents,
} from '@/components/xml-viewer/inventory-display';
import { skillRank, type SkillRank } from '@/components/xml-viewer/skill-display';
import SectionHeader from '@/components/xml-viewer/SectionHeader.astro';
import CompactAbilityGrid from '@/components/xml-viewer/CompactAbilityGrid.astro';

interface Props {
  character: CharacterData;
  display?: 'small' | 'medium' | 'large';
  image?: string;
  link?: boolean;
}

const { character, display = 'medium', image, link = true } = Astro.props;

// --- Display-mode rank policy -----------------------------------------------
// Each section declares the minimum display mode required to appear.
// Rank order: small=0, medium=1, large=2.
// canShow() is the single build-time source of truth for which sections render.
const RANKS: Record<string, number> = { small: 0, medium: 1, large: 2 };
function rank(mode: string): number {
  return RANKS[mode] ?? 0;
}
const sectionPolicy = {
  avatar: 'small' as const,
  tags: 'small' as const,
  profBonus: 'small' as const,
  saves: 'medium' as const,
  allSaves: 'large' as const,
  skills: 'medium' as const,
  allSkills: 'large' as const,
  passives: 'large' as const,
  languages: 'medium' as const,
  feats: 'large' as const,
  weapons: 'large' as const,
  inventory: 'large' as const,
  features: 'large' as const,
  powers: 'large' as const,
} as const;
type SectionKey = keyof typeof sectionPolicy;
function canShow(section: SectionKey): boolean {
  return rank(display) >= rank(sectionPolicy[section]);
}

const {
  name,
  race,
  alignment,
  background,
  deity,
  classes,
  abilities,
  ac,
  hp,
  tempHp,
  speed,
  initiative,
  profBonus,
  skills,
  allSkills,
  passives,
  languages,
  feats,
  weapons,
  features,
  powers,
  inventory,
  coins,
} = character;

const classString = classes.map((c) => `${c.name} ${c.level}`).join(' / ');
const subclassString = classes.filter((c) => c.subclass).map((c) => c.subclass).join(' / ');
const vitalsItemClass = 'p-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 border-t-[3px] border-t-[#58180d] dark:border-t-[#c68000] rounded-[7px]';
// Section labels were absolutely-positioned tabs at `opacity-0` that only
// appeared on hover. That hid them from keyboard focus entirely and from touch
// users completely, while `title` on the sibling dots gave no text alternative.
// They are now real, always-visible headings in normal flow: a compact
// uppercase micro-label on the gold rule, so the section is legible without a
// pointer and reaches the document outline.
const sectionHeadingClass =
  'mt-0 mb-2 font-semibold text-[0.7rem] uppercase tracking-[0.08em] text-(color:--sl-color-accent-high)';

// Build-time avatar resolution happens in the shared helper: an explicit
// image prop wins when the file exists (missing files fall back to
// faceless.svg), otherwise the pre-resolved build-pipeline path, otherwise a
// {base}.jpg -> {base}.png -> faceless.svg probe, where base is the XML
// filename when known (golden-forest convention: milo.xml -> milo.jpg) and the
// name slug otherwise. Frontmatter runs at build time, so this costs zero
// client JavaScript.
const avatarSrc = resolveAvatarPath({
  explicit: image,
  storedPath: character.avatarPath,
  slug: character.filename ?? name.toLowerCase().replace(/\s+/g, ''),
});

interface AbilityView {
  score: number;
  bonus: number;
  save: number;
  saveprof: number;
}

const abilityNames = ['Strength', 'Dexterity', 'Constitution', 'Intelligence', 'Wisdom', 'Charisma'];
const abilityShort = ['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA'];
const abilityEntries = abilityNames.map((name, i) => ({ name, short: abilityShort[i] }));

function lookupAbility(fullName: string): AbilityView {
  return (
    abilities[fullName.toLowerCase()] ?? { score: 10, bonus: 0, save: 0, saveprof: 0 }
  );
}

const proficientSaves = abilityNames.filter((a) => lookupAbility(a).saveprof > 0);
const showSaves = canShow('saves') && (proficientSaves.length > 0 || canShow('allSaves'));

interface SaveRow {
  short: string;
  save: number;
  saveprof: number;
}
const saveColumns: SaveRow[][] = [abilityEntries.slice(0, 3), abilityEntries.slice(3)].map(
  (column) =>
    column.map(({ name, short }) => {
      const { save, saveprof } = lookupAbility(name);
      return { short, save, saveprof };
    })
);

const sortedFeatures = [...features].sort(
  (a, b) => a.level - b.level || a.name.localeCompare(b.name)
);
const featuresByLevel = groupBy(sortedFeatures, (f) => f.level).map((g) => ({
  level: g.key,
  items: g.items,
}));

const sortedAllSkills = [...allSkills].sort((a, b) => a.name.localeCompare(b.name));
const skillHalf = Math.ceil(sortedAllSkills.length / 2);
const skillColumns = [
  sortedAllSkills.slice(0, skillHalf),
  sortedAllSkills.slice(skillHalf),
];
function abilityAbbr(stat: string): string {
  return stat ? stat.slice(0, 3).toUpperCase() : '';
}

const SKILL_RANK_LABEL: Record<Exclude<SkillRank, 'none'>, string> = {
  proficient: 'Proficient',
  expertise: 'Expertise',
  half: 'Half proficiency',
};
const hasSkillMarks = sortedAllSkills.some((skill) => skillRank(skill.prof) !== 'none');

const weaponRows = toWeaponRows(weapons, abilities, profBonus);

const inventoryRows = toInventoryRows(inventory);
const inventoryWeight = carriedWeight(inventory);
const inventoryCapacity = carryCapacity(lookupAbility('Strength').score);
const coinRows = toCoinRows(coins);
const hasInventory = hasInventoryContents(inventory, coins);

const sortedPowers = [...powers].sort(
  (a, b) =>
    a.level - b.level || a.group.localeCompare(b.group) || a.name.localeCompare(b.name)
);
const powersByLevel = groupBy(sortedPowers, (p) => p.level).map((lg) => ({
  level: lg.key,
  groups: groupBy(lg.items, (p) => p.group || 'Other').map((gg) => ({
    name: gg.key,
    items: gg.items,
  })),
}));

function isSpellGroup(group: string): boolean {
  return /spell|cantrip/i.test(group);
}
type PowerMark = 'always' | 'prepared' | null;
function powerMark(power: { group: string; prepared: number; preparedDomain: number }): PowerMark {
  if (!isSpellGroup(power.group)) return null;
  if (power.preparedDomain > 0) return 'always';
  if (power.prepared > 0) return 'prepared';
  return null;
}
const hasPowerMarks = sortedPowers.some((p) => powerMark(p) !== null);

const showSkills = canShow('skills') && skills.length > 0;
const showLanguages = canShow('languages') && languages.length > 0;
const showFeats = canShow('feats') && feats.length > 0;
const showWeapons = canShow('weapons') && weaponRows.length > 0;
const showInventory = canShow('inventory') && hasInventory;
const showFeatures = canShow('features') && featuresByLevel.length > 0;
const showPowers = canShow('powers') && powersByLevel.length > 0;

const SAVES_SPLIT_MAX_LANGUAGES = 6;
const SAVES_SPLIT_MAX_FEATS = 4;

const splitSavesGroup =
  showSaves &&
  (showLanguages || showFeats) &&
  (showLanguages ? languages.length : 0) <= SAVES_SPLIT_MAX_LANGUAGES &&
  (showFeats ? feats.length : 0) <= SAVES_SPLIT_MAX_FEATS;
---

<div
  class="not-content @container w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm overflow-hidden font-sans text-sm"
>
  <header class="char-header">
    {character.filename && link ? (
      <a href={`/fantasy-grounds/characters/${character.filename}`} aria-label={`View ${name} character sheet`} class="char-portrait-link">
        <img class="char-portrait" src={avatarSrc} alt={`${name} portrait`} title={name} />
      </a>
    ) : (
      <img class="char-portrait" src={avatarSrc} alt={`${name} portrait`} title={name} />
    )}
    <div class="char-id">
      <h2 class="char-name" title={`${name} - HP: ${hp}${tempHp ? ` (Temp: ${tempHp})` : ''}`}>{name}</h2>
      <p class="char-meta">
        {race} - {classString}
        {subclassString && display === 'large' && (<span> ({subclassString})</span>)}
      </p>
      {canShow('tags') && (
        <p class="char-tags">
          {alignment && display !== 'small' && (<span class="char-pill">{alignment}</span>)}
          {background && (<span class="char-pill">{background}</span>)}
          {deity && display !== 'small' && (<span class="char-pill">{deity}</span>)}
        </p>
      )}
    </div>
    <div class="char-hp" title={`Hit Points: ${hp}${tempHp ? ` (Temp: ${tempHp})` : ''}`}>
      <span class="char-hp-label">Hit Points</span>
      <span class="char-hp-value">{hp}</span>
      {tempHp > 0 && <span class="char-hp-temp">+{tempHp} temp</span>}
    </div>
  </header>

  <div class="p-4 space-y-4">
    <div class={(showSaves || showLanguages || showFeats) ? 'grid grid-cols-1 @6xl:grid-cols-2 gap-4' : 'space-y-4'}>
      <section class="relative group/overview">
        {display === 'large' && <h3 class={sectionHeadingClass}>Overview</h3>}
        <div class="space-y-2">
          <section class="relative group">
            <h3 class={sectionHeadingClass}>Vitals</h3>
            <div class="grid grid-cols-4 gap-2 text-center">
              <div class={vitalsItemClass}>
                <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">AC</div>
                <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{ac}</div>
              </div>
              <div class={vitalsItemClass}>
                <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Speed</div>
                <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{speed}{display !== 'small' && ' ft'}</div>
              </div>
              <div class={vitalsItemClass}>
                <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Init</div>
                <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{signed(initiative)}</div>
              </div>
              {canShow('profBonus') && (
                <div class={vitalsItemClass}>
                  <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Prof</div>
                  <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{signed(profBonus)}</div>
                </div>
              )}
            </div>
          </section>

          <section>
            <h3 class={sectionHeadingClass}>Abilities</h3>
            {display === 'small' ? (
              <CompactAbilityGrid abilities={abilities} entries={abilityEntries} />
            ) : (
              <>
                <div
                  class="grid grid-cols-3 @lg:grid-cols-6 gap-1"
                >
                  {abilityNames.map((abilityName, i) => (
                    <div class="text-center p-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 border-t-[3px] border-t-[#58180d] dark:border-t-[#c68000] [border-top-left-radius:45%] [border-top-right-radius:45%] [border-bottom-left-radius:8px] [border-bottom-right-radius:8px]">
                      <div class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">{abilityShort[i]}</div>
                      <div class="text-xl font-bold text-gray-900 dark:text-gray-100">{signed(lookupAbility(abilityName).bonus)}</div>
                      <div class="text-sm text-gray-600 dark:text-gray-400">{lookupAbility(abilityName).score}</div>
                      <div class="text-xs text-gray-500 dark:text-gray-400">SAVE {signed(lookupAbility(abilityName).save)}</div>
                    </div>
                  ))}
                </div>

              </>
            )}
          </section>

          {canShow('passives') && (
            <section class="relative group">
              <h3 class={sectionHeadingClass}>Passive Skills</h3>
              <div class="grid grid-cols-3 gap-2 text-center">
                <div class={`${vitalsItemClass} flex flex-col items-center text-center gap-1 @md:flex-row @md:items-baseline @md:justify-between @md:gap-2`}>
                  <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Passive Perception</div>
                  <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{passives.perception}</div>
                </div>
                <div class={`${vitalsItemClass} flex flex-col items-center text-center gap-1 @md:flex-row @md:items-baseline @md:justify-between @md:gap-2`}>
                  <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Passive Investigation</div>
                  <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{passives.investigation}</div>
                </div>
                <div class={`${vitalsItemClass} flex flex-col items-center text-center gap-1 @md:flex-row @md:items-baseline @md:justify-between @md:gap-2`}>
                  <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Passive Insight</div>
                  <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{passives.insight}</div>
                </div>
              </div>
            </section>
          )}
        </div>
      </section>

      {(showSaves || showLanguages || showFeats) && (
        <div class={`grid grid-cols-1 gap-2${splitSavesGroup ? ' @7xl:grid-cols-2 @7xl:gap-4' : ''}`}>
          {showSaves && (
            <section class="@container relative group">
              <h3 class={sectionHeadingClass}>Saving Throws</h3>
              {!canShow('allSaves') && (
                <div class="grid grid-cols-2 gap-1 sm:grid-cols-3">
                  {proficientSaves.map((abilityName) => (
                    <div class="flex justify-between py-1 px-2 text-sm">
                      <span class="text-gray-700 dark:text-gray-300">{abilityName}</span>
                      <span class="font-mono font-semibold text-gray-900 dark:text-gray-100">{signed(lookupAbility(abilityName).save)}</span>
                    </div>
                  ))}
                </div>
              )}
              {canShow('allSaves') && (
                <div class={vitalsItemClass}>
                  <div class="grid grid-cols-1 @lg:grid-cols-2 gap-2">
                    {saveColumns.map((column) => (
                      <table class="w-full text-sm">
                        <thead>
                          <tr class="text-[10px] uppercase tracking-wide text-gray-500 dark:text-gray-400">
                            <th class="text-left font-medium pb-1">Ability</th>
                            <th class="text-right font-medium pb-1">Save</th>
                          </tr>
                        </thead>
                        <tbody>
                          {column.map((row) => (
                            <tr class="border-t border-gray-200 dark:border-gray-700">
                              <td class="py-1 text-gray-700 dark:text-gray-300">
                                <span class="inline-flex items-center gap-1">
                                  <span>{row.short}</span>
                                  {row.saveprof > 0 && (
                                    <>
                                      <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
                                      <span class="sr-only">Proficient</span>
                                    </>
                                  )}
                                </span>
                              </td>
                              <td class="py-1 text-right font-mono font-semibold text-gray-900 dark:text-gray-100">{signed(row.save)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    ))}
                  </div>
                </div>
              )}
            </section>
          )}

          {(showLanguages || showFeats) && (
            <div class="space-y-2">
              {showLanguages && (
                <section>
                  <div class={`${vitalsItemClass} flex flex-col gap-2 @md:flex-row @md:items-center @md:justify-between @md:gap-2`}>
                    <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Languages</div>
                    <div class="flex flex-wrap gap-2">
                      {languages.map((lang) => (
                        <span class="px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded text-sm text-gray-700 dark:text-gray-300">{lang}</span>
                      ))}
                    </div>
                  </div>
                </section>
              )}

              {showFeats && (
                <section>
                  <div class={`${vitalsItemClass} flex flex-col gap-2 @md:flex-row @md:items-center @md:justify-between @md:gap-2`}>
                    <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Feats</div>
                    <div class="flex flex-wrap gap-2">
                      {feats.map((feat) => (
                        <span class="px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded text-sm text-gray-700 dark:text-gray-300">{feat}</span>
                      ))}
                    </div>
                  </div>
                </section>
              )}
            </div>
          )}
        </div>
      )}
    </div>

    {(showSkills || showInventory) && (
      <div class={showSkills && showInventory ? 'grid grid-cols-1 @6xl:grid-cols-2 gap-4' : 'space-y-4'}>
        {showSkills && (
          <section class="border-t border-gray-100 dark:border-gray-700 pt-4 @6xl:border-t-0 @6xl:pt-0">
            <SectionHeader title="Skills" />
            {!canShow('allSkills') && (
              <div class="grid grid-cols-2 gap-1 sm:grid-cols-3">
                {skills.map((skill) => (
                  <div class="flex justify-between py-1 px-2 text-sm">
                    <span class="text-gray-700 dark:text-gray-300">{skill.name}</span>
                    <span class="font-mono font-semibold text-gray-900 dark:text-gray-100">{signed(skill.total)}</span>
                  </div>
                ))}
              </div>
            )}
            {canShow('allSkills') && (
              <div class={vitalsItemClass}>
                <div class="grid grid-cols-1 @lg:grid-cols-2 gap-2">
                  {skillColumns.map((column) => (
                    <table class="w-full text-sm">
                      <thead>
                        <tr class="text-[10px] uppercase tracking-wide text-gray-500 dark:text-gray-400">
                          <th class="text-left font-medium pb-1">Skill</th>
                          <th class="text-left font-medium pb-1">Abil</th>
                          <th class="text-right font-medium pb-1">Total</th>
                        </tr>
                      </thead>
                      <tbody>
                        {column.map((skill) => {
                          const rank = skillRank(skill.prof);
                          return (
                            <tr class="border-t border-gray-200 dark:border-gray-700">
                              <td class="py-1 text-gray-700 dark:text-gray-300">
                                <span class="inline-flex items-center gap-1">
                                  <span class="truncate">{skill.name}</span>
                                  {rank !== 'none' && (
                                    <span
                                      class="inline-flex items-center gap-px"
                                      data-prof-rank={rank}
                                    >
                                      <span class="sr-only">{SKILL_RANK_LABEL[rank]}</span>
                                      {rank === 'proficient' && (
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
                                      )}
                                      {rank === 'expertise' && (
                                        <>
                                          <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
                                          <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
                                        </>
                                      )}
                                      {rank === 'half' && (
                                        <span class="w-1.5 h-1.5 overflow-hidden rounded-full border border-[#c68000]" aria-hidden="true">
                                          <span class="block w-1/2 h-full bg-[#c68000]"></span>
                                        </span>
                                      )}
                                    </span>
                                  )}
                                </span>
                              </td>
                              <td class="py-1 text-gray-500 dark:text-gray-400">{abilityAbbr(skill.stat)}</td>
                              <td class="py-1 text-right font-mono font-semibold text-gray-900 dark:text-gray-100">{signed(skill.total)}</td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  ))}
                </div>
                {hasSkillMarks && (
                  <div class="mt-3 pt-2 border-t border-gray-100 dark:border-gray-700 flex flex-wrap gap-4 text-xs text-gray-500 dark:text-gray-400">
                    <span class="inline-flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
                      Proficient
                    </span>
                    <span class="inline-flex items-center gap-1">
                      <span class="inline-flex items-center gap-px" aria-hidden="true">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
                        <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
                      </span>
                      Expertise
                    </span>
                    <span class="inline-flex items-center gap-1">
                      <span class="w-1.5 h-1.5 overflow-hidden rounded-full border border-[#c68000]" aria-hidden="true">
                        <span class="block w-1/2 h-full bg-[#c68000]"></span>
                      </span>
                      Half proficiency
                    </span>
                  </div>
                )}
              </div>
            )}
          </section>
        )}

        {showInventory && (
          <section class="border-t border-gray-100 dark:border-gray-700 pt-4 @6xl:border-t-0 @6xl:pt-0">
            <SectionHeader
              title="Inventory"
              trailing={inventoryRows.length > 0
                ? `${inventoryWeight} / ${inventoryCapacity} lb. carried`
                : undefined}
            />
            {inventoryRows.length > 0 && (
              <div class={vitalsItemClass}>
                <table class="w-full text-sm">
                  <thead>
                    <tr class="text-[10px] uppercase tracking-wide text-gray-500 dark:text-gray-400">
                      <th class="text-left font-medium pb-1">Item</th>
                      <th class="text-right font-medium pb-1">Count</th>
                      <th class="text-right font-medium pb-1">Weight</th>
                      <th class="text-left font-medium pb-1">State</th>
                    </tr>
                  </thead>
                  <tbody>
                    {inventoryRows.map((item) => (
                      <tr class="border-t border-gray-200 dark:border-gray-700">
                        <td class="py-1 text-gray-700 dark:text-gray-300">{item.name}</td>
                        <td class="py-1 text-right text-gray-700 dark:text-gray-300">{item.count}</td>
                        <td class="py-1 text-right text-gray-700 dark:text-gray-300">{item.weight}</td>
                        <td class="py-1 text-gray-500 dark:text-gray-400">{item.state}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            <div class={`mt-2 ${vitalsItemClass}`}>
              <div class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">Current Wealth</div>
              <div class="grid grid-cols-5 gap-1 text-center">
                {coinRows.map((coin) => (
                  <div>
                    <div class="text-[10px] uppercase tracking-wide text-gray-500 dark:text-gray-400">{coin.label}</div>
                    <div class="text-sm font-semibold text-gray-900 dark:text-gray-100">{coin.value}</div>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )}
      </div>
    )}

    {showWeapons && (
      <section class="border-t border-gray-100 dark:border-gray-700 pt-4 @6xl:border-t-0 @6xl:pt-0">
        <SectionHeader title="Equipped Weapons" />
        <div class={vitalsItemClass}>
          <table class="w-full text-sm">
            <thead>
              <tr class="text-[10px] uppercase tracking-wide text-gray-500 dark:text-gray-400">
                <th class="text-left font-medium pb-1">ATK</th>
                <th class="text-left font-medium pb-1">Weapon</th>
                <th class="text-left font-medium pb-1">Properties</th>
                <th class="text-right font-medium pb-1">Damage</th>
              </tr>
            </thead>
            <tbody>
              {weaponRows.map((weapon) => (
                <tr class="border-t border-gray-200 dark:border-gray-700">
                  <td class="py-1 font-mono font-semibold text-gray-900 dark:text-gray-100">{weapon.attack}</td>
                  <td class="py-1 text-gray-700 dark:text-gray-300">{weapon.name}</td>
                  <td class="py-1 text-gray-500 dark:text-gray-400">{weapon.properties}</td>
                  <td class="py-1 text-right text-gray-700 dark:text-gray-300">{weapon.damage}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {(showFeatures || showPowers) && (
      <div class={showFeatures && showPowers ? 'grid grid-cols-1 @6xl:grid-cols-2 gap-4' : 'space-y-4'}>
        {showFeatures && (
          <section class="border-t border-gray-100 dark:border-gray-700 pt-4 @6xl:border-t-0 @6xl:pt-0">
            <SectionHeader title="Features" />
            <div class={vitalsItemClass}>
              {featuresByLevel.map((group) => (
                <div>
                  <h4 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mt-3 mb-1">
                    Level {group.level}
                  </h4>
                  <div class="flex flex-wrap gap-2">
                    {group.items.map((feature) => (
                      <span
                        class="px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded text-sm text-gray-700 dark:text-gray-300"
                        title={feature.source ? `Source: ${feature.source}` : undefined}
                      >{feature.name}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {showPowers && (
          <section class="border-t border-gray-100 dark:border-gray-700 pt-4 @6xl:border-t-0 @6xl:pt-0">
            <SectionHeader title="Powers" />
            <div class={vitalsItemClass}>
              {powersByLevel.map((levelGroup) => (
                <div>
                  <h4 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mt-3 mb-1">
                    Level {levelGroup.level}
                  </h4>
                  {levelGroup.groups.map((group) => (
                    <div>
                      <h5 class="text-xs font-medium text-gray-500 dark:text-gray-400 mt-2 mb-1">
                        {group.name}
                      </h5>
                      <div class="flex flex-wrap gap-2">
                        {group.items.map((power) => {
                          const mark = powerMark(power);
                          return (
                            <span
                              class="px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded text-sm text-gray-700 dark:text-gray-300 inline-flex items-center gap-1"
                              title={power.group ? `Group: ${power.group}` : undefined}
                            >
                              {power.name}
                              {mark === 'always' && (
                                <>
                                  <span class="w-1.5 h-1.5 rounded-full border border-[#c68000]" aria-hidden="true"></span>
                                  <span class="sr-only">Always prepared (class/subclass)</span>
                                </>
                              )}
                              {mark === 'prepared' && (
                                <>
                                  <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
                                  <span class="sr-only">Prepared</span>
                                </>
                              )}
                            </span>
                          );
                        })}
                      </div>
                    </div>
                  ))}
                </div>
              ))}
              {hasPowerMarks && (
                <div class="mt-3 pt-2 border-t border-gray-100 dark:border-gray-700 flex flex-wrap gap-4 text-xs text-gray-500 dark:text-gray-400">
                  <span class="inline-flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
                    Prepared
                  </span>
                  <span class="inline-flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full border border-[#c68000]" aria-hidden="true"></span>
                    Always prepared (class/subclass)
                  </span>
                </div>
              )}
            </div>
          </section>
        )}
      </div>
    )}
  </div>
</div>

