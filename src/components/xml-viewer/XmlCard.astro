---
import type { CharacterData } from '@/utils/parse-character-xml';
import { resolveAvatarPath } from '@/utils/avatar-path';
import { signed } from '@/utils/format';
import { groupBy } from '@/utils/group-by';
import { toWeaponRows } from '@/components/xml-viewer/weapon-display';
import {
  toInventoryRows,
  carriedWeight,
  carryCapacity,
  toCoinRows,
  hasInventoryContents,
} from '@/components/xml-viewer/inventory-display';
import { skillRank } from '@/components/xml-viewer/skill-display';
import { cardPlateClass } from '@/components/xml-viewer/card-plate';
import {
  proficiencyCoinClass,
  proficiencyMarkLabel,
} from '@/components/xml-viewer/proficiency-mark';
import SkillsTable from '@/components/xml-viewer/SkillsTable.astro';
import SavesTable, { type SaveTableRow } from '@/components/xml-viewer/SavesTable.astro';

import {
  sectionHeadingClass,
  sectionHeadingTrailingClass,
  sectionSubheadingClass,
  sectionGroupClass,
  sectionLegendClass,
} from '@/components/xml-viewer/section-heading';
import WeaponsTable from '@/components/xml-viewer/WeaponsTable.astro';
import CompactAbilityGrid from '@/components/xml-viewer/CompactAbilityGrid.astro';
import LanguagesFeats from '@/components/xml-viewer/LanguagesFeats.astro';
import { CARD_TABS, type CardTabId } from '@/components/xml-viewer/card-tabs';

interface Props {
  character: CharacterData;
  display?: 'small' | 'medium' | 'large';
  image?: string;
  link?: boolean;
}

const { character, display = 'medium', image, link = true } = Astro.props;

// --- Display-mode rank policy -----------------------------------------------
// Each section declares the minimum display mode required to appear.
// Rank order: small=0, medium=1, large=2.
// canShow() is the single build-time source of truth for which sections render.
const RANKS: Record<string, number> = { small: 0, medium: 1, large: 2 };
function rank(mode: string): number {
  return RANKS[mode] ?? 0;
}
// Display mode decides which sections exist and which panel holds them
// (ADR-0017). Each entry below is the minimum display mode required for that
// section to appear, read at three ranks: small renders identity, avatar and
// tags and nothing that needs a panel to hold it; medium adds the recognition
// material a roster card is for, which is Skills, Languages, Feats and the
// passive scores, and not Saving Throws; large adds Saving Throws back and adds
// nothing of its own. `canShow()` is the single build-time source of truth for
// which sections render.
//
// Two of these entries are row-set reductions rather than section-existence
// decisions, and they are the ones a mode still *shortens* rather than drops.
// `allSkills` is large-only, so a medium card lists the proficient skills where a
// large one lists all of them. `allSaves` keeps the saves table on the same shape
// as the skills one; no mode currently narrows it, because Saving Throws is
// large-only and large lists all six, and it is here so that a mode which did
// would not need a second mechanism.
//
// The four sections promoted to medium before the menu existed (`weapons`,
// `inventory`, `features`, `powers`) were large-only then. Promoting them is what
// makes the roster card complete rather than a truncated large card, which is
// the whole reason the menu is there: a bar over sections a mode cannot see would
// be a bar with three dead entries. ADR-0016 carries that reasoning; ADR-0017
// replaces its rule that a display mode never decides whether a section exists.
//
// `passives` was promoted on the same reasoning later: it already renders inside
// the Overview panel and already owns its three plates, so it costs a medium card
// nothing that is not already on the page. The passive scores are a recognition
// fact about a character - whether the party notices things - rather than a number
// the reader computes with, which is what medium is for.
const sectionPolicy = {
  avatar: 'small' as const,
  tags: 'small' as const,
  profBonus: 'small' as const,
  saves: 'large' as const,
  allSaves: 'large' as const,
  skills: 'medium' as const,
  allSkills: 'large' as const,
  passives: 'medium' as const,
  languages: 'medium' as const,
  feats: 'medium' as const,
  weapons: 'medium' as const,
  inventory: 'medium' as const,
  features: 'medium' as const,
  powers: 'medium' as const,
} as const;
type SectionKey = keyof typeof sectionPolicy;
function canShow(section: SectionKey): boolean {
  return rank(display) >= rank(sectionPolicy[section]);
}

const {
  name,
  race,
  alignment,
  background,
  deity,
  classes,
  abilities,
  ac,
  hp,
  tempHp,
  speed,
  initiative,
  profBonus,
  allSkills,
  passives,
  languages,
  feats,
  weapons,
  features,
  powers,
  inventory,
  coins,
} = character;

const classString = classes.map((c) => `${c.name} ${c.level}`).join(' / ');
const subclassString = classes.filter((c) => c.subclass).map((c) => c.subclass).join(' / ');
// Section labels were once absolutely-positioned tabs at `opacity-0` that only
// appeared on hover, which hid them from keyboard focus and touch alike. They are
// real, always-visible headings now, and every one of them is the same class, so
// the card reads as a single heading system. See section-heading.ts.
//
// Only the sections that live inside a panel carry one. The six panels
// themselves are named by their tab, so an `h3` repeating that word twenty
// pixels below the tab would be a second copy of it, and a screen reader would
// read the same name twice. Languages and Feats are the one pair that names
// itself at both modes, and for the reason given at their component: neither of
// the panels holding them has a heading to be subordinate to, so there is no
// level above them to derive from and `h3` is correct in both places.

// Build-time avatar resolution happens in the shared helper: an explicit
// image prop wins when the file exists (missing files fall back to
// faceless.svg), otherwise the pre-resolved build-pipeline path, otherwise a
// {base}.jpg -> {base}.png -> faceless.svg probe, where base is the XML
// filename when known (golden-forest convention: milo.xml -> milo.jpg) and the
// name slug otherwise. Frontmatter runs at build time, so this costs zero
// client JavaScript.
const avatarSrc = resolveAvatarPath({
  explicit: image,
  storedPath: character.avatarPath,
  slug: character.filename ?? name.toLowerCase().replace(/\s+/g, ''),
});

interface AbilityView {
  score: number;
  bonus: number;
  save: number;
  saveprof: number;
}

const abilityNames = ['Strength', 'Dexterity', 'Constitution', 'Intelligence', 'Wisdom', 'Charisma'];
const abilityShort = ['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA'];
const abilityEntries = abilityNames.map((name, i) => ({ name, short: abilityShort[i] }));

function lookupAbility(fullName: string): AbilityView {
  return (
    abilities[fullName.toLowerCase()] ?? { score: 10, bonus: 0, save: 0, saveprof: 0 }
  );
}

// Large lists all six saves; medium lists only the proficient ones. One table
// component, two row sets - see SavesTable.astro, which owns the row type.
const allSaveRows: SaveTableRow[] = abilityEntries.map(({ name, short }) => {
  const { save, saveprof } = lookupAbility(name);
  return { short, save, saveprof };
});
const proficientSaveRows = allSaveRows.filter((row) => row.saveprof > 0);

const sortedFeatures = [...features].sort(
  (a, b) => a.level - b.level || a.name.localeCompare(b.name)
);
const featuresByLevel = groupBy(sortedFeatures, (f) => f.level).map((g) => ({
  level: g.key,
  items: g.items,
}));

const sortedAllSkills = [...allSkills].sort((a, b) => a.name.localeCompare(b.name));
// Large lists every skill; medium lists only the ones the character is proficient
// in. Derived from allSkills rather than the parser's prof-only `skills` list,
// because the medium card is now the same table as the large one and needs `prof`
// and `stat` to draw the dots and the ability column.
const proficientSkills = sortedAllSkills.filter((skill) => skillRank(skill.prof) !== 'none');

// The two sets the Weapons section puts in two tables. Equipped is what is in
// hand, carried is what is on the character but not in hand, and the third
// `carried` value is neither - it is not the character's kit, so the builder
// leaves it out of both. The sets are disjoint by construction, which is what
// stops one weapon appearing twice, and the panel exists when either is non-empty.
const equippedWeaponRows = toWeaponRows(weapons, abilities, profBonus, 'equipped');
const carriedWeaponRows = toWeaponRows(weapons, abilities, profBonus, 'carried');

const inventoryRows = toInventoryRows(inventory);
const inventoryWeight = carriedWeight(inventory);
const inventoryCapacity = carryCapacity(lookupAbility('Strength').score);
const coinRows = toCoinRows(coins);
const hasInventory = hasInventoryContents(inventory, coins);

const sortedPowers = [...powers].sort(
  (a, b) =>
    a.level - b.level || a.group.localeCompare(b.group) || a.name.localeCompare(b.name)
);
const powersByLevel = groupBy(sortedPowers, (p) => p.level).map((lg) => ({
  level: lg.key,
  groups: groupBy(lg.items, (p) => p.group || 'Other').map((gg) => ({
    name: gg.key,
    items: gg.items,
  })),
}));

function isSpellGroup(group: string): boolean {
  return /spell|cantrip/i.test(group);
}
type PowerMark = 'always' | 'prepared' | null;
function powerMark(power: { group: string; prepared: number; preparedDomain: number }): PowerMark {
  if (!isSpellGroup(power.group)) return null;
  if (power.preparedDomain > 0) return 'always';
  if (power.prepared > 0) return 'prepared';
  return null;
}
const hasPowerMarks = sortedPowers.some((p) => powerMark(p) !== null);

const showSaves = canShow('saves') && (proficientSaveRows.length > 0 || canShow('allSaves'));
const showLanguages = canShow('languages') && languages.length > 0;
const showFeats = canShow('feats') && feats.length > 0;
// The panel can be held open by the two pill sections alone, so the table is
// gated separately: a header row over no rows is an empty sheet, which is the
// thing ADR-0016's content rule exists to avoid.
const showSkillsTable = canShow('allSkills')
  ? sortedAllSkills.length > 0
  : proficientSkills.length > 0;
// The two pill sections ride the Skills panel at medium, so there they are content
// in it. Without this a character with languages or feats and no proficient skills
// would have no Skills panel at medium, and ADR-0016's rule that a menu entry
// exists only for a section with content would delete the feats instead of hiding
// an empty sheet - the one outcome worse than an empty panel. At large they sit in
// the Overview panel instead, so they are not content here.
const showSkills =
  canShow('skills') && (showSkillsTable || (!canShow('allSkills') && (showLanguages || showFeats)));
const showWeapons =
  canShow('weapons') && (equippedWeaponRows.length > 0 || carriedWeaponRows.length > 0);
const showInventory = canShow('inventory') && hasInventory;
const showFeatures = canShow('features') && featuresByLevel.length > 0;
const showPowers = canShow('powers') && powersByLevel.length > 0;

const SAVES_SPLIT_MAX_LANGUAGES = 6;
const SAVES_SPLIT_MAX_FEATS = 4;

// The `@7xl` split pairs Saving Throws with the pill stack inside the large
// Overview panel. It is large-only by construction rather than by a mode test:
// `showSaves` is false at every mode that does not render the section, and the
// pill sections have left the Overview panel at medium anyway.
const splitSavesGroup =
  showSaves &&
  (showLanguages || showFeats) &&
  (showLanguages ? languages.length : 0) <= SAVES_SPLIT_MAX_LANGUAGES &&
  (showFeats ? feats.length : 0) <= SAVES_SPLIT_MAX_FEATS;

// --- Section menu ----------------------------------------------------------
// A menu entry is only offered for a section the card actually has something to
// put in it. A bar whose fourth entry opens an empty sheet is worse than a
// shorter one.
//
// Overview is unconditional: Vitals and Abilities render for every character, so
// it is never empty and the bar always has a landing entry.
//
// The two modes above medium are different instruments, not two settings of one:
// medium is a `small` roster card with more room than it needs, so its sections
// compete for a vertical column and only one should be open. A full character
// sheet is a long scroll already, so hiding five of six sections behind a click
// costs the reader their sense of the whole; there the bar is a table of
// contents that jumps. Hence two modes and one bar between them.
//
// The section headings follow from that split rather than being decided beside it.
// At medium the visible tab names the open panel, so a heading inside it repeats a
// word the reader is already looking at. At large there is no tab and no selection
// state - the bar is a row of links that all look alike, and the page is one long
// scroll - so a section that is nothing but tables gives the reader no way to tell
// where they have landed. Every section names itself at large, in the same
// `sectionHeadingClass` treatment as Vitals and Saving Throws.
//
// That the heading *level* differs by mode is the honest structure in each rather
// than an inconsistency: at large the panel heading is the `h3` and its `Level N`
// groups genuinely sit inside it, so they step to `h4`/`h5`. At medium no panel
// heading exists, so the same groups sit directly under the card name and stay at
// `h3`/`h4`. `h2 > h3 > h4 > h5` is contiguous in both.
const tabbed = display === 'medium';
const jumping = display === 'large';

// The `Level N` groups in Features and Powers, and the power group names beneath
// them, as tag names rather than literals. Astro resolves a capitalised binding in
// a tag position to the element it names, so this is one heading written once at
// two levels instead of a duplicated subtree or a `set:html` escape hatch - and
// the level is decided in one place, where the reason for it is written down.
const levelHeading = jumping ? 'h4' : 'h3';
const groupHeading = jumping ? 'h5' : 'h4';
const LevelHeading = levelHeading;
const GroupHeading = groupHeading;

// Anchor ids have to exist in the server-rendered HTML, because at large the bar
// is plain `<a href="#...">` and needs no JavaScript to work. `filename` is the
// XML basename, which is unique per character - and `large` renders one card per
// page, so the prefix only has to be stable, not globally coordinated.
const cardId = `xmlcard-${character.filename ?? 'card'}`;
const sectionId = (id: CardTabId) => `${cardId}-${id}`;

const tabAvailability: Record<CardTabId, boolean> = {
  overview: true,
  skills: showSkills,
  inventory: showInventory,
  weapons: showWeapons,
  features: showFeatures,
  powers: showPowers,
};

const tabs = CARD_TABS.filter((tab) => tabAvailability[tab.id]);
const tabIds = tabs.map((tab) => tab.id).join(' ');
---

<div
  class="not-content @container w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm overflow-hidden font-sans text-sm"
  x-data={tabbed ? 'xmlCard' : undefined}
  data-card-tabs={tabbed ? tabIds : undefined}
>
  <header class="char-header">
    {character.filename && link ? (
      <a href={`/fantasy-grounds/characters/${character.filename}`} aria-label={`View ${name} character sheet`} class="char-portrait-link">
        <img class="char-portrait" src={avatarSrc} alt={`${name} portrait`} title={name} />
      </a>
    ) : (
      <img class="char-portrait" src={avatarSrc} alt={`${name} portrait`} title={name} />
    )}
    <div class="char-id">
      <h2 class="char-name" title={`${name} - HP: ${hp}${tempHp ? ` (Temp: ${tempHp})` : ''}`}>{name}</h2>
      <p class="char-meta">
        {race} - {classString}
        {subclassString && display === 'large' && (<span> ({subclassString})</span>)}
      </p>
      {canShow('tags') && (
        <p class="char-tags">
          {alignment && display !== 'small' && (<span class="char-pill">{alignment}</span>)}
          {background && (<span class="char-pill">{background}</span>)}
          {/* Deity is large-only, like the subclass above it: both are long
              free-text identity values that fit a full-width character sheet
              but turn into a two-line block inside the ~200px identity column
              of a two-column roster card. The full value stays on the
              character page. */}
          {deity && display === 'large' && (<span class="char-pill">{deity}</span>)}
        </p>
      )}
    </div>
    <div class="char-hp" title={`Hit Points: ${hp}${tempHp ? ` (Temp: ${tempHp})` : ''}`}>
      <span class="char-hp-label">Hit Points</span>
      <span class="char-hp-value">{hp}</span>
      {tempHp > 0 && <span class="char-hp-temp">+{tempHp} temp</span>}
    </div>
  </header>

  {/* The section bar. It is a `tablist` at medium and a table of contents at
      large, and the two are different elements rather than one element with a
      mode switch: a tab hides what it does not select, so it must ship
      `aria-selected` and a roving tabindex, and a jump link hides nothing, so
      those would be lies. It also means the large sheet needs no JavaScript at
      all - `href="#..."` and a fragment identifier are enough. */}
  {jumping ? (
    <nav class="char-tabs" aria-label="Character sections">
      {tabs.map((tab) => (
        <a class="char-tab" href={`#${sectionId(tab.id)}`} data-tab={tab.id}>
          <span class="char-tab-label">{tab.label}</span>
        </a>
      ))}
    </nav>
  ) : tabbed ? (
    <div
      class="char-tabs"
      role="tablist"
      aria-label="Character sections"
      x-cloak
      @keydown="step($event)"
    >
      {tabs.map((tab) => (
        <button
          type="button"
          class="char-tab"
          role="tab"
          data-tab={tab.id}
          :aria-selected={`isActive('${tab.id}')`}
          :tabindex={`isActive('${tab.id}') ? 0 : -1`}
          @click={`select('${tab.id}')`}
        >
          <span class="char-tab-label">{tab.label}</span>
        </button>
      ))}
    </div>
  ) : null}

  <div class="p-4 space-y-4">
    {/*
      One panel per tab. Which panel holds which sections is the display mode's
      call (ADR-0017), and the two modes differ: at large the Overview panel holds
      Vitals, Abilities, Passive Skills, Saving Throws, Languages and Feats, while
      at medium it holds Vitals, Abilities and Passive Skills and the Skills panel
      picks up Languages and Feats. The `x-show` is the only thing hiding an
      inactive panel - the section's markup is identical either way, so switching
      tabs cannot re-style a section, only reveal it.

      No `x-cloak` on a panel, deliberately, and `data-no-cloak="no-js-reader-loses-the-card"` marks the opt-out
      for `tailwind.test.ts`. `[x-cloak]` is `display: none !important`, so a
      cloaked panel is invisible until Alpine boots - and a reader without
      JavaScript never boots it. Cloaking all six would render a medium card as a
      header and nothing else, which is strictly worse than the one-long-column
      layout this replaced. Without the cloak a no-JS reader gets every panel, in
      order: the pre-menu layout, intact. The bar keeps its cloak because there
      the alternative is six labels that do nothing.
    */}
    {/* Large only: Saving Throws is the one section in the right-hand stack, and
        medium renders it nowhere. At medium there is nothing that could sit
        beside the character at any container width, so the panel is one column
        rather than a grid reserving half its width for nothing. */}
    <div
      class={jumping && showSaves ? 'grid grid-cols-1 @6xl:grid-cols-2 gap-4' : 'space-y-4'}
      role={tabbed ? 'tabpanel' : undefined}
      data-panel="overview"
      id={jumping ? sectionId('overview') : undefined}
      x-show={tabbed ? "active === 'overview'" : undefined}
      data-no-cloak="no-js-reader-loses-the-card"
    >
      <section class="relative group/overview">
        {/* No `Overview` heading: the tab names this panel. The sections inside
            it are Vitals, Abilities and Passive Skills, and each is its own h3
            under the card's h2 name. At large this panel also holds Saving
            Throws, Languages and Feats below. */}
        <div class="space-y-2">
          <section class="relative group">
            <h3 class={`${sectionHeadingClass} mb-2`}>Vitals</h3>
            <div class="grid grid-cols-4 gap-2 text-center">
              <div class={cardPlateClass}>
                <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">AC</div>
                <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{ac}</div>
              </div>
              <div class={cardPlateClass}>
                <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Speed</div>
                <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{speed}{display !== 'small' && ' ft'}</div>
              </div>
              <div class={cardPlateClass}>
                <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Init</div>
                <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{signed(initiative)}</div>
              </div>
              {canShow('profBonus') && (
                <div class={cardPlateClass}>
                  <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Prof</div>
                  <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{signed(profBonus)}</div>
                </div>
              )}
            </div>
          </section>

          <section>
            <h3 class={`${sectionHeadingClass} mb-2`}>Abilities</h3>
            {display === 'small' ? (
              <CompactAbilityGrid abilities={abilities} entries={abilityEntries} />
            ) : (
              <>
                <div
                  class="grid grid-cols-3 @lg:grid-cols-6 gap-1"
                >
                  {abilityNames.map((abilityName, i) => {
                    const ability = lookupAbility(abilityName);
                    return (
                      <div class="text-center p-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 border-t-[3px] border-t-[#58180d] dark:border-t-[#c68000] [border-top-left-radius:45%] [border-top-right-radius:45%] [border-bottom-left-radius:8px] [border-bottom-right-radius:8px]">
                        <div class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">{abilityShort[i]}</div>
                        <div class="text-xl font-bold text-gray-900 dark:text-gray-100">{signed(ability.bonus)}</div>
                        <div class="text-sm text-gray-600 dark:text-gray-400">{ability.score}</div>
                        {/* The tile prints `SAVE +7` and nothing else, so a Fighter's
                            ability plus proficiency and a Wizard's raw Intelligence
                            looked identical on the same character. The coin is the
                            Saving Throws table's coin - one class, one legend - and it
                            sits on the save line because the save is what it qualifies.
                            The compact grid at small is a different component and has no
                            room for a mark, so it stays as it is. */}
                        <div class="text-xs text-gray-500 dark:text-gray-400">
                          <span class="inline-flex items-center gap-1">
                            <span>SAVE {signed(ability.save)}</span>
                            {ability.saveprof > 0 && (
                              <>
                                <span class={proficiencyCoinClass} aria-hidden="true"></span>
                                <span class="sr-only">{proficiencyMarkLabel}</span>
                              </>
                            )}
                          </span>
                        </div>
                      </div>
                    );
                  })}
                </div>

              </>
            )}
          </section>

          {canShow('passives') && (
            <section class="relative group">
              <h3 class={`${sectionHeadingClass} mb-2`}>Passive Skills</h3>
              <div class="grid grid-cols-3 gap-2 text-center">
                <div class={`${cardPlateClass} flex flex-col items-center text-center gap-1 @md:flex-row @md:items-baseline @md:justify-between @md:gap-2`}>
                  <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Passive Perception</div>
                  <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{passives.perception}</div>
                </div>
                <div class={`${cardPlateClass} flex flex-col items-center text-center gap-1 @md:flex-row @md:items-baseline @md:justify-between @md:gap-2`}>
                  <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Passive Investigation</div>
                  <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{passives.investigation}</div>
                </div>
                <div class={`${cardPlateClass} flex flex-col items-center text-center gap-1 @md:flex-row @md:items-baseline @md:justify-between @md:gap-2`}>
                  <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Passive Insight</div>
                  <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{passives.insight}</div>
                </div>
              </div>
            </section>
          )}
        </div>
      </section>

      {/* Large only. Saving Throws is the one section that has anything to sit
          beside the character in this panel, and medium does not render it; at
          medium the two pill sections have moved to the Skills panel below, so
          there is no second grid cell left to fill. */}
      {jumping && (
        <div class={`grid grid-cols-1 gap-2${splitSavesGroup ? ' @7xl:grid-cols-2 @7xl:gap-4' : ''}`}>
          {showSaves && (
            <section class="@container relative group">
              <h3 class={`${sectionHeadingClass} mb-2`}>Saving Throws</h3>
              <SavesTable
                rows={canShow('allSaves') ? allSaveRows : proficientSaveRows}
                columns={canShow('allSaves') ? 2 : 1}
              />
            </section>
          )}

          {(showLanguages || showFeats) && (
            <LanguagesFeats languages={languages} feats={feats} />
          )}
        </div>
      )}
    </div>

    {/* Each remaining panel is one section, full width. The card used to pair
        Skills beside Inventory and Features beside Powers at `@6xl`; with a
        panel per tab there is nothing beside them to pair with, and the
        two-column split bought nothing but a shorter page. */}
    {showSkills && (
      <div
        role={tabbed ? 'tabpanel' : undefined}
        data-panel="skills"
        id={jumping ? sectionId('skills') : undefined}
        x-show={tabbed ? "active === 'skills'" : undefined}
        data-no-cloak="no-js-reader-loses-the-card"
      >
        {jumping && <h3 class={`${sectionHeadingClass} mb-2`}>Skills</h3>}
        {showSkillsTable && (
          <SkillsTable
            rows={canShow('allSkills') ? sortedAllSkills : proficientSkills}
            columns={canShow('allSkills') ? 2 : 1}
          />
        )}
        {/* The other half of ADR-0017's panel rule: at medium the two pill
            sections ride this panel, because it is a panel of short lists and
            the tab names the panel so their own headings are not a repeat of
            anything. At large they stay in the Overview panel above, which is
            where they have always been. The `mt-3` separates them from the
            table; at large the grid cell supplies the separation instead. */}
        {tabbed && (showLanguages || showFeats) && (
          <div class="mt-3">
            <LanguagesFeats languages={languages} feats={feats} />
          </div>
        )}
      </div>
    )}

    {showInventory && (
      <div
        role={tabbed ? 'tabpanel' : undefined}
        data-panel="inventory"
        id={jumping ? sectionId('inventory') : undefined}
        x-show={tabbed ? "active === 'inventory'" : undefined}
        data-no-cloak="no-js-reader-loses-the-card"
      >
{/* The carried-weight total annotates the inventory contents, so it sits with
            them. At large it rides the heading's baseline again - it always did,
            and it is the only trailing value on the card, so a heading without
            it looks like an oversight. At medium the tab names the panel, so the
            total leads the section on its own line with no heading to ride. */}
        {jumping ? (
          <div class="flex flex-col gap-1 mb-2 @md:flex-row @md:items-baseline @md:justify-between @md:gap-2">
            <h3 class={sectionHeadingClass}>Inventory</h3>
            {inventoryRows.length > 0 && (
              <span class={sectionHeadingTrailingClass}>
                {inventoryWeight} / {inventoryCapacity} lb. carried
              </span>
            )}
          </div>
        ) : (
          inventoryRows.length > 0 && (
            <p class={`mb-2 ${sectionHeadingTrailingClass}`}>
              {inventoryWeight} / {inventoryCapacity} lb. carried
            </p>
          )
        )}
        {inventoryRows.length > 0 && (
          <div class={cardPlateClass}>
            {/* Four columns cannot hold a ~330px card. Weight and State drop
                out below `@lg` and reappear as a second line under the item
                name, so the row still carries a name and three figures at every
                width - which is the whole of ADR-0014's argument. It is a
                container query because the card is 1230px on a character sheet
                and 358px in a roster at the same viewport. */}
            <table class="w-full text-sm">
              <thead>
                <tr class="text-[10px] uppercase tracking-wide text-gray-500 dark:text-gray-400">
                  <th class="text-left font-medium pb-1">Item</th>
                  <th class="text-right font-medium pb-1">Count</th>
                  <th class="hidden @lg:table-cell text-right font-medium pb-1">Weight</th>
                  <th class="hidden @lg:table-cell text-left font-medium pb-1">State</th>
                </tr>
              </thead>
              <tbody>
                {inventoryRows.map((item) => (
                  <tr class="border-t border-gray-200 dark:border-gray-700">
                    <td class="py-1 text-gray-700 dark:text-gray-300">
                      {item.name}
                      <span class="block @lg:hidden text-xs text-gray-500 dark:text-gray-400">
                        {item.weight} &middot; {item.state}
                      </span>
                    </td>
                    <td class="py-1 text-right text-gray-700 dark:text-gray-300">{item.count}</td>
                    <td class="hidden @lg:table-cell py-1 text-right text-gray-700 dark:text-gray-300">{item.weight}</td>
                    <td class="hidden @lg:table-cell py-1 text-gray-500 dark:text-gray-400">{item.state}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <div class={`mt-2 ${cardPlateClass}`}>
          <div class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">Current Wealth</div>
          <div class="grid grid-cols-5 gap-1 text-center">
            {coinRows.map((coin) => (
              <div>
                <div class="text-[10px] uppercase tracking-wide text-gray-500 dark:text-gray-400">{coin.label}</div>
                <div class="text-sm font-semibold text-gray-900 dark:text-gray-100">{coin.value}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    {showWeapons && (
      <div
        role={tabbed ? 'tabpanel' : undefined}
        data-panel="weapons"
        id={jumping ? sectionId('weapons') : undefined}
        x-show={tabbed ? "active === 'weapons'" : undefined}
        data-no-cloak="no-js-reader-loses-the-card"
      >
        {/* One heading names the section and each table names itself beneath it.
            Two sibling headings claiming to be one section is not an outline. This
            is the one place where the section heading matches its tab label: the
            panel used to be headed "Equipped Weapons", which was the tab's word plus
            a qualifier, and it now holds more than the weapons in hand. */}
        {jumping && <h3 class={`${sectionHeadingClass} mb-2`}>Weapons</h3>}
        {equippedWeaponRows.length > 0 && (
          <>
            {jumping && (
              <h4 class={`${sectionSubheadingClass} mb-1`}>Equipped Weapons</h4>
            )}
            <WeaponsTable rows={equippedWeaponRows} label="Equipped weapons" />
          </>
        )}
        {/* Carried-but-not-equipped, omitted when the pack is empty: a section must
            not open onto a second, empty sheet. At medium neither table takes a
            heading, because the tab names the panel - the rule every other medium
            section already follows - so the tables keep an accessible name instead. */}
        {carriedWeaponRows.length > 0 && (
          <>
            {jumping && <h4 class={`${sectionSubheadingClass} mt-3 mb-1`}>Carried Weapons</h4>}
            <WeaponsTable rows={carriedWeaponRows} label="Carried weapons" />
          </>
        )}
      </div>
    )}

    {showFeatures && (
      <div
        role={tabbed ? 'tabpanel' : undefined}
        data-panel="features"
        id={jumping ? sectionId('features') : undefined}
        x-show={tabbed ? "active === 'features'" : undefined}
        data-no-cloak="no-js-reader-loses-the-card"
      >
        {jumping && <h3 class={`${sectionHeadingClass} mb-2`}>Features</h3>}
        <div class={cardPlateClass}>
          {featuresByLevel.map((group) => (
            <div>
              {/* `Level N` sits one step below whatever owns it. At medium the
                  tab names the panel and there is no panel heading, so the card
                  name owns it and `h3` is correct. At large the Features heading
                  above owns it, and `h4` is what keeps the outline contiguous -
                  two `h3`s in a row here would say Features and its first level
                  group are siblings. */}
              <LevelHeading class={`${sectionSubheadingClass} mt-3 mb-1`}>Level {group.level}</LevelHeading>
              <div class="flex flex-wrap gap-2">
                {group.items.map((feature) => (
                  <span
                    class="px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded text-sm text-gray-700 dark:text-gray-300"
                    title={feature.source ? `Source: ${feature.source}` : undefined}
                  >{feature.name}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {showPowers && (
      <div
        role={tabbed ? 'tabpanel' : undefined}
        data-panel="powers"
        id={jumping ? sectionId('powers') : undefined}
        x-show={tabbed ? "active === 'powers'" : undefined}
        data-no-cloak="no-js-reader-loses-the-card"
      >
        {jumping && <h3 class={`${sectionHeadingClass} mb-2`}>Powers</h3>}
        <div class={cardPlateClass}>
          {powersByLevel.map((levelGroup) => (
            <div>
              {/* Same level rule as Features, for the same reason. */}
              <LevelHeading class={`${sectionSubheadingClass} mt-3 mb-1`}>Level {levelGroup.level}</LevelHeading>
              {levelGroup.groups.map((group) => (
                <div>
                  <GroupHeading class={`${sectionGroupClass} mt-2 mb-1`}>{group.name}</GroupHeading>
                  <div class="flex flex-wrap gap-2">
                    {group.items.map((power) => {
                      const mark = powerMark(power);
                      return (
                        <span
                          class="px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded text-sm text-gray-700 dark:text-gray-300 inline-flex items-center gap-1"
                          title={power.group ? `Group: ${power.group}` : undefined}
                        >
                          {power.name}
                          {mark === 'always' && (
                            <>
                              <span class="w-1.5 h-1.5 rounded-full border border-[#c68000]" aria-hidden="true"></span>
                              <span class="sr-only">Always prepared (class/subclass)</span>
                            </>
                          )}
                          {mark === 'prepared' && (
                            <>
                              <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
                              <span class="sr-only">Prepared</span>
                            </>
                          )}
                        </span>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          ))}
          {hasPowerMarks && (
            <div class={`mt-3 pt-2 border-t border-gray-100 dark:border-gray-700 flex flex-wrap gap-4 ${sectionLegendClass}`}>
              <span class="inline-flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-[#c68000]" aria-hidden="true"></span>
                Prepared
              </span>
              <span class="inline-flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full border border-[#c68000]" aria-hidden="true"></span>
                Always prepared (class/subclass)
              </span>
            </div>
          )}
        </div>
      </div>
    )}
  </div>
</div>

<style is:global>
  .char-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: #f8f6f5;
    border-bottom: 2px solid #c9ad6a;
  }
  .char-portrait-link {
    display: block;
    flex-shrink: 0;
    border-radius: 7px;
    outline-offset: 2px;
  }
  .char-portrait-link:focus-visible {
    outline: 2px solid #58180d;
  }
  .char-portrait {
    display: block;
    width: 60px;
    height: 76px;
    object-fit: cover;
    border: 1px solid #c7c0be;
    background: #f1eceb;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 45%;
    border-bottom-right-radius: 45%;
  }
  .char-id {
    flex: 1 1 0;
    min-width: 0;
  }
  .char-name {
    margin: 0;
    font-family: Cinzel, 'Bookinsanity', Georgia, serif;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: #58180d;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    /* The name truncates on one line, exactly as the meta line below does, so
       the header keeps its shape at any card width. This reverses an earlier
       decision that let the name wrap: in a two-column roster the identity
       block is ~200px wide and "COPPER DRAGONBORN" gained a second line, which
       read worse than losing its tail. That cost is accepted - a long name
       loses its tail to the ellipsis - and the full value stays reachable
       from this element's own hover title and from the character page the
       portrait links to. */
  }
  .char-meta {
    margin: 3px 0 0;
    font-family: 'ScalySans', 'Bookinsanity', Georgia, serif;
    font-size: 0.8125rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #605552;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .char-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 8px 0 0;
  }
  .char-pill {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    overflow-wrap: break-word;
    padding: 2px 9px;
    font-family: 'ScalySans', 'Bookinsanity', Georgia, serif;
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #605552;
    background: transparent;
    border: 1px solid #c9ad6a;
    border-radius: 9999px;
  }
  .char-hp {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 8px 14px;
    text-align: center;
    background: #ffffff;
    border: 1px solid #c9ad6a;
    border-top: 3px solid #58180d;
    border-radius: 7px;
  }
  .char-hp-label {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #605552;
  }
  .char-hp-value {
    font-family: 'ScalySans', 'Bookinsanity', Georgia, serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    color: #58180d;
    font-variant-numeric: tabular-nums;
  }
  .char-hp-temp {
    font-size: 10px;
    color: #605552;
  }

  [data-theme='dark'] .char-header {
    background: #2e2421;
    border-bottom-color: #867347;
  }
  [data-theme='dark'] .char-portrait-link:focus-visible {
    outline-color: #c68000;
  }
  [data-theme='dark'] .char-portrait {
    border-color: #605552;
    background: #3f3632;
  }
  [data-theme='dark'] .char-name {
    color: #f1eceb;
  }
  [data-theme='dark'] .char-meta {
    color: #c7c0be;
  }
  [data-theme='dark'] .char-pill {
    color: #d4c4a8;
    border-color: #4a403a;
  }
  [data-theme='dark'] .char-hp {
    background: #1b1716;
    border-color: #4a403a;
    border-top-color: #c68000;
  }
  [data-theme='dark'] .char-hp-value {
    color: #c68000;
  }
  /* The HP plate is near-black in dark, so the bark-600 label step that clears
     7.20:1 on the white light-theme plate only reaches 2.47:1 here. The label
     and temp value need their own dark step, the way .char-hp-value already
     does. */
  [data-theme='dark'] .char-hp-label,
  [data-theme='dark'] .char-hp-temp {
    color: #c7c0be;
  }

  /* --- The section tab bar ------------------------------------------------
     It sits on the header's own surface and closes with the same 2px gold rule
     the header closes with, so the head reads as one band: identity above, the
     way into the sheet below. Two gold rules stacked would be two accents
     bracketing one surface, and the second would carry no meaning. */
  .char-tabs {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: 2px;
    /* Zero vertical padding is the point of the bar: it is a menu strip that sits
       flush against the header above it and the sheet below it, so the band reads
       as one instrument rather than a control floating between two blocks. */
    padding: 0 8px;
    background: #f8f6f5;
    border-bottom: 2px solid #c9ad6a;
  }
  /* Six entries measure ~430px, so they fit one line on a
     character sheet and do not fit in a two-column party roster. The card is
     its own container, so the switch is a container query rather than a
     viewport one: the same card is 1230px on a character page and ~400px in the
     roster, and it is the card, not the window, that has to fit.
     Wrapping rather than scrolling is the whole decision: a horizontally
     scrolling strip hides two of six sections behind an edge most readers never
     find, and at 320px it clips its own last tab. */
  @container (max-width: 620px) {
    .char-tabs {
      flex-wrap: wrap;
    }
  }
  .char-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    /* No `gap`: it separated the label from the count, and the counts are gone.
       The entries' own 8px padding carries the rhythm now. */
    /* WCAG 2.5.8. The label is 11px; the target is 44. */
    min-height: 44px;
    /* 8px, not 12px: at 12px each item carried 12px of air on both sides and the
       six labels drifted apart into a loose strip instead of a menu. The 44px
       target is held by `min-height` and by the bar's own padding, so tightening
       the horizontal inset costs nothing a thumb needs. */
    padding: 0 8px;
    /* The bar is an `<a>` at large and a `<button>` at medium, so this one
       property has to be neutralised on both rather than inherited from one. */
    text-decoration: none;
    font-family: 'ScalySans', 'Bookinsanity', Georgia, serif;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #605552;
    background: transparent;
    border: 0;
    border-radius: 0;
    cursor: pointer;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }
  .char-tab-label {
    white-space: nowrap;
  }
  /* No `scroll-margin-top` here on purpose, and it is not an omission. Starlight
     sets `scroll-padding-top` on `html` in `Page.astro` to `1.5rem` plus the nav
     and mobile-TOC heights, which is what keeps an anchor target clear of the
     sticky header. A per-section `scroll-margin-top` would *add* to that rather
     than replace it: measured, it put every jumped-to section 112px down with a
     band of empty page above it. The global value is the one that knows the
     header height, so it is the only one that should be set. */
  /* Selection is carried by four channels, not by colour alone: `aria-selected` for
     assistive tech, a weight step from 500 to 600, a colour step from bark-600 to
     Oxblood, and the 2px marker at the lower edge in that same ink. Three of the
     four survive a greyscale or a forced-colours rendering; only the colour step
     does not, and it is never the only one.
     The marker is 2px rather than 1px because it is the same cue the header rule
     is and at 1px it read as a hairline with no direction. */
  .char-tab[aria-selected='true'] {
    font-weight: 600;
    color: #58180d;
  }
  .char-tab[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 0;
    height: 2px;
    background: #58180d;
  }
  /* Hover tints sit inside `@media (hover: hover)`: `:hover` sticks after a tap
     on iOS and never fires for a stylus, so an ungated tint goes stale on
     exactly the device that needs a different channel. Press feedback is
     ungated, because `:active` is correct for a mouse held down and for a
     finger on contact alike. */
  @media (hover: hover) {
    .char-tab:hover {
      background: #f1eceb;
      color: #2a2010;
    }
  }
  .char-tab:active {
    background: #f1eceb;
    color: #2a2010;
  }
  /* Bark-black against the Bark 100 band is 14.9:1, and it is never the same
     value as the control it outlines. */
  .char-tab:focus-visible {
    outline: 2px solid #1b1716;
    outline-offset: -2px;
  }

  [data-theme='dark'] .char-tabs {
    background: #2e2421;
    border-bottom-color: #867347;
  }
  [data-theme='dark'] .char-tab {
    color: #c7c0be;
  }
  [data-theme='dark'] .char-tab[aria-selected='true'] {
    color: #f7860f;
  }
  [data-theme='dark'] .char-tab[aria-selected='true']::after {
    background: #f7860f;
  }
  @media (hover: hover) {
    [data-theme='dark'] .char-tab:hover {
      background: #3f3632;
      color: #f1eceb;
    }
  }
  [data-theme='dark'] .char-tab:active {
    background: #3f3632;
    color: #f1eceb;
  }
  [data-theme='dark'] .char-tab:focus-visible {
    outline-color: #f8f6f5;
  }

  @container (max-width: 400px) {
    .char-hp {
      display: none;
    }
  }
</style>
