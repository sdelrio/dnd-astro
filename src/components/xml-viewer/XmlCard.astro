---
import type { CharacterData } from '@/utils/parse-character-xml';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { signed } from '@/utils/format';
import IconifyIcon from '@/components/IconifyIcon.astro';

interface Props {
  character: CharacterData;
  display?: 'small' | 'medium' | 'large';
  image?: string;
}

const { character, display = 'medium', image } = Astro.props;

const {
  name,
  race,
  alignment,
  background,
  deity,
  classes,
  abilities,
  defenses,
  profBonus,
  skills,
  languages,
  feats,
  features,
  powers,
} = character;

const totalLevel = classes.reduce((sum, c) => sum + c.level, 0);
const classString = classes.map((c) => `${c.name} ${c.level}`).join(' / ');

// Build-time avatar resolution: explicit image prop wins when the file exists
// (missing files fall back to faceless.svg), otherwise probe {slug}.jpg ->
// {slug}.png -> faceless.svg. Frontmatter runs at build time, so existsSync
// here costs zero client JavaScript.
function probeAvatar(base: string): string {
  const dir = join(process.cwd(), 'public/fg/avatar');
  if (existsSync(join(dir, `${base}.jpg`))) return `/fg/avatar/${base}.jpg`;
  if (existsSync(join(dir, `${base}.png`))) return `/fg/avatar/${base}.png`;
  return '/fg/avatar/faceless.svg';
}
function resolveAvatar(explicit: string | undefined, slug: string): string {
  if (explicit) {
    return existsSync(join(process.cwd(), 'public/fg/avatar', explicit))
      ? `/fg/avatar/${explicit}`
      : '/fg/avatar/faceless.svg';
  }
  return probeAvatar(slug);
}
const avatarSrc = resolveAvatar(image, name.toLowerCase().replace(/\s+/g, ''));

interface AbilityView {
  score: number;
  bonus: number;
  save: number;
  saveprof: number;
}

const abilityNames = ['Strength', 'Dexterity', 'Constitution', 'Intelligence', 'Wisdom', 'Charisma'];
const abilityShort = ['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA'];

function ability(fullName: string): AbilityView {
  return (
    abilities[fullName.toLowerCase()] ?? { score: 10, bonus: 0, save: 0, saveprof: 0 }
  );
}

const proficientSaves = abilityNames.filter((a) => ability(a).saveprof > 0);

const sortedFeatures = [...features].sort(
  (a, b) => a.level - b.level || a.name.localeCompare(b.name)
);
const featuresByLevel: { level: number; items: typeof sortedFeatures }[] = [];
for (const f of sortedFeatures) {
  const g = featuresByLevel.find((g) => g.level === f.level);
  if (g) g.items.push(f);
  else featuresByLevel.push({ level: f.level, items: [f] });
}

const sortedPowers = [...powers].sort(
  (a, b) =>
    a.level - b.level || a.group.localeCompare(b.group) || a.name.localeCompare(b.name)
);
const powersByLevel: {
  level: number;
  groups: { name: string; items: typeof sortedPowers }[];
}[] = [];
for (const p of sortedPowers) {
  let lg = powersByLevel.find((g) => g.level === p.level);
  if (!lg) {
    lg = { level: p.level, groups: [] };
    powersByLevel.push(lg);
  }
  const groupName = p.group || 'Other';
  let gg = lg.groups.find((g) => g.name === groupName);
  if (!gg) {
    gg = { name: groupName, items: [] };
    lg.groups.push(gg);
  }
  gg.items.push(p);
}
---

<div
  class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm overflow-hidden font-sans text-sm"
  data-display={display}
  data-character={JSON.stringify(character)}
  x-data="{ displayMode: $el.dataset.display, expandedSections: { abilities: true, saves: true, skills: true, languages: true, feats: true, features: true, powers: true }, rank(m) { return ({ small: 0, medium: 1, large: 2 })[m] || 0; }, toggleSection(s) { this.expandedSections[s] = !this.expandedSections[s]; }, isExpanded(s) { return !!this.expandedSections[s]; } }"
  :class="{ 'max-w-[360px]': displayMode === 'small', 'max-w-[480px]': displayMode === 'medium', 'max-w-[710px]': displayMode === 'large', 'inline-block align-top': displayMode === 'small' }"
>
  <header class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 p-4">
    {display === 'large' && (
      <div class="flex justify-end gap-1 mb-2" role="group" aria-label="Display mode">
        <button
          class="px-2 py-1 text-xs rounded transition-colors"
          :class="displayMode === 'small' ? 'bg-blue-600 text-white' : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'"
          @click="displayMode = 'small'"
          :aria-pressed="displayMode === 'small'"
        >
          Small
        </button>
        <button
          class="px-2 py-1 text-xs rounded transition-colors"
          :class="displayMode === 'medium' ? 'bg-blue-600 text-white' : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'"
          @click="displayMode = 'medium'"
          :aria-pressed="displayMode === 'medium'"
        >
          Medium
        </button>
        <button
          class="px-2 py-1 text-xs rounded transition-colors"
          :class="displayMode === 'large' ? 'bg-blue-600 text-white' : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'"
          @click="displayMode = 'large'"
          :aria-pressed="displayMode === 'large'"
        >
          Large
        </button>
      </div>
    )}

    {display === 'large' && (
      <img
        class="float-right ml-4 mb-3 w-36 sm:w-44 rounded object-cover"
        src={avatarSrc}
        alt={`${name} portrait`}
        x-show="rank(displayMode) >= rank('large')"
      />
    )}

    <h1 class="mt-0 text-xl font-bold text-gray-900 dark:text-white">{name}</h1>
    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">{race} — {classString} (Level {totalLevel})</p>
    {display !== 'small' && (
      <p class="mt-2 flex flex-wrap gap-1" x-show="rank(displayMode) >= rank('medium')">
        {alignment && (
          <span class="inline-flex items-center gap-1 px-2 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full text-xs">{alignment}</span>
        )}
        {background && (
          <span class="inline-flex items-center gap-1 px-2 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full text-xs">{background}</span>
        )}
        {deity && (
          <span class="inline-flex items-center gap-1 px-2 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full text-xs">{deity}</span>
        )}
      </p>
    )}
  </header>

  <div class="p-4 space-y-4">
    <section class="border-t border-gray-100 dark:border-gray-800 pt-4 first:border-t-0 first:pt-0">
      <h2 class="mt-0 font-semibold text-gray-900 dark:text-gray-100 mb-2">Vitals</h2>
      <div class="grid grid-cols-4 gap-2 text-center">
        <div class="p-2 bg-gray-50 dark:bg-gray-900 rounded">
          <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">AC</div>
          <div class="text-lg font-bold text-gray-900 dark:text-white">{defenses.ac}</div>
        </div>
        <div class="p-2 bg-gray-50 dark:bg-gray-900 rounded">
          <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">HP</div>
          <div class="text-lg font-bold text-gray-900 dark:text-white">{defenses.hp}</div>
        </div>
        <div class="p-2 bg-gray-50 dark:bg-gray-900 rounded">
          <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Speed</div>
          <div class="text-lg font-bold text-gray-900 dark:text-white">{defenses.speed} ft</div>
        </div>
        <div class="p-2 bg-gray-50 dark:bg-gray-900 rounded">
          <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Init</div>
          <div class="text-lg font-bold text-gray-900 dark:text-white">{signed(defenses.initiative)}</div>
        </div>
      </div>
      {display !== 'small' && (
        <p
          class="mt-3 text-sm font-medium text-gray-700 dark:text-gray-300"
          x-show="rank(displayMode) >= rank('medium')"
        >
          Proficiency Bonus: {signed(profBonus)}
        </p>
      )}
    </section>

    <section class="border-t border-gray-100 dark:border-gray-800 pt-4">
      <h2 class="mt-0 font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2">
        Abilities
        <button
          class="ml-auto bg-transparent border-none cursor-pointer p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-all"
          :class="{ 'rotate-180': isExpanded('abilities') }"
          @click="toggleSection('abilities')"
          :aria-expanded="isExpanded('abilities')"
          aria-label="Toggle abilities"
        >
          <IconifyIcon icon="game-icons:expand" width="1em" />
        </button>
      </h2>
      <div x-show="isExpanded('abilities')" x-transition>
        {display === 'small' ? (
          <div class="grid grid-cols-6 gap-1">
            {abilityNames.map((abilityName, i) => (
              <div class="text-center p-2 bg-gray-50 dark:bg-gray-900 rounded">
                <div class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">{abilityShort[i]}</div>
                <div class="text-sm text-gray-600 dark:text-gray-300">{signed(ability(abilityName).bonus)}</div>
                <div class="text-xs text-gray-500 dark:text-gray-400">{signed(ability(abilityName).save)}</div>
              </div>
            ))}
          </div>
        ) : (
          <>
            <div
              class="grid grid-cols-6 gap-1"
              x-show="displayMode !== 'small'"
            >
              {abilityNames.map((abilityName, i) => (
                <div class="text-center p-2 bg-gray-50 dark:bg-gray-900 rounded">
                  <div class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">{abilityShort[i]}</div>
                  <div class="text-xl font-bold text-gray-900 dark:text-white">{ability(abilityName).score}</div>
                  <div class="text-sm text-gray-600 dark:text-gray-300">{signed(ability(abilityName).bonus)}</div>
                  <div class="text-xs text-gray-500 dark:text-gray-400">Save: {signed(ability(abilityName).save)}</div>
                </div>
              ))}
            </div>
            {display === 'large' && (
              <div
                class="grid grid-cols-6 gap-1"
                x-show="displayMode === 'small'"
              >
                {abilityNames.map((abilityName, i) => (
                  <div class="text-center p-2 bg-gray-50 dark:bg-gray-900 rounded">
                    <div class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">{abilityShort[i]}</div>
                    <div class="text-sm text-gray-600 dark:text-gray-300">{signed(ability(abilityName).bonus)}</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">{signed(ability(abilityName).save)}</div>
                  </div>
                ))}
              </div>
            )}
          </>
        )}
      </div>
    </section>

    {display !== 'small' && proficientSaves.length > 0 && (
      <section
        class="border-t border-gray-100 dark:border-gray-800 pt-4"
        x-show="rank(displayMode) >= rank('medium')"
      >
        <h2 class="mt-0 font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2">
          Saving Throws
          <button
            class="ml-auto bg-transparent border-none cursor-pointer p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-all"
            :class="{ 'rotate-180': isExpanded('saves') }"
            @click="toggleSection('saves')"
            :aria-expanded="isExpanded('saves')"
            aria-label="Toggle saving throws"
          >
            <IconifyIcon icon="game-icons:expand" width="1em" />
          </button>
        </h2>
        <div class="grid grid-cols-2 gap-1 sm:grid-cols-3" x-show="isExpanded('saves')" x-transition>
          {proficientSaves.map((abilityName) => (
            <div class="flex justify-between py-1 px-2 text-sm">
              <span class="text-gray-700 dark:text-gray-300">{abilityName}</span>
              <span class="font-mono font-semibold text-gray-900 dark:text-white">{signed(ability(abilityName).save)}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {display !== 'small' && skills.length > 0 && (
      <section
        class="border-t border-gray-100 dark:border-gray-800 pt-4"
        x-show="rank(displayMode) >= rank('medium')"
      >
        <h2 class="mt-0 font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2">
          Skills
          <button
            class="ml-auto bg-transparent border-none cursor-pointer p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-all"
            :class="{ 'rotate-180': isExpanded('skills') }"
            @click="toggleSection('skills')"
            :aria-expanded="isExpanded('skills')"
            aria-label="Toggle skills"
          >
            <IconifyIcon icon="game-icons:expand" width="1em" />
          </button>
        </h2>
        <div class="grid grid-cols-2 gap-1 sm:grid-cols-3" x-show="isExpanded('skills')" x-transition>
          {skills.map((skill) => (
            <div class="flex justify-between py-1 px-2 text-sm">
              <span class="text-gray-700 dark:text-gray-300">{skill.name}</span>
              <span class="font-mono font-semibold text-gray-900 dark:text-white">{signed(skill.value)}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {display !== 'small' && languages.length > 0 && (
      <section
        class="border-t border-gray-100 dark:border-gray-800 pt-4"
        x-show="rank(displayMode) >= rank('medium')"
      >
        <h2 class="mt-0 font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2">
          Languages
          <button
            class="ml-auto bg-transparent border-none cursor-pointer p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-all"
            :class="{ 'rotate-180': isExpanded('languages') }"
            @click="toggleSection('languages')"
            :aria-expanded="isExpanded('languages')"
            aria-label="Toggle languages"
          >
            <IconifyIcon icon="game-icons:expand" width="1em" />
          </button>
        </h2>
        <div class="flex flex-wrap gap-2" x-show="isExpanded('languages')" x-transition>
          {languages.map((lang) => (
            <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-sm text-gray-700 dark:text-gray-300">{lang}</span>
          ))}
        </div>
      </section>
    )}

    {display === 'large' && feats.length > 0 && (
      <section
        class="border-t border-gray-100 dark:border-gray-800 pt-4"
        x-show="rank(displayMode) >= rank('large')"
      >
        <h2 class="mt-0 font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2">
          Feats
          <button
            class="ml-auto bg-transparent border-none cursor-pointer p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-all"
            :class="{ 'rotate-180': isExpanded('feats') }"
            @click="toggleSection('feats')"
            :aria-expanded="isExpanded('feats')"
            aria-label="Toggle feats"
          >
            <IconifyIcon icon="game-icons:expand" width="1em" />
          </button>
        </h2>
        <div class="flex flex-wrap gap-2" x-show="isExpanded('feats')" x-transition>
          {feats.map((feat) => (
            <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-sm text-gray-700 dark:text-gray-300">{feat}</span>
          ))}
        </div>
      </section>
    )}

    {display === 'large' && featuresByLevel.length > 0 && (
      <section
        class="border-t border-gray-100 dark:border-gray-800 pt-4"
        x-show="rank(displayMode) >= rank('large')"
      >
        <h2 class="mt-0 font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2">
          Features
          <button
            class="ml-auto bg-transparent border-none cursor-pointer p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-all"
            :class="{ 'rotate-180': isExpanded('features') }"
            @click="toggleSection('features')"
            :aria-expanded="isExpanded('features')"
            aria-label="Toggle features"
          >
            <IconifyIcon icon="game-icons:expand" width="1em" />
          </button>
        </h2>
        <div x-show="isExpanded('features')" x-transition>
          {featuresByLevel.map((group, gi) => (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mt-3 mb-1">
                Level {group.level}
              </h3>
              {group.items.map((feature, fi) => (
                <div class="py-2 border-b border-gray-100 dark:border-gray-800 last:border-b-0">
                  <div
                    class="flex items-center justify-between cursor-pointer"
                    role="button"
                    tabindex="0"
                    @click={"toggleSection('feature-" + gi + '-' + fi + "')"}
                    @keydown.enter={"toggleSection('feature-" + gi + '-' + fi + "')"}
                  >
                    <span class="font-medium text-gray-900 dark:text-white">{feature.name}</span>
                    <span class="text-xs text-gray-500 dark:text-gray-400">{feature.source}</span>
                  </div>
                  <div
                    class="mt-2 ml-4 text-sm text-gray-600 dark:text-gray-300"
                    x-show={"isExpanded('feature-" + gi + '-' + fi + "')"}
                    x-transition
                  >
                    <p class="m-0">Source: {feature.source}</p>
                    <p class="m-0">Gained at level {feature.level}</p>
                  </div>
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>
    )}

    {display === 'large' && powersByLevel.length > 0 && (
      <section
        class="border-t border-gray-100 dark:border-gray-800 pt-4"
        x-show="rank(displayMode) >= rank('large')"
      >
        <h2 class="mt-0 font-semibold text-gray-900 dark:text-gray-100 mb-2 flex items-center gap-2">
          Powers
          <button
            class="ml-auto bg-transparent border-none cursor-pointer p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-all"
            :class="{ 'rotate-180': isExpanded('powers') }"
            @click="toggleSection('powers')"
            :aria-expanded="isExpanded('powers')"
            aria-label="Toggle powers"
          >
            <IconifyIcon icon="game-icons:expand" width="1em" />
          </button>
        </h2>
        <div x-show="isExpanded('powers')" x-transition>
          {powersByLevel.map((levelGroup, li) => (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mt-3 mb-1">
                Level {levelGroup.level}
              </h3>
              {levelGroup.groups.map((group, gi) => (
                <div>
                  <h4 class="text-xs font-medium text-gray-500 dark:text-gray-400 mt-2 mb-1">
                    {group.name}
                  </h4>
                  {group.items.map((power, pi) => (
                    <div class="py-2 border-b border-gray-100 dark:border-gray-800 last:border-b-0">
                      <div
                        class="flex items-center justify-between cursor-pointer"
                        role="button"
                        tabindex="0"
                        @click={"toggleSection('power-" + li + '-' + gi + '-' + pi + "')"}
                        @keydown.enter={"toggleSection('power-" + li + '-' + gi + '-' + pi + "')"}
                      >
                        <span class="font-medium text-gray-900 dark:text-white">{power.name}</span>
                        <span class="text-xs text-gray-500 dark:text-gray-400">{power.group}</span>
                      </div>
                      <div
                        class="mt-2 ml-4 text-sm text-gray-600 dark:text-gray-300"
                        x-show={"isExpanded('power-" + li + '-' + gi + '-' + pi + "')"}
                        x-transition
                      >
                        <p class="m-0">Level: {power.level}</p>
                        <p class="m-0">Group: {power.group}</p>
                      </div>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</div>
