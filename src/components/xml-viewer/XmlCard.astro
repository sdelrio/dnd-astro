---
import type { CharacterData } from '@/utils/parse-character-xml';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { signed } from '@/utils/format';
import { groupBy } from '@/utils/group-by';
import SectionHeader from '@/components/xml-viewer/SectionHeader.astro';
import CompactAbilityGrid from '@/components/xml-viewer/CompactAbilityGrid.astro';

interface Props {
  character: CharacterData;
  display?: 'small' | 'medium' | 'large';
  image?: string;
}

const { character, display = 'medium', image } = Astro.props;

// --- Display-mode rank policy -----------------------------------------------
// Each section declares the minimum display mode required to appear.
// Rank order: small=0, medium=1, large=2.
// This single map drives both server-side rendering and Alpine x-show.
const RANKS: Record<string, number> = { small: 0, medium: 1, large: 2 };
function rank(mode: string): number {
  return RANKS[mode] ?? 0;
}
const sectionPolicy = {
  avatar: 'small' as const,
  tags: 'small' as const,
  profBonus: 'medium' as const,
  saves: 'medium' as const,
  skills: 'medium' as const,
  languages: 'medium' as const,
  feats: 'large' as const,
  features: 'large' as const,
  powers: 'large' as const,
} as const;
type SectionKey = keyof typeof sectionPolicy;
function canShow(section: SectionKey): boolean {
  return rank(display) >= rank(sectionPolicy[section]);
}

const {
  name,
  race,
  alignment,
  background,
  deity,
  classes,
  abilities,
  ac,
  hp,
  speed,
  initiative,
  profBonus,
  skills,
  languages,
  feats,
  features,
  powers,
} = character;

const classString = classes.map((c) => `${c.name} ${c.level}`).join(' / ');

// Build-time avatar resolution: explicit image prop wins when the file exists
// (missing files fall back to faceless.svg), otherwise probe {base}.jpg ->
// {base}.png -> faceless.svg, where base is the XML filename when known
// (golden-forest convention: milo.xml -> milo.jpg) and the name slug
// otherwise. Frontmatter runs at build time, so existsSync here costs zero
// client JavaScript.
function probeAvatar(base: string): string {
  const dir = join(process.cwd(), 'public/fg/avatar');
  if (existsSync(join(dir, `${base}.jpg`))) return `/fg/avatar/${base}.jpg`;
  if (existsSync(join(dir, `${base}.png`))) return `/fg/avatar/${base}.png`;
  return '/fg/avatar/faceless.svg';
}
function resolveAvatar(explicit: string | undefined, slug: string): string {
  if (explicit) {
    return existsSync(join(process.cwd(), 'public/fg/avatar', explicit))
      ? `/fg/avatar/${explicit}`
      : '/fg/avatar/faceless.svg';
  }
  return character.avatarPath ?? probeAvatar(slug);
}
const avatarSrc = resolveAvatar(image, character.filename ?? name.toLowerCase().replace(/\s+/g, ''));

interface AbilityView {
  score: number;
  bonus: number;
  save: number;
  saveprof: number;
}

const abilityNames = ['Strength', 'Dexterity', 'Constitution', 'Intelligence', 'Wisdom', 'Charisma'];
const abilityShort = ['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA'];
const abilityEntries = abilityNames.map((name, i) => ({ name, short: abilityShort[i] }));

function lookupAbility(fullName: string): AbilityView {
  return (
    abilities[fullName.toLowerCase()] ?? { score: 10, bonus: 0, save: 0, saveprof: 0 }
  );
}

const proficientSaves = abilityNames.filter((a) => lookupAbility(a).saveprof > 0);

const sortedFeatures = [...features].sort(
  (a, b) => a.level - b.level || a.name.localeCompare(b.name)
);
const featuresByLevel = groupBy(sortedFeatures, (f) => f.level).map((g) => ({
  level: g.key,
  items: g.items,
}));

const sortedPowers = [...powers].sort(
  (a, b) =>
    a.level - b.level || a.group.localeCompare(b.group) || a.name.localeCompare(b.name)
);
const powersByLevel = groupBy(sortedPowers, (p) => p.level).map((lg) => ({
  level: lg.key,
  groups: groupBy(lg.items, (p) => p.group || 'Other').map((gg) => ({
    name: gg.key,
    items: gg.items,
  })),
}));
---

<div
  class="not-content bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm overflow-hidden font-sans text-sm"
  data-display={display}
    x-data="{ displayMode: $el.dataset.display, expandedSections: { abilities: true, saves: true, skills: true, languages: true, feats: true, features: true, powers: true }, rank(m) { return ({ small: 0, medium: 1, large: 2 })[m] || 0; }, sectionPolicy: { avatar: 0, tags: 0, profBonus: 1, saves: 1, skills: 1, languages: 1, feats: 2, features: 2, powers: 2 }, canShow(s) { return this.rank(this.displayMode) >= this.sectionPolicy[s]; }, toggleSection(s) { this.expandedSections[s] = !this.expandedSections[s]; }, isExpanded(s) { return !!this.expandedSections[s]; } }"
  :class="{ 'w-full': displayMode === 'small' || displayMode === 'medium' || displayMode === 'large' }"
>
  <header class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 p-4">
    <div class="flex gap-4">
      <img
        class="w-16 h-[4.75rem] object-cover flex-shrink-0 overflow-hidden border border-gray-300 dark:border-gray-600 [border-top-left-radius:7px] [border-top-right-radius:7px] [border-bottom-left-radius:45%] [border-bottom-right-radius:45%]"
        src={avatarSrc}
        alt={`${name} portrait`}
        title={name}
        x-show="canShow('avatar')"
      />
      <div class="flex-1 min-w-0">
        <h3 class="mt-0 text-xl font-bold text-gray-900 dark:text-gray-100 truncate" title={name}>{name}</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">{race} - {classString}</p>
        {canShow('tags') && (
          <p class="mt-2 flex flex-wrap gap-1" x-show="canShow('tags')">
            {alignment && (
              <span class="inline-flex items-center gap-1 px-2 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-xs">{alignment}</span>
            )}
            {background && (
              <span class="inline-flex items-center gap-1 px-2 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-xs">{background}</span>
            )}
            {deity && (
              <span class="inline-flex items-center gap-1 px-2 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-xs">{deity}</span>
            )}
          </p>
        )}
      </div>
      {display === 'large' && (
        <div class="flex flex-col gap-1 flex-shrink-0" role="group" aria-label="Display mode">
          <button
            class="px-2 py-1 text-xs rounded transition-colors"
            :class="displayMode === 'small' ? 'bg-blue-600 text-white' : 'bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600'"
            @click="displayMode = 'small'"
            :aria-pressed="displayMode === 'small'"
          >
            S
          </button>
          <button
            class="px-2 py-1 text-xs rounded transition-colors"
            :class="displayMode === 'medium' ? 'bg-blue-600 text-white' : 'bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600'"
            @click="displayMode = 'medium'"
            :aria-pressed="displayMode === 'medium'"
          >
            M
          </button>
          <button
            class="px-2 py-1 text-xs rounded transition-colors"
            :class="displayMode === 'large' ? 'bg-blue-600 text-white' : 'bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600'"
            @click="displayMode = 'large'"
            :aria-pressed="displayMode === 'large'"
          >
            L
          </button>
        </div>
      )}
    </div>
  </header>

  <div class="p-4 space-y-4">
    <section class="border-t border-gray-100 dark:border-gray-700 pt-4 first:border-t-0 first:pt-0">
      <h2 class="mt-0 font-semibold text-gray-900 dark:text-gray-100 mb-2">Vitals</h2>
      <div class="grid grid-cols-4 gap-2 text-center">
        <div class="p-2 bg-gray-50 dark:bg-gray-900 rounded">
          <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">AC</div>
          <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{ac}</div>
        </div>
        <div class="p-2 bg-gray-50 dark:bg-gray-900 rounded">
          <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">HP</div>
          <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{hp}</div>
        </div>
        <div class="p-2 bg-gray-50 dark:bg-gray-900 rounded">
          <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Speed</div>
          <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{speed} ft</div>
        </div>
        <div class="p-2 bg-gray-50 dark:bg-gray-900 rounded">
          <div class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">Init</div>
          <div class="text-lg font-bold text-gray-900 dark:text-gray-100">{signed(initiative)}</div>
        </div>
      </div>
      {canShow('profBonus') && (
        <p
          class="mt-3 text-sm font-medium text-gray-700 dark:text-gray-300"
          x-show="canShow('profBonus')"
        >
          Proficiency Bonus: {signed(profBonus)}
        </p>
      )}
    </section>

    <section class="border-t border-gray-100 dark:border-gray-700 pt-4">
      <SectionHeader title="Abilities" sectionKey="abilities" />
      <div x-show="isExpanded('abilities')" x-transition>
        {display === 'small' ? (
          <CompactAbilityGrid abilities={abilities} entries={abilityEntries} />
        ) : (
          <>
            <div
              class="grid grid-cols-6 gap-1"
              x-show="displayMode !== 'small'"
            >
              {abilityNames.map((abilityName, i) => (
                <div class="text-center p-2 bg-gray-50 dark:bg-gray-900 rounded">
                  <div class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">{abilityShort[i]}</div>
                  <div class="text-xl font-bold text-gray-900 dark:text-gray-100">{lookupAbility(abilityName).score}</div>
                  <div class="text-sm text-gray-600 dark:text-gray-400">{signed(lookupAbility(abilityName).bonus)}</div>
                  <div class="text-xs text-gray-500 dark:text-gray-400">SAVE {signed(lookupAbility(abilityName).save)}</div>
                </div>
              ))}
            </div>

          </>
        )}
      </div>
    </section>

    {canShow('saves') && proficientSaves.length > 0 && (
      <section
        class="border-t border-gray-100 dark:border-gray-700 pt-4"
        x-show="canShow('saves')"
      >
        <SectionHeader title="Saving Throws" sectionKey="saves" />
        <div class="grid grid-cols-2 gap-1 sm:grid-cols-3" x-show="isExpanded('saves')" x-transition>
          {proficientSaves.map((abilityName) => (
            <div class="flex justify-between py-1 px-2 text-sm">
              <span class="text-gray-700 dark:text-gray-300">{abilityName}</span>
              <span class="font-mono font-semibold text-gray-900 dark:text-gray-100">{signed(lookupAbility(abilityName).save)}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {canShow('skills') && skills.length > 0 && (
      <section
        class="border-t border-gray-100 dark:border-gray-700 pt-4"
        x-show="canShow('skills')"
      >
        <SectionHeader title="Skills" sectionKey="skills" />
        <div class="grid grid-cols-2 gap-1 sm:grid-cols-3" x-show="isExpanded('skills')" x-transition>
          {skills.map((skill) => (
            <div class="flex justify-between py-1 px-2 text-sm">
              <span class="text-gray-700 dark:text-gray-300">{skill.name}</span>
              <span class="font-mono font-semibold text-gray-900 dark:text-gray-100">{signed(skill.total)}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {canShow('languages') && languages.length > 0 && (
      <section
        class="border-t border-gray-100 dark:border-gray-700 pt-4"
        x-show="canShow('languages')"
      >
        <SectionHeader title="Languages" sectionKey="languages" />
        <div class="flex flex-wrap gap-2" x-show="isExpanded('languages')" x-transition>
          {languages.map((lang) => (
            <span class="px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded text-sm text-gray-700 dark:text-gray-300">{lang}</span>
          ))}
        </div>
      </section>
    )}

    {canShow('feats') && feats.length > 0 && (
      <section
        class="border-t border-gray-100 dark:border-gray-700 pt-4"
        x-show="canShow('feats')"
      >
        <SectionHeader title="Feats" sectionKey="feats" />
        <div class="flex flex-wrap gap-2" x-show="isExpanded('feats')" x-transition>
          {feats.map((feat) => (
            <span class="px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded text-sm text-gray-700 dark:text-gray-300">{feat}</span>
          ))}
        </div>
      </section>
    )}

    {canShow('features') && featuresByLevel.length > 0 && (
      <section
        class="border-t border-gray-100 dark:border-gray-700 pt-4"
        x-show="canShow('features')"
      >
        <SectionHeader title="Features" sectionKey="features" />
        <div x-show="isExpanded('features')" x-transition>
          {featuresByLevel.map((group, gi) => (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mt-3 mb-1">
                Level {group.level}
              </h3>
              {group.items.map((feature, fi) => (
                <div class="py-2 border-b border-gray-100 dark:border-gray-700 last:border-b-0">
                  <div
                    class="flex items-center justify-between cursor-pointer"
                    role="button"
                    tabindex="0"
                    @click={"toggleSection('feature-" + gi + '-' + fi + "')"}
                    @keydown.enter={"toggleSection('feature-" + gi + '-' + fi + "')"}
                  >
                    <span class="font-medium text-gray-900 dark:text-gray-100">{feature.name}</span>
                    <span class="text-xs text-gray-500 dark:text-gray-400">{feature.source}</span>
                  </div>
                  <div
                    class="mt-2 ml-4 text-sm text-gray-600 dark:text-gray-400"
                    x-show={"isExpanded('feature-" + gi + '-' + fi + "')"}
                    x-transition
                  >
                    <p class="m-0">Source: {feature.source}</p>
                    <p class="m-0">Gained at level {feature.level}</p>
                  </div>
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>
    )}

    {canShow('powers') && powersByLevel.length > 0 && (
      <section
        class="border-t border-gray-100 dark:border-gray-700 pt-4"
        x-show="canShow('powers')"
      >
        <SectionHeader title="Powers" sectionKey="powers" />
        <div x-show="isExpanded('powers')" x-transition>
          {powersByLevel.map((levelGroup, li) => (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mt-3 mb-1">
                Level {levelGroup.level}
              </h3>
              {levelGroup.groups.map((group, gi) => (
                <div>
                  <h4 class="text-xs font-medium text-gray-500 dark:text-gray-400 mt-2 mb-1">
                    {group.name}
                  </h4>
                  {group.items.map((power, pi) => (
                    <div class="py-2 border-b border-gray-100 dark:border-gray-700 last:border-b-0">
                      <div
                        class="flex items-center justify-between cursor-pointer"
                        role="button"
                        tabindex="0"
                        @click={"toggleSection('power-" + li + '-' + gi + '-' + pi + "')"}
                        @keydown.enter={"toggleSection('power-" + li + '-' + gi + '-' + pi + "')"}
                      >
                        <span class="font-medium text-gray-900 dark:text-gray-100">{power.name}</span>
                        <span class="text-xs text-gray-500 dark:text-gray-400">{power.group}</span>
                      </div>
                      <div
                        class="mt-2 ml-4 text-sm text-gray-600 dark:text-gray-400"
                        x-show={"isExpanded('power-" + li + '-' + gi + '-' + pi + "')"}
                        x-transition
                      >
                        <p class="m-0">Level: {power.level}</p>
                        <p class="m-0">Group: {power.group}</p>
                      </div>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</div>
