---
import { signed } from '@/utils/format';

interface AbilityView {
  score: number;
  bonus: number;
  save: number;
  saveprof: number;
}

interface AbilityEntry {
  name: string;
  short: string;
}

interface Props {
  abilities: Record<string, AbilityView>;
  entries: AbilityEntry[];
}

const { abilities, entries } = Astro.props;

function lookupAbility(fullName: string): AbilityView {
  return (
    abilities[fullName.toLowerCase()] ?? { score: 10, bonus: 0, save: 0, saveprof: 0 }
  );
}
---

<div class="grid grid-cols-6 gap-1">
  {entries.map((entry) => (
    <div class="text-center p-2 bg-gray-50 dark:bg-gray-900 rounded">
      <div class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">{entry.short}</div>
      <div class="text-sm text-gray-600 dark:text-gray-400">{signed(lookupAbility(entry.name).bonus)}</div>
      <div class="text-xs text-gray-500 dark:text-gray-400">{signed(lookupAbility(entry.name).save)}</div>
    </div>
  ))}
</div>
