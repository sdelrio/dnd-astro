---
import { signed } from '@/utils/format';

interface AbilityView {
  score: number;
  bonus: number;
  save: number;
  saveprof: number;
}

interface Props {
  abilities: Record<string, AbilityView>;
  names: string[];
  short: string[];
}

const { abilities, names, short } = Astro.props;

function ability(fullName: string): AbilityView {
  return (
    abilities[fullName.toLowerCase()] ?? { score: 10, bonus: 0, save: 0, saveprof: 0 }
  );
}
---

<div class="grid grid-cols-6 gap-1">
  {names.map((abilityName, i) => (
    <div class="text-center p-2 bg-gray-50 rounded">
      <div class="text-xs font-semibold text-gray-500 uppercase">{short[i]}</div>
      <div class="text-sm text-gray-600">{signed(ability(abilityName).bonus)}</div>
      <div class="text-xs text-gray-500">{signed(ability(abilityName).save)}</div>
    </div>
  ))}
</div>
