---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import XmlCard from '@/components/xml-viewer/XmlCard.astro';
import charactersJson from '@/generated/characters.json';
import type { StoredCharacter } from '@/utils/build-xml-characters';

export function getStaticPaths() {
  const characters = charactersJson as StoredCharacter[];
  return characters.map((character) => ({
    params: { slug: character.filename },
    props: { character },
  }));
}

interface Props {
  character: StoredCharacter;
}

const { character } = Astro.props;
const classString = character.classes.map((c) => `${c.name} ${c.level}`).join(' / ');
const description = `${character.race} ${classString}`;
---

<StarlightPage
  frontmatter={{
    title: character.name,
    description,
    tableOfContents: false,
    pagefind: false,
  }}
  hasSidebar={false}
>
  <div class="character-page">
    <a
      href="/fantasy-grounds/character-search/"
      class="not-content inline-flex items-center gap-1 mb-3 text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100 print:hidden"
    >
      Back to Character Search
    </a>
    <XmlCard character={character} display="large" />
  </div>
</StarlightPage>

<style is:global>
  body:has(.character-page) #_top {
    display: none;
  }

  body:has(.character-page) {
    --sl-content-width: 100%;
  }

  @media print {
    body:has(.character-page) header.header {
      display: none;
    }
  }
</style>
