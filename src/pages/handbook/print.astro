---
/**
 * The Handbook's print route: a cover, a contents, and the eight house-rule
 * pages in sidebar order, as one inert document.
 *
 * The route renders content and nothing else. There is no sidebar, no site
 * navigation, because a printed sheet is the rule and nothing else; there is no
 * client-side JavaScript, because the artifact must not be a page a reader could
 * run code on; and the sheets themselves are not marked here. Each section below
 * is a *sheet candidate*, and the command turns them into sheets at document
 * start, so the committed route is HTML that does nothing on its own.
 *
 * The route authors the cover, because a title, a version and an edition date
 * are known at build time. It does not author the contents rows: a page number
 * does not exist until layout has run, so the same pass that assigns sheets fills
 * the contents and stamps the numbers. That is why there is no second render and
 * no second build of the site - two builds are two chances for the two to
 * disagree about where a chapter starts.
 *
 * See ADR-0020 and `make handbook`.
 */
import { getCollection, render } from 'astro:content';

import PrintDocument from '../../layouts/PrintDocument.astro';
import { HANDBOOK_EDITION, HANDBOOK_TITLE, handbookSourcePages } from '../../utils/handbook';

const entries = await getCollection('docs');
const bySlug = new Map(entries.map((entry) => [entry.id, entry]));

const sourcePages = await Promise.all(
  handbookSourcePages(entries).map(async (source) => {
    const entry = bySlug.get(source.slug);

    // The ids come from the same collection a moment ago, so this cannot happen
    // - and if it somehow does, a Handbook missing a house rule silently is
    // worse than a build that says which one.
    if (!entry) throw new Error(`No docs entry for ${source.slug}, so the Handbook cannot print it.`);

    return { ...source, columns: entry.data.columns, ...(await render(entry)) };
  })
);
---

<PrintDocument title={HANDBOOK_TITLE}>
  {/* The cover. Everything on it is known before the site is built: what the book
      is called, which version it is and the day that version was cut. A reader
      holding a PDF of house rules needs all three before the first page, and a
      page number here would point at nothing. */}
  <section class="sl-markdown-content" data-handbook-front="cover" data-handbook-title="Cover">
    <h1 class="handbook-cover-title">{HANDBOOK_TITLE}</h1>
    <p class="handbook-cover-edition">{HANDBOOK_EDITION}</p>
  </section>

  {/* The contents. The list inside it is empty here and is filled by the command
      at document start, because the page numbers in it only exist once the sheets
      have been assigned - in the same pass, from the same render. */}
  <section
    class="sl-markdown-content"
    data-handbook-front="contents"
    data-handbook-title="Contents"
  >
    <h1>Contents</h1>
    <ol data-handbook-contents-list></ol>
  </section>

  {
    sourcePages.map(({ slug, title, columns, Content }) => (
      <section
        class="sl-markdown-content"
        data-handbook-source={slug}
        data-handbook-title={title}
        data-handbook-columns={columns}
      >
        <h1>{title}</h1>
        {/* The measure the columns fill. The title above it and the footer the
            command injects below it are page furniture, and furniture does not
            belong inside a two-column measure. */}
        <div data-handbook-flow>
          <Content />
        </div>
      </section>
    ))
  }
</PrintDocument>