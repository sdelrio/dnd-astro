
// astro.config.mjs
import { defineConfig } from 'astro/config';
import starlight from '@astrojs/starlight';
import react from '@astrojs/react';
import alpinejs from '@astrojs/alpinejs';

// https://astro.build
export default defineConfig({
  // En modo SSG (Static Site Generation), la salida es 100% estática para Cloudflare Pages
  output: 'static',
  
  integrations: [
    // 1. Motor de Documentación Base
    starlight({
      title: 'Nenya Lórien — Compendio Custodiado',
      description: 'Reglas de D&D, dotes por libros y visualizador de fichas de Fantasy Grounds.',
      social: {
        github: 'https://github.com', // Puedes actualizarlo con la URL de tu repo privado si quieres
      },
      // Configuración de la barra lateral de Starlight
      sidebar: [
        {
          label: 'Guías Básicas',
          autogenerate: { directory: 'guides' },
        },
        {
          label: 'Reglas de Casa',
          autogenerate: { directory: 'rules' },
        },
        // Las páginas de React (dados, fichas, feats) se pueden enlazar aquí manualmente 
        // o usar "sidebar: { hidden: true }" en sus MDX individuales para ocultarlas.
      ],
      customCss: [
        // Permitirá aplicar estilos personalizados usando las variables de Tailwind/Starlight
        './src/styles/custom.css',
      ],
    }),

    // 2. Integración de React (Para herramientas pesadas: Dados, Matriz de Feats y Visor XML)
    // Deshabilitamos el renderizado por defecto en todas partes para forzar el uso estricto de directivas client:*
    react({
      experimentalReactChildren: true,
    }),

    // 3. Integración de Alpine.js (Para interactividad ultra ligera e inmediata en el cliente)
    alpinejs(),
  ],
});
